////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - плагин автоматического приведения типов по метаинформации поля.
// Обработка, модуль объекта.
//
// Query-параметры и данные из внешних систем часто приходят строками,
// даже если по контракту это число или дата. Плагин читает
// .Мета("Приведение", Спецификация) с полей схемы и преобразует входные
// данные ДО валидации ядром.
//
// Формат спецификации: "Тип" или "Тип.Подтип" (как "Справочник.Номенклатура").
// Если подтип не указан - "Авто" (поведение зависит от типа).
//
// Поддерживаемые спецификации:
//
//   Число / Число.Авто  - стандартное Число()
//   Число.US            - US-формат: точка десятичная, запятые - разряды
//   Число.RU            - RU-формат: запятая десятичная, точки - разряды
//   Строка / Строка.Авто - стандартная Строка()
//   Строка.Trim         - обрезать пробелы по краям
//   Строка.ВерхнийРегистр / Строка.Верхний - ВРег()
//   Строка.НижнийРегистр / Строка.Нижний   - НРег()
//   Булево / Булево.Авто / Булево.Расширенное
//                       - true/false/1/0/yes/no/y/n/on/off/да/нет/вкл/выкл
//   Булево.Строгое      - только true/false, 1/0
//   Дата / Дата.Авто    - ISO8601 → Unix → RU → Дата()
//   Дата.ISO8601 / Дата.ISO - только ISO 8601
//   Дата.Unix           - только Unix-секунды
//   Дата.UnixMillis     - только Unix-миллисекунды
//   Дата.RU             - только DD.MM.YYYY[ HH:MM[:SS]]
//
// Неизвестная спецификация - значение остаётся без изменений (безопасно).
// Ошибка приведения - значение остаётся как есть, ядро выдаст свою ошибку.
//
// Конфигурация (необязательно): Соответствие {ИмяПоля -> Спецификация},
// перекрывает .Мета("Приведение", ...) для указанных полей.
//
// Пример:
//   Схема = ZodX.Обернуть(
//       Zod.СтрогийОбъект()
//           .Поле("createdAt", Zod.Даты().Мета("Приведение", "Дата.ISO8601"))
//           .Поле("amount",    Zod.Числа().Мета("Приведение", "Число.US"))
//           .Поле("isActive",  Zod.Булевы().Мета("Приведение", "Булево"))
//   ).Плагин(Обработки.ZodX_Приведение.Создать());
////////////////////////////////////////////////////////////////////////////////

Перем Переопределения;

Функция Имя() Экспорт
	Возврат "Приведение";
КонецФункции

Функция Фаза() Экспорт
	Возврат "Предобработка";
КонецФункции

Функция Приоритет() Экспорт
	Возврат 50;
КонецФункции

Функция Хуки() Экспорт
	Результат = Новый Массив;
	Результат.Добавить("ПередПроверкой");
	Возврат Результат;
КонецФункции

Процедура Инициализировать(Настройки = Неопределено) Экспорт
	Переопределения = Новый Соответствие;
	Если Настройки <> Неопределено И ТипЗнч(Настройки) = Тип("Соответствие") Тогда
		Для Каждого КЗ Из Настройки Цикл
			Переопределения.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция ПередПроверкой(Данные, Контекст) Экспорт
	Возврат Подготовить(Контекст.Схема, Данные);
КонецФункции

// ============ РЕКУРСИВНАЯ ПОДГОТОВКА ============

Функция Подготовить(Схема, Данные)
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Тип = Схема.ПолучитьТип();
	Если Тип = "Объект" Тогда
		Возврат ПодготовитьОбъект(Схема, Данные);
	ИначеЕсли Тип = "Массив" Тогда
		Возврат ПодготовитьМассив(Схема, Данные);
	КонецЕсли;
	Возврат Данные;
КонецФункции

Функция ПодготовитьОбъект(Схема, Данные)
	Если ТипЗнч(Данные) <> Тип("Структура") И ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Данные;
	КонецЕсли;

	Результат = Zod_Коллекции.Скопировать(Данные);
	МножествоКлючей = Zod_Коллекции.КлючиВМножество(Данные);
	Поля = Схема.ПолучитьПоля();

	Для Каждого Пара Из Поля Цикл
		Каноническое = Пара.Ключ;
		ПолеСхема    = Пара.Значение;

		Спецификация = Переопределения.Получить(Каноническое);
		Если Спецификация = Неопределено Тогда
			Спецификация = ПолеСхема.ПолучитьМета("Приведение");
		КонецЕсли;

		Если МножествоКлючей.Получить(Каноническое) <> Истина Тогда
			Продолжить;
		КонецЕсли;

		Текущее = Результат[Каноническое];

		// Применяем приведение (если задано)
		Если Спецификация <> Неопределено Тогда
			Текущее = ПривестиЗначение(Текущее, Спецификация);
		КонецЕсли;

		// Всегда рекурсируем внутрь - даже если приведения нет.
		// Это гарантирует, что вложенные поля со своим .Мета("Приведение")
		// будут обработаны. Для примитивов Подготовить() вернёт значение
		// как есть.
		Результат.Вставить(Каноническое, Подготовить(ПолеСхема, Текущее));
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция ПодготовитьМассив(Схема, Данные)
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Данные;
	КонецЕсли;
	СхемаЭлемента = Схема.ПолучитьСхемуЭлемента();
	Если СхемаЭлемента = Неопределено Тогда
		Возврат Данные;
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого Элемент Из Данные Цикл
		Результат.Добавить(Подготовить(СхемаЭлемента, Элемент));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// ============ ДИСПЕТЧЕР ПРИВЕДЕНИЯ ============

Функция ПривестиЗначение(Значение, Спецификация)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Спецификация = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	Точка = СтрНайти(Спецификация, ".");
	Если Точка > 0 Тогда
		ТипПриведения = Лев(Спецификация, Точка - 1);
		Подтип = Сред(Спецификация, Точка + 1);
	Иначе
		ТипПриведения = Спецификация;
		Подтип = "Авто";
	КонецЕсли;

	Если ТипПриведения = "Число" Тогда
		Возврат ПривестиЧисло(Значение, Подтип);
	ИначеЕсли ТипПриведения = "Строка" Тогда
		Возврат ПривестиСтроку(Значение, Подтип);
	ИначеЕсли ТипПриведения = "Булево" Тогда
		Возврат ПривестиБулево(Значение, Подтип);
	ИначеЕсли ТипПриведения = "Дата" Тогда
		Возврат ПривестиДату(Значение, Подтип);
	КонецЕсли;

	Возврат Значение;
КонецФункции

// ============ ЧИСЛО ============

Функция ПривестиЧисло(Значение, Подтип)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Если Подтип = "US" Тогда
		Рез = ПопробоватьЧислоUS(Значение);
		Возврат ?(Рез = Неопределено, Значение, Рез);
	ИначеЕсли Подтип = "RU" Тогда
		Рез = ПопробоватьЧислоRU(Значение);
		Возврат ?(Рез = Неопределено, Значение, Рез);
	КонецЕсли;

	// Авто и все прочие - стандартное Число()
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат Значение;
	КонецПопытки;
КонецФункции

Функция ПопробоватьЧислоUS(Значение)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Очищенная = УбратьПробелы(Значение);
	// В US: точка десятичная, запятые - разряды
	ПозицияТочки = СтрНайти(Очищенная, ".");
	ПозицияЗапятой = СтрНайти(Очищенная, ",");
	// Если есть запятая но нет точки - запятая может быть и разрядностью (1,234),
	// и десятичной (1,5). Различаем по числу цифр после: 3 = разрядность.
	Если ПозицияЗапятой > 0 И ПозицияТочки = 0 Тогда
		Части = СтрРазделить(Очищенная, ",", Ложь);
		ПроверитьРазрядность = Истина;
		Для Индекс = 1 По Части.Количество() - 1 Цикл
			Если СтрДлина(Части[Индекс]) <> 3 Тогда
				ПроверитьРазрядность = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ПроверитьРазрядность Тогда
			Возврат Неопределено;   // скорее десятичная - не US
		КонецЕсли;
	КонецЕсли;
	Очищенная = СтрЗаменить(Очищенная, ",", "");
	Возврат СобратьДробноеЧисло(Очищенная, ".");
КонецФункции

Функция ПопробоватьЧислоRU(Значение)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Очищенная = УбратьПробелы(Значение);
	// В RU: запятая десятичная, точки - разряды
	ПозицияТочки = СтрНайти(Очищенная, ".");
	ПозицияЗапятой = СтрНайти(Очищенная, ",");
	Если ПозицияТочки > 0 И ПозицияЗапятой = 0 Тогда
		Части = СтрРазделить(Очищенная, ".", Ложь);
		ПроверитьРазрядность = Истина;
		Для Индекс = 1 По Части.Количество() - 1 Цикл
			Если СтрДлина(Части[Индекс]) <> 3 Тогда
				ПроверитьРазрядность = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ПроверитьРазрядность Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Очищенная = СтрЗаменить(Очищенная, ".", "");
	Возврат СобратьДробноеЧисло(Очищенная, ",");
КонецФункции

// Собирает число из строки, разделённой на целую и дробную часть.
// Не зависит от локали: Число("123") и Число("56") одинаковы везде.
Функция СобратьДробноеЧисло(Очищенная, Разделитель)
	Если ПустаяСтрока(Очищенная) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Знак = 1;
	Если Лев(Очищенная, 1) = "-" Тогда
		Знак = -1;
		Очищенная = Сред(Очищенная, 2);
	ИначеЕсли Лев(Очищенная, 1) = "+" Тогда
		Очищенная = Сред(Очищенная, 2);
	КонецЕсли;
	Позиция = СтрНайти(Очищенная, Разделитель);
	Если Позиция = 0 Тогда
		ЦелаяЧасть = Очищенная;
		ДробнаяЧасть = "";
	Иначе
		ЦелаяЧасть = Лев(Очищенная, Позиция - 1);
		ДробнаяЧасть = Сред(Очищенная, Позиция + 1);
	КонецЕсли;
	Если НЕ ТолькоЦифры(ЦелаяЧасть) И НЕ ПустаяСтрока(ЦелаяЧасть) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ТолькоЦифры(ДробнаяЧасть) И НЕ ПустаяСтрока(ДробнаяЧасть) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = 0;
	Если НЕ ПустаяСтрока(ЦелаяЧасть) Тогда
		Результат = Число(ЦелаяЧасть);
	КонецЕсли;
	Если НЕ ПустаяСтрока(ДробнаяЧасть) Тогда
		Делитель = 1;
		Для Индекс = 1 По СтрДлина(ДробнаяЧасть) Цикл
			Делитель = Делитель * 10;
		КонецЦикла;
		Результат = Результат + Число(ДробнаяЧасть) / Делитель;
	КонецЕсли;
	Возврат Знак * Результат;
КонецФункции

// ============ СТРОКА ============

Функция ПривестиСтроку(Значение, Подтип)
	С = Строка(Значение);
	Если Подтип = "Trim" Тогда
		Возврат СокрЛП(С);
	ИначеЕсли Подтип = "ВерхнийРегистр" ИЛИ Подтип = "Верхний" Тогда
		Возврат ВРег(С);
	ИначеЕсли Подтип = "НижнийРегистр" ИЛИ Подтип = "Нижний" Тогда
		Возврат НРег(С);
	КонецЕсли;
	Возврат С;
КонецФункции

// ============ БУЛЕВО ============

Функция ПривестиБулево(Значение, Подтип)
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	С = ВРег(СокрЛП(Значение));
	Если С = "TRUE" ИЛИ С = "1" Тогда
		Возврат Истина;
	ИначеЕсли С = "FALSE" ИЛИ С = "0" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Подтип = "Строгое" Тогда
		Возврат Значение;
	КонецЕсли;

	// Расширенный набор (Авто и Расширенное)
	Если С = "ДА" ИЛИ С = "YES" ИЛИ С = "Y" ИЛИ С = "ON" ИЛИ С = "ВКЛ" ИЛИ С = "T" Тогда
		Возврат Истина;
	ИначеЕсли С = "НЕТ" ИЛИ С = "NO" ИЛИ С = "N" ИЛИ С = "OFF" ИЛИ С = "ВЫКЛ" ИЛИ С = "F" Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Значение;
КонецФункции

// ============ ДАТА ============

Функция ПривестиДату(Значение, Подтип)
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	Если Подтип = "ISO8601" ИЛИ Подтип = "ISO" Тогда
		Рез = РазобратьISO8601(Значение);
		Возврат ?(Рез = Неопределено, Значение, Рез);
	ИначеЕсли Подтип = "Unix" Тогда
		Рез = РазобратьUnix(Значение, 1);
		Возврат ?(Рез = Неопределено, Значение, Рез);
	ИначеЕсли Подтип = "UnixMillis" Тогда
		Рез = РазобратьUnix(Значение, 1000);
		Возврат ?(Рез = Неопределено, Значение, Рез);
	ИначеЕсли Подтип = "RU" Тогда
		Рез = РазобратьRUДату(Значение);
		Возврат ?(Рез = Неопределено, Значение, Рез);
	КонецЕсли;

	// Авто: ISO → Unix → RU → Дата()
	Рез = РазобратьISO8601(Значение);
	Если Рез <> Неопределено Тогда
		Возврат Рез;
	КонецЕсли;
	Рез = РазобратьUnixАвто(Значение);
	Если Рез <> Неопределено Тогда
		Возврат Рез;
	КонецЕсли;
	Рез = РазобратьRUДату(Значение);
	Если Рез <> Неопределено Тогда
		Возврат Рез;
	КонецЕсли;
	Попытка
		Возврат Дата(Значение);
	Исключение
		Возврат Значение;
	КонецПопытки;
КонецФункции

// Разбирает строку ISO 8601 в Дату.
//
// Поддержка:
//   2026-11-25
//   2026-11-25T14:30
//   2026-11-25T14:30:00
//   2026-11-25T14:30:00.123
//   2026-11-25T14:30:00Z             (UTC)
//   2026-11-25T14:30:00+03:00        (смещение)
//   2026-11-25T14:30:00-05:00
//   2026-11-25 14:30:00              (пробел вместо T)
//
// Смещение валидируется, но НЕ применяется - возвращается локальное
// время как в строке. Семантика смещения (как UTC) неоднозначна:
// клиент может хотеть видеть исходное «настенное» время.
//
// Возвращает Неопределено, если строка не является ISO 8601.
Функция РазобратьISO8601(Значение)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	С = СокрЛП(Значение);
	Если ПустаяСтрока(С) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Отделяем дату от времени по T или пробелу
	ПозицияT = СтрНайти(С, "T");
	ПозицияПробела = СтрНайти(С, " ");
	ПозицияРазделителя = 0;
	Если ПозицияT > 0 Тогда
		ПозицияРазделителя = ПозицияT;
	ИначеЕсли ПозицияПробела > 0 Тогда
		ПозицияРазделителя = ПозицияПробела;
	КонецЕсли;

	Если ПозицияРазделителя > 0 Тогда
		ДатаЧасть  = Лев(С, ПозицияРазделителя - 1);
		ВремяЧасть = Сред(С, ПозицияРазделителя + 1);
	Иначе
		ДатаЧасть  = С;
		ВремяЧасть = "";
	КонецЕсли;

	// --- Дата: YYYY-MM-DD ---
	МассивЧастейДаты = СтрРазделить(ДатаЧасть, "-", Ложь);
	Если МассивЧастейДаты.Количество() <> 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ТолькоЦифры(МассивЧастейДаты[0])
		ИЛИ НЕ ТолькоЦифры(МассивЧастейДаты[1])
		ИЛИ НЕ ТолькоЦифры(МассивЧастейДаты[2]) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Год   = Число(МассивЧастейДаты[0]);
	Месяц = Число(МассивЧастейДаты[1]);
	День  = Число(МассивЧастейДаты[2]);
	Если Месяц < 1 ИЛИ Месяц > 12 ИЛИ День < 1 ИЛИ День > 31 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Час     = 0;
	Минута  = 0;
	Секунда = 0;

	// --- Время: HH:MM[:SS[.fff]][Z|+HH:MM|-HH:MM] ---
	Если НЕ ПустаяСтрока(ВремяЧасть) Тогда

		// Отрезаем суффикс Z или +HH:MM / -HH:MM.
		// Смещение вычисляем, но не применяем (см. шапку).
		Если Прав(ВремяЧасть, 1) = "Z" Тогда
			ВремяЧасть = Лев(ВремяЧасть, СтрДлина(ВремяЧасть) - 1);
		Иначе
			ПозицияПлюс  = СтрНайти(ВремяЧасть, "+");
			ПозицияМинус = СтрНайти(ВремяЧасть, "-");
			ПозицияСмещения = ?(ПозицияПлюс > 0, ПозицияПлюс, ПозицияМинус);
			Если ПозицияСмещения > 1 Тогда
				СмещениеСтр = Сред(ВремяЧасть, ПозицияСмещения);
				РазобратьСмещение(СмещениеСтр);   // валидация, результат не используется
				ВремяЧасть = Лев(ВремяЧасть, ПозицияСмещения - 1);
			КонецЕсли;
		КонецЕсли;

		ЧастиВремени = СтрРазделить(ВремяЧасть, ":", Ложь);
		Если ЧастиВремени.Количество() < 2 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если НЕ ТолькоЦифры(ЧастиВремени[0])
			ИЛИ НЕ ТолькоЦифры(ЧастиВремени[1]) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Час    = Число(ЧастиВремени[0]);
		Минута = Число(ЧастиВремени[1]);

		Если ЧастиВремени.Количество() >= 3 Тогда
			СекСтр = ЧастиВремени[2];
			Точка  = СтрНайти(СекСтр, ".");
			Если Точка > 0 Тогда
				СекСтр = Лев(СекСтр, Точка - 1);
			КонецЕсли;
			Если ТолькоЦифры(СекСтр) Тогда
				Секунда = Число(СекСтр);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Попытка
		Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Валидирует смещение "+HH:MM" / "-HH:MM".
// Возвращает смещение в минутах. Результат в текущей версии не
// применяется (см. РазобратьISO8601), но нужен для будущих доработок
// (например, приведения к UTC).
Функция РазобратьСмещение(Смещение)
	Если ПустаяСтрока(Смещение) Тогда
		Возврат 0;
	КонецЕсли;
	Знак = 1;
	Если Лев(Смещение, 1) = "-" Тогда
		Знак = -1;
		Смещение = Сред(Смещение, 2);
	ИначеЕсли Лев(Смещение, 1) = "+" Тогда
		Смещение = Сред(Смещение, 2);
	КонецЕсли;
	Части = СтрРазделить(Смещение, ":", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат 0;
	КонецЕсли;
	Если НЕ ТолькоЦифры(Части[0]) ИЛИ НЕ ТолькоЦифры(Части[1]) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Знак * (Число(Части[0]) * 60 + Число(Части[1]));
КонецФункции

Функция РазобратьUnix(Значение, Делитель)
	Числ = Неопределено;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Числ = Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		С = СокрЛП(Значение);
		Если ТолькоЦифры(С) Тогда
			Попытка
				Числ = Число(С);
			Исключение
				Возврат Неопределено;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Если Числ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Дата(1970, 1, 1) + Числ / Делитель;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Автоопределение Unix: 10 цифр - секунды, 13+ - миллисекунды.
Функция РазобратьUnixАвто(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Если Значение >= 100000000000 Тогда
			Возврат РазобратьUnix(Значение, 1000);
		ИначеЕсли Значение >= 1000000000 Тогда
			Возврат РазобратьUnix(Значение, 1);
		КонецЕсли;
		Возврат Неопределено;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		С = СокрЛП(Значение);
		Если НЕ ТолькоЦифры(С) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если СтрДлина(С) >= 13 Тогда
			Возврат РазобратьUnix(С, 1000);
		ИначеЕсли СтрДлина(С) = 10 Тогда
			Возврат РазобратьUnix(С, 1);
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция РазобратьRUДату(Значение)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	С = СокрЛП(Значение);
	Если ПустаяСтрока(С) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Части = СтрРазделить(С, ".", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Последняя = Части[2];
	Пробел = СтрНайти(Последняя, " ");
	Если Пробел > 0 Тогда
		ГодЧасть = Лев(Последняя, Пробел - 1);
		ВремяЧасть = Сред(Последняя, Пробел + 1);
	Иначе
		ГодЧасть = Последняя;
		ВремяЧасть = "";
	КонецЕсли;
	Если НЕ ТолькоЦифры(Части[0])
		ИЛИ НЕ ТолькоЦифры(Части[1])
		ИЛИ НЕ ТолькоЦифры(ГодЧасть) Тогда
		Возврат Неопределено;
	КонецЕсли;
	День = Число(Части[0]);
	Месяц = Число(Части[1]);
	Год = Число(ГодЧасть);
	Час = 0; Минута = 0; Секунда = 0;
	Если НЕ ПустаяСтрока(ВремяЧасть) Тогда
		ВремяЧасти = СтрРазделить(ВремяЧасть, ":", Ложь);
		Если ВремяЧасти.Количество() >= 2 И ТолькоЦифры(ВремяЧасти[0]) И ТолькоЦифры(ВремяЧасти[1]) Тогда
			Час = Число(ВремяЧасти[0]);
			Минута = Число(ВремяЧасти[1]);
			Если ВремяЧасти.Количество() >= 3 И ТолькоЦифры(ВремяЧасти[2]) Тогда
				Секунда = Число(ВремяЧасти[2]);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Попытка
		Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// ============ ВСПОМОГАТЕЛЬНЫЕ ============

Функция УбратьПробелы(Строка)
	Результат = СтрЗаменить(Строка, " ", "");
	Результат = СтрЗаменить(Результат, Символы.НПП, "");
	Результат = СтрЗаменить(Результат, Символы.Таб, "");
	Возврат Результат;
КонецФункции

Функция ТолькоЦифры(Строка)
	Если ПустаяСтрока(Строка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Если СтрНайти("0123456789", Сред(Строка, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции
