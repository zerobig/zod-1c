////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - плагин псевдонимов полей для ZodX.
// Обработка, модуль объекта.
//
// Читает .Мета("Псевдоним", ...) с полей объектных схем и применяет
// переименование входных данных ДО валидации ядром. Поддерживает:
//   - Структура и Соответствие на входе;
//   - несколько псевдонимов на поле (Массив; первый найденный побеждает);
//   - вложенные объекты и массивы объектов;
//   - каноническое имя имеет приоритет над псевдонимом;
//   - входные данные не мутируются.
//
// Пример:
//   Схема = ZodX.Из(
//               Zod.Объект()
//                   .Поле("Имя", Zod.Строки().Мета("Псевдоним", "name"))
//                   .Поле("Возраст", Zod.Числа().Целое().Мета("Псевдоним", "age"))
//           ).Плагин(ZodX_Псевдонимы.Создать());
//
//   Результат = Схема.Проверить(Новый Структура("name, age", "Alice", 30));
//   // Результат.Данные.Имя = "Alice", Результат.Данные.Возраст = 30
//
// Ограничения:
//   - не поддерживаются Union / ДискриминированноеОбъединение
//     (нельзя определить ветку до валидации);
//   - для сериализации в обратную сторону используйте .Трансформировать().
////////////////////////////////////////////////////////////////////////////////

Перем Конфигурация;

// --- Контракт плагина ---

Функция Имя() Экспорт
	Возврат "Псевдонимы";
КонецФункции

Функция Фаза() Экспорт
	Возврат "РанняяПредобработка";
КонецФункции

Функция Приоритет() Экспорт
	Возврат 100;
КонецФункции

Функция Хуки() Экспорт
	Результат = Новый Массив;
	Результат.Добавить("ПередПроверкой");
	Возврат Результат;
КонецФункции

Процедура Инициализировать(Настройки = Неопределено) Экспорт
	Конфигурация = Настройки;
КонецПроцедуры

// --- Хук: предобработка данных ---

Функция ПередПроверкой(Данные, Контекст) Экспорт
	Возврат Подготовить(Контекст.Схема, Данные);
КонецФункции

// --- Внутренняя рекурсивная логика ---

Функция Подготовить(Схема, Данные)
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Тип = Схема.ПолучитьТип();
	Если Тип = "Объект" Тогда
		Возврат ПодготовитьОбъект(Схема, Данные);
	ИначеЕсли Тип = "Массив" Тогда
		Возврат ПодготовитьМассив(Схема, Данные);
	КонецЕсли;
	Возврат Данные;
КонецФункции

Функция ПодготовитьОбъект(Схема, Данные)
	Если ТипЗнч(Данные) <> Тип("Структура") И ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Данные;
	КонецЕсли;

	Результат = Zod_Коллекции.Скопировать(Данные);
	МножествоКлючей = Zod_Коллекции.КлючиВМножество(Данные);   // один обход
	Поля = Схема.ПолучитьПоля();

	Для Каждого Пара Из Поля Цикл
		Каноническое = Пара.Ключ;
		ПолеСхема = Пара.Значение;
		СписокПсевдонимов = ПсевдонимыВМассив(ПолеСхема.ПолучитьМета("Псевдоним"));

		ФактическоеИмя = Неопределено;
		Если МножествоКлючей.Получить(Каноническое) = Истина Тогда
			ФактическоеИмя = Каноническое;
		Иначе
			Для Каждого П Из СписокПсевдонимов Цикл
				Если МножествоКлючей.Получить(П) = Истина Тогда
					ФактическоеИмя = П;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Значение = Неопределено;
		Если ФактическоеИмя <> Неопределено Тогда
			Значение = Результат[ФактическоеИмя];
		КонецЕсли;

		// Всегда вычищаем все псевдонимы из результата - даже если
		// фактическое имя было каноническим.
		Для Каждого П Из СписокПсевдонимов Цикл
			Если МножествоКлючей.Получить(П) = Истина Тогда
				Результат.Удалить(П);
			КонецЕсли;
		КонецЦикла;

		Если ФактическоеИмя = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Результат.Вставить(Каноническое, Подготовить(ПолеСхема, Значение));
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция ПодготовитьМассив(Схема, Данные)
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Данные;
	КонецЕсли;
	СхемаЭлемента = Схема.ПолучитьСхемуЭлемента();
	Если СхемаЭлемента = Неопределено Тогда
		Возврат Данные;
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого Элемент Из Данные Цикл
		Результат.Добавить(Подготовить(СхемаЭлемента, Элемент));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПсевдонимыВМассив(Псевдоним)
	Если ТипЗнч(Псевдоним) = Тип("Массив") Тогда
		Возврат Псевдоним;
	КонецЕсли;
	Результат = Новый Массив;
	Если Псевдоним <> Неопределено И НЕ ПустаяСтрока(Псевдоним) Тогда
		Результат.Добавить(Псевдоним);
	КонецЕсли;
	Возврат Результат;
КонецФункции
