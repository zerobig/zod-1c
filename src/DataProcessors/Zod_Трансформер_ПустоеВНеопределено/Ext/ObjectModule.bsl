////////////////////////////////////////////////////////////////////////////////
// zod-1c - универсальный трансформер: пустые значения → Неопределено.
//
// По умолчанию обрабатывает только "" (строку) и пустую дату (Дата(1,1,1)).
// Обработка нуля, Лжи, пустого массива и пустой ссылки включается явно,
// потому что эти значения часто валидны сами по себе.
////////////////////////////////////////////////////////////////////////////////

Перем Настройки;

Процедура Инициализировать() Экспорт
	Настройки = Новый Структура;
	Настройки.Вставить("ПустаяСтрока", Истина);
	Настройки.Вставить("ПустаяДата", Истина);
	Настройки.Вставить("Ноль", Ложь);
	Настройки.Вставить("Ложь", Ложь);
	Настройки.Вставить("ПустойМассив", Ложь);
	Настройки.Вставить("ПустаяСсылка", Ложь);
КонецПроцедуры

// --- Fluent-настройки ---

Функция ВключаяНоль() Экспорт
	Настройки.Ноль = Истина;
	Возврат ЭтотОбъект;
КонецФункции

Функция ВключаяЛожь() Экспорт
	Настройки.Ложь = Истина;
	Возврат ЭтотОбъект;
КонецФункции

Функция ВключаяПустойМассив() Экспорт
	Настройки.ПустойМассив = Истина;
	Возврат ЭтотОбъект;
КонецФункции

Функция ВключаяПустуюСсылку() Экспорт
	Настройки.ПустаяСсылка = Истина;
	Возврат ЭтотОбъект;
КонецФункции

Функция ТолькоСтроку() Экспорт
	Настройки.ПустаяСтрока = Истина;
	Настройки.ПустаяДата = Ложь;
	Настройки.Ноль = Ложь;
	Настройки.Ложь = Ложь;
	Настройки.ПустойМассив = Ложь;
	Настройки.ПустаяСсылка = Ложь;
	Возврат ЭтотОбъект;
КонецФункции

Функция ТолькоДату() Экспорт
	Настройки.ПустаяСтрока = Ложь;
	Настройки.ПустаяДата = Истина;
	Настройки.Ноль = Ложь;
	Настройки.Ложь = Ложь;
	Настройки.ПустойМассив = Ложь;
	Настройки.ПустаяСсылка = Ложь;
	Возврат ЭтотОбъект;
КонецФункции

// --- Основной метод ---

Функция Преобразовать(Значение) Экспорт
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Тип = ТипЗнч(Значение);

	Если Тип = Тип("Строка") Тогда
		Если Настройки.ПустаяСтрока И Значение = "" Тогда
			Возврат Неопределено;
		КонецЕсли;
	ИначеЕсли Тип = Тип("Дата") Тогда
		Если Настройки.ПустаяДата И Значение = Дата(1, 1, 1) Тогда
			Возврат Неопределено;
		КонецЕсли;
	ИначеЕсли Тип = Тип("Число") Тогда
		Если Настройки.Ноль И Значение = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	ИначеЕсли Тип = Тип("Булево") Тогда
		Если Настройки.Ложь И Значение = Ложь Тогда
			Возврат Неопределено;
		КонецЕсли;
	ИначеЕсли Тип = Тип("Массив") Тогда
		Если Настройки.ПустойМассив И Значение.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	ИначеЕсли Zod.ЭтоСсылка1С(Значение) Тогда
		Если Настройки.ПустаяСсылка И Значение.Пустая() Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	Возврат Значение;
КонецФункции
