////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - плагин локализации сообщений об ошибках.
// Обработка, модуль объекта.
//
// Заменяет стандартные сообщения ядра на пользовательские по карте
// соответствия. Работает на фазе "Постобработка": ошибки уже собраны,
// плагин проходит по массиву и подменяет текст.
//
// Зачем: HTTP-сервис возвращает клиенту 422 с описанием ошибок. Клиент
// ожидает сообщения на своём языке или в терминах бизнес-логики, а не
// "Ожидалась строка".
//
// Конфигурация: Соответствие {СтандартноеСообщение -> НовоеСообщение}.
// Если сообщения нет в карте - остаётся как есть.
//
// Пример:
//   Обработки.ZodX_Локализация.Создать(Карта)
//
//   Карта = Новый Соответствие;
//   Карта.Вставить("Ожидалась строка", "Поле должно быть строкой");
//   Карта.Вставить("Обязательное значение", "Поле обязательно для заполнения");
//   Карта.Вставить("Мин. длина: 3", "Слишком короткое значение");
////////////////////////////////////////////////////////////////////////////////

Перем Карта;

Функция Имя() Экспорт
    Возврат "Локализация";
КонецФункции

Функция Фаза() Экспорт
    Возврат "Постобработка";
КонецФункции

Функция Приоритет() Экспорт
    Возврат 100;
КонецФункции

Функция Хуки() Экспорт
    Результат = Новый Массив;
    Результат.Добавить("ПослеПроверки");
    Возврат Результат;
КонецФункции

Процедура Инициализировать(Настройки = Неопределено) Экспорт
    Карта = Новый Соответствие;
    Если Настройки <> Неопределено И ТипЗнч(Настройки) = Тип("Соответствие") Тогда
        Для Каждого КЗ Из Настройки Цикл
            Карта.Вставить(КЗ.Ключ, КЗ.Значение);
        КонецЦикла;
    КонецЕсли;
КонецПроцедуры

Функция ПослеПроверки(Результат, Контекст) Экспорт
    Если Результат.Успех Тогда
        Возврат Результат;
    КонецЕсли;
    Для Каждого Ош Из Результат.Ошибки Цикл
        Новое = Карта.Получить(Ош.Сообщение);
        Если Новое <> Неопределено Тогда
            Ош.Сообщение = Новое;
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции
