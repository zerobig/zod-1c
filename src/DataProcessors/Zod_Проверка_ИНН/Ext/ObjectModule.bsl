////////////////////////////////////////////////////////////////////////////////
// zod-1c - проверка контрольной суммы ИНН (10 или 12 цифр).
// Реализует контракт: Проверить(Значение) -> Булево | Строка | Неопределено
////////////////////////////////////////////////////////////////////////////////

Функция Проверить(Значение) Экспорт
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "ИНН должен быть строкой";
	КонецЕсли;

	Значение = СокрЛП(Значение);
	Длина = СтрДлина(Значение);

	Если Длина <> 10 И Длина <> 12 Тогда
		Возврат "ИНН должен содержать 10 или 12 цифр";
	КонецЕсли;

	Если НЕ ТолькоЦифры(Значение) Тогда
		Возврат "ИНН должен содержать только цифры";
	КонецЕсли;

	Если Длина = 10 Тогда
		Возврат ПроверитьИНН10(Значение);
	Иначе
		Возврат ПроверитьИНН12(Значение);
	КонецЕсли;
КонецФункции

Функция ТолькоЦифры(Значение)
	Попытка
		Возврат СтрНайтиПоРегулярномуВыражению(
			Значение, "^\d+$", НаправлениеПоиска.СНачала).НачальнаяПозиция > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ПроверитьИНН10(ИНН)
	Веса = Новый Массив;
	Веса.Добавить(2); Веса.Добавить(4); Веса.Добавить(10); Веса.Добавить(3);
	Веса.Добавить(5); Веса.Добавить(9); Веса.Добавить(4); Веса.Добавить(6);
	Веса.Добавить(8);

	Сумма = 0;
	Для Индекс = 0 По 8 Цикл
		Сумма = Сумма + Число(Сред(ИНН, Индекс + 1, 1)) * Веса[Индекс];
	КонецЦикла;
	Контроль = Сумма % 11 % 10;

	Если Контроль <> Число(Прав(ИНН, 1)) Тогда
		Возврат "Неверная контрольная сумма ИНН";
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ПроверитьИНН12(ИНН)
	// 11-я контрольная цифра
	Веса11 = Новый Массив;
	Веса11.Добавить(7); Веса11.Добавить(2); Веса11.Добавить(4); Веса11.Добавить(10);
	Веса11.Добавить(3); Веса11.Добавить(5); Веса11.Добавить(9); Веса11.Добавить(4);
	Веса11.Добавить(6); Веса11.Добавить(8);

	Сумма11 = 0;
	Для Индекс = 0 По 9 Цикл
		Сумма11 = Сумма11 + Число(Сред(ИНН, Индекс + 1, 1)) * Веса11[Индекс];
	КонецЦикла;
	Контроль11 = Сумма11 % 11 % 10;

	Если Контроль11 <> Число(Сред(ИНН, 11, 1)) Тогда
		Возврат "Неверная 11-я контрольная цифра ИНН";
	КонецЕсли;

	// 12-я контрольная цифра
	Веса12 = Новый Массив;
	Веса12.Добавить(3); Веса12.Добавить(7); Веса12.Добавить(2); Веса12.Добавить(4);
	Веса12.Добавить(10); Веса12.Добавить(3); Веса12.Добавить(5); Веса12.Добавить(9);
	Веса12.Добавить(4); Веса12.Добавить(6); Веса12.Добавить(8);

	Сумма12 = 0;
	Для Индекс = 0 По 10 Цикл
		Сумма12 = Сумма12 + Число(Сред(ИНН, Индекс + 1, 1)) * Веса12[Индекс];
	КонецЦикла;
	Контроль12 = Сумма12 % 11 % 10;

	Если Контроль12 <> Число(Сред(ИНН, 12, 1)) Тогда
		Возврат "Неверная 12-я контрольная цифра ИНН";
	КонецЕсли;

	Возврат Истина;
КонецФункции
