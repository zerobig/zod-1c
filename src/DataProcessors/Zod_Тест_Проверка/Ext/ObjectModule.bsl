////////////////////////////////////////////////////////////////////////////////
// Тестовая проверка: возвращает заданный результат и запоминает входные значения.
////////////////////////////////////////////////////////////////////////////////

Перем ЗаданныйРезультат;
Перем ЗафиксированныеЗначения;

Процедура УстановитьРезультат(Значение) Экспорт
	ЗаданныйРезультат = Значение;
КонецПроцедуры

Функция Проверить(Значение) Экспорт
	Если ЗафиксированныеЗначения = Неопределено Тогда
		ЗафиксированныеЗначения = Новый Массив;
	КонецЕсли;
	ЗафиксированныеЗначения.Добавить(Значение);
	Возврат ЗаданныйРезультат;
КонецФункции

Функция ПолучитьВызванныеЗначения() Экспорт
	Возврат ЗафиксированныеЗначения;
КонецФункции

Функция ПолучитьКоличествоВызовов() Экспорт
	Если ЗафиксированныеЗначения = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Возврат ЗафиксированныеЗначения.Количество();
КонецФункции
