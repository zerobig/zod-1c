////////////////////////////////////////////////////////////////////////////////
// zod-1c - трансформер телефонного номера.
// Удаляет все нецифровые символы и приводит к формату +7XXXXXXXXXX.
// Реализует контракт: Преобразовать(Значение) -> Строка
////////////////////////////////////////////////////////////////////////////////

Функция Преобразовать(Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение; // не строка - пропускаем, пусть валидатор ругается
	КонецЕсли;

	// Оставляем только цифры
	ТолькоЦифры = "";
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			ТолькоЦифры = ТолькоЦифры + Символ;
		КонецЕсли;
	КонецЦикла;

	// Приводим к формату +7XXXXXXXXXX
	Если СтрДлина(ТолькоЦифры) = 11 Тогда
		Если Лев(ТолькоЦифры, 1) = "8" Тогда
			Возврат "+7" + Сред(ТолькоЦифры, 2);
		ИначеЕсли Лев(ТолькоЦифры, 1) = "7" Тогда
			Возврат "+" + ТолькоЦифры;
		КонецЕсли;
	ИначеЕсли СтрДлина(ТолькоЦифры) = 10 Тогда
		Возврат "+7" + ТолькоЦифры;
	КонецЕсли;

	// Не удалось нормализовать - возвращаем как есть, валидатор решит
	Возврат ТолькоЦифры;

КонецФункции
