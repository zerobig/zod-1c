////////////////////////////////////////////////////////////////////////////////
// Только для тестов! Записывает вызовы хуков в свой Журнал.
////////////////////////////////////////////////////////////////////////////////

Перем Журнал;

Процедура Инициализировать(Конфигурация = Неопределено) Экспорт
	Журнал = Новый Массив;
КонецПроцедуры

Функция Имя() Экспорт
	Возврат "Тестовый";
КонецФункции

Функция Фаза() Экспорт
	Возврат "Предобработка";
КонецФункции

Функция Приоритет() Экспорт
	Возврат 100;
КонецФункции

Функция ПередПроверкой(Данные, Контекст) Экспорт
	Журнал.Добавить("ПередПроверкой");
	Возврат Данные;
КонецФункции

Функция ПослеПроверки(Результат, Контекст) Экспорт
	Журнал.Добавить("ПослеПроверки");
	Возврат Результат;
КонецФункции

Функция Журнал() Экспорт
	Возврат Журнал;
КонецФункции
