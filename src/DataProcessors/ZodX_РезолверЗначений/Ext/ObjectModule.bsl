////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - плагин батч-резолвинга значений по метаинформации поля.
// Обработка, модуль объекта.
//
// Механизм: поле схемы помечается .Мета("Резолвер", ...), плагин собирает
// все входные значения таких полей (рекурсивно, по всей структуре),
// резолвит их батчами через пользовательский объект-резолвер, подставляет
// результаты до валидации ядром.
//
// Механизм универсален: резолвер может возвращать что угодно - ссылку 1С,
// объект, число, строку, структуру. Не привязан к ссылкам.
//
// Контракт резолвера:
//   Метод(Значения - Массив, Параметры - любое) → Соответствие
//     {ВходноеЗначение → РазрешённоеЗначение}.
//   Возвращать нужно только найденные значения; для ненайденных ключ
//   в Соответствии отсутствует.
//
// Метаданные поля:
//   .Мета("Резолвер", Новый Структура(
//       "Обработчик", Обработки.МоиРезолверы,   // менеджер или объект
//       "Метод",      "НайтиПоАртикулу",
//       "Параметры",  Неопределено,             // опционально
//       "Ключ",       "НоменклатураПоАртикулу")) // опционально
//
// Ключ группы:
//   По умолчанию = Обработчик + "|" + Метод. Поля с одинаковым ключом
//   резолвятся одним батчем. Если у двух полей одинаковый Обработчик+Метод,
//   но разные Параметры - используйте явный "Ключ" в мета.
//
// Поведение для ненайденных:
//   - В поле подставляется Неопределено.
//   - В Контекст.ДополнительныеОшибки добавляется {Путь, "Значение не
//     разрешено: X"}. Ядро может дополнительно выдать свою ошибку
//     ("Обязательное значение" для обязательного поля) - это осознанно,
//     пользователь видит и причину, и следствие.
//   - Постобработка (например, Локализация) может перевести сообщение.
//
// Фаза и приоритет:
//   РанняяПредобработка, приоритет 150 - после Псевдонимов (100),
//   до Приведения (50). То есть резолвер получает значения в канонических
//   именах полей, но до приведения типов.
////////////////////////////////////////////////////////////////////////////////

Перем КэшРезолвов;
Перем БуферСбора;

Функция Имя() Экспорт
	Возврат "РезолверЗначений";
КонецФункции

Функция Фаза() Экспорт
	Возврат "РанняяПредобработка";
КонецФункции

Функция Приоритет() Экспорт
	Возврат 150;
КонецФункции

Функция Хуки() Экспорт
	Результат = Новый Массив;
	Результат.Добавить("ПередПроверкой");
	Возврат Результат;
КонецФункции

Процедура Инициализировать(Настройки = Неопределено) Экспорт
	// Настройки не требуются - всё в .Мета("Резолвер", ...)
КонецПроцедуры

// ============ ХУК ============

Функция ПередПроверкой(Данные, Контекст) Экспорт

	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	КэшРезолвов = Новый Соответствие;
	БуферСбора = Новый Соответствие;

	// Проход 1: собрать значения по всем полям с .Мета("Резолвер")
	Собрать(Контекст.Схема, Данные);

	Если БуферСбора.Количество() = 0 Тогда
		Возврат Данные;
	КонецЕсли;

	// Проход 2: резолв батчами
	Для Каждого ПараБуфера Из БуферСбора Цикл
		Группа = ПараБуфера.Значение;
		МассивЗначений = Новый Массив;
		Для Каждого ПараЗначений Из Группа.Значения Цикл
			МассивЗначений.Добавить(ПараЗначений.Ключ);
		КонецЦикла;
		КэшРезолвов.Вставить(ПараБуфера.Ключ,
			ВызватьРезолвер(Группа.Обработчик, Группа.Метод,
				МассивЗначений, Группа.Параметры));
	КонецЦикла;

	// Проход 3: подстановка + сбор ошибок
	Возврат Подставить(Контекст.Схема, Данные, "", Контекст);

КонецФункции

// ============ ПРОХОД 1: СБОР ============

Процедура Собрать(Схема, Данные)
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Тип = Схема.ПолучитьТип();
	Если Тип = "Объект" Тогда
		СобратьОбъект(Схема, Данные);
	ИначеЕсли Тип = "Массив" Тогда
		СобратьМассив(Схема, Данные);
	КонецЕсли;
КонецПроцедуры

Процедура СобратьОбъект(Схема, Данные)
	Если ТипЗнч(Данные) <> Тип("Структура") И ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	Поля = Схема.ПолучитьПоля();
	Для Каждого Пара Из Поля Цикл
		Имя = Пара.Ключ;
		СхемаПоля = Пара.Значение;
		Если НЕ Zod_Коллекции.ЕстьКлюч(Данные, Имя) Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеПоля = Данные[Имя];

		Мета = СхемаПоля.ПолучитьМета("Резолвер");
		Если Мета <> Неопределено И ЗначениеПоля <> Неопределено Тогда
			ДобавитьВБуфер(Мета, ЗначениеПоля);
		КонецЕсли;

		Собрать(СхемаПоля, ЗначениеПоля);
	КонецЦикла;
КонецПроцедуры

Процедура СобратьМассив(Схема, Данные)
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	СхемаЭлемента = Схема.ПолучитьСхемуЭлемента();
	Если СхемаЭлемента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Элемент Из Данные Цикл
		Собрать(СхемаЭлемента, Элемент);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьВБуфер(Мета, Значение)
	Ключ = КлючРезолвера(Мета);
	Группа = БуферСбора.Получить(Ключ);
	Если Группа = Неопределено Тогда
		Группа = Новый Структура("Обработчик, Метод, Параметры, Значения");
		Группа.Обработчик = ИзвлечьОбработчик(Мета);
		Группа.Метод      = ИзвлечьМетод(Мета);
		Группа.Параметры  = ?(Мета.Свойство("Параметры"), Мета.Параметры, Неопределено);
		Группа.Значения   = Новый Соответствие;
		БуферСбора.Вставить(Ключ, Группа);
	КонецЕсли;
	Группа.Значения.Вставить(Значение, Истина);
КонецПроцедуры

Функция КлючРезолвера(Мета)
	Если Мета.Свойство("Ключ") И Мета.Ключ <> Неопределено Тогда
		Возврат "key:" + Мета.Ключ;
	КонецЕсли;
	Возврат "auto:" + Строка(ТипЗнч(Мета.Обработчик)) + "|" + Мета.Метод;
КонецФункции

// ============ ПРОХОД 2: РЕЗОЛВ ============

Функция ВызватьРезолвер(Обработчик, Метод, Значения, Параметры)
	Если Обработчик = Неопределено Тогда
		ВызватьИсключение "zod-1c: ZodX_РезолверЗначений - не задан Обработчик";
	КонецЕсли;
	// Метод уже провалидирован в ИзвлечьМетод() при добавлении в буфер -
	// инъекция исключена.
	Результат = Неопределено;
	Попытка
		Выполнить("Результат = Обработчик." + Метод + "(Значения, Параметры)");
	Исключение
		ВызватьИсключение "zod-1c: ZodX_РезолверЗначений - ошибка в резолвере "
			+ Строка(ТипЗнч(Обработчик)) + "." + Метод + ": "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Контракт 1: Соответствие
	Если ТипЗнч(Результат) = Тип("Соответствие") Тогда
		Возврат Новый Структура("Найденные, Ошибки", Результат, Неопределено);
	КонецЕсли;

	// Контракт 2: Структура("Найденные, Ошибки")
	Если ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("Найденные") И Результат.Свойство("Ошибки") Тогда
		Если ТипЗнч(Результат.Найденные) <> Тип("Соответствие") Тогда
			ВызватьИсключение "zod-1c: ZodX_РезолверЗначений - резолвер "
				+ Строка(ТипЗнч(Обработчик)) + "." + Метод
				+ ": Найденные должен быть Соответствием";
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	ВызватьИсключение "zod-1c: ZodX_РезолверЗначений - резолвер "
		+ Строка(ТипЗнч(Обработчик)) + "." + Метод
		+ " должен вернуть Соответствие или Структуру(""Найденные, Ошибки"")";
КонецФункции

// ============ ПРОХОД 3: ПОДСТАНОВКА ============

Функция Подставить(Схема, Данные, Путь, Контекст)
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Тип = Схема.ПолучитьТип();
	Если Тип = "Объект" Тогда
		Возврат ПодставитьОбъект(Схема, Данные, Путь, Контекст);
	ИначеЕсли Тип = "Массив" Тогда
		Возврат ПодставитьМассив(Схема, Данные, Путь, Контекст);
	КонецЕсли;
	Возврат Данные;
КонецФункции

Функция ПодставитьОбъект(Схема, Данные, Путь, Контекст)
	Если ТипЗнч(Данные) <> Тип("Структура") И ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Данные;
	КонецЕсли;
	Результат = Zod_Коллекции.Скопировать(Данные);
	Поля = Схема.ПолучитьПоля();
	Для Каждого Пара Из Поля Цикл
		Имя = Пара.Ключ;
		СхемаПоля = Пара.Значение;
		Если НЕ Zod_Коллекции.ЕстьКлюч(Результат, Имя) Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеПоля = Результат[Имя];
		ПутьПоля = ?(Путь = "", Имя, Путь + "." + Имя);

		Мета = СхемаПоля.ПолучитьМета("Резолвер");
		Если Мета <> Неопределено И ЗначениеПоля <> Неопределено Тогда
			Ключ = КлючРезолвера(Мета);
			Кэш = КэшРезолвов.Получить(Ключ);
			РезультатПоиска = Zod_Коллекции.НайтиЗначение(?(Кэш = Неопределено, Неопределено, Кэш.Найденные), ЗначениеПоля);
			Если РезультатПоиска.Найдено Тогда
				Результат.Вставить(Имя, РезультатПоиска.Значение);
			Иначе
				Результат.Вставить(Имя, Неопределено);
				// Кастомная ошибка от резолвера имеет приоритет над стандартной
				СообщениеИзРезолвера = ?(Кэш = Неопределено, Неопределено,
					НайтиСообщение(Кэш.Ошибки, ЗначениеПоля));
				Если СообщениеИзРезолвера <> Неопределено Тогда
					Контекст.ДополнительныеОшибки.Добавить(Новый Структура(
						"Путь, Сообщение", ПутьПоля, СообщениеИзРезолвера));
				Иначе
					Контекст.ДополнительныеОшибки.Добавить(Новый Структура(
						"Путь, Сообщение", ПутьПоля,
						"Значение не разрешено: " + Строка(ЗначениеПоля)));
				КонецЕсли;
			КонецЕсли;
		Иначе
			Результат.Вставить(Имя,
				Подставить(СхемаПоля, ЗначениеПоля, ПутьПоля, Контекст));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиСообщение(Ошибки, Значение)
	Если Ошибки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Пара Из Ошибки Цикл
		Если Пара.Ключ = Значение Тогда
			Возврат Пара.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ПодставитьМассив(Схема, Данные, Путь, Контекст)
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Данные;
	КонецЕсли;
	СхемаЭлемента = Схема.ПолучитьСхемуЭлемента();
	Если СхемаЭлемента = Неопределено Тогда
		Возврат Данные;
	КонецЕсли;
	Результат = Новый Массив;
	Для Индекс = 0 По Данные.Количество() - 1 Цикл
		Результат.Добавить(Подставить(СхемаЭлемента, Данные[Индекс],
			Путь + "[" + Индекс + "]", Контекст));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Извлечение полей из мета. Мета - Структура с полями:
//   Обработчик (обязательно)
//   Метод      (обязательно)
//   Параметры  (опционально)
//   Ключ       (опционально)
Функция ИзвлечьОбработчик(Мета)
	Возврат Мета.Обработчик;
КонецФункции

Функция ИзвлечьМетод(Мета)
	Если НЕ Мета.Свойство("Метод") ИЛИ ПустаяСтрока(Мета.Метод) Тогда
		ВызватьИсключение "zod-1c: ZodX_РезолверЗначений - в мета не задан Метод";
	КонецЕсли;
	Если НЕ Zod.ЭтоВалидныйИдентификатор(Мета.Метод) Тогда
		ВызватьИсключение "zod-1c: ZodX_РезолверЗначений - Метод содержит "
			+ "недопустимые символы: " + Мета.Метод;
	КонецЕсли;
	Возврат Мета.Метод;
КонецФункции
