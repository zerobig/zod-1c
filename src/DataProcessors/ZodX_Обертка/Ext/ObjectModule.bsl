////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - расширенная схема с плагинами (движок ZodX).
// Обработка, модуль объекта.
//
// Хранит ссылку на исходную Zod_Схему и список плагинов. Метод Проверить()
// прогоняет данные через пайплайн: предобработка (плагины) → ядро →
// постобработка (плагины в обратном порядке).
//
// Контракт плагина (обработка):
//   Обязательные методы:
//     Фаза()      → Строка: "РанняяПредобработка" | "Предобработка"
//                          | "Постобработка" | "ПоздняяПостобработка"
//     Приоритет() → Число (меньше = раньше внутри фазы)
//   Опциональные методы:
//     Имя()                              → Строка (для логов/отладки)
//     Инициализировать(Конфигурация)     → при регистрации
//     Подключить(Схема)                  → при регистрации, после Инициализировать
//     ПередПроверкой(Данные, Контекст)   → возвращает изменённые Данные
//     ПослеПроверки(Результат, Контекст) → возвращает изменённый Результат
//
// Порядок вызова хуков:
//   ПередПроверкой  - сортировка (Фаза, Приоритет) по возрастанию.
//   ПослеПроверки   - сортировка (Фаза, Приоритет) по убыванию.
// Это даёт «middleware»-семантику: раньше вошёл - позже вышел.
//
// Контекст (Структура):
//   Схема              - исходная Zod_Схема (не обёртка)
//   Данные             - текущие данные (меняются пред-плагинами)
//   ПараметрыПроверки  - как в Zod_Схема.Проверить
//   Плагин             - объект текущего плагина (для отладки)
//   Результат          - результат ядра (меняется пост-плагинами)
////////////////////////////////////////////////////////////////////////////////

Перем Состояние;

Процедура Инициализировать(Схема) Экспорт
	Если Схема = Неопределено ИЛИ ТипЗнч(Схема) <> Тип("ОбработкаОбъект.Zod_Схема") Тогда
		ВызватьИсключение "zod-1c: ZodX_Обёртка.Инициализировать() ожидает объект Zod_Схема";
	КонецЕсли;
	Состояние = Новый Структура;
	Состояние.Вставить("Схема", Схема);
	Состояние.Вставить("Плагины", Новый Массив);
	Состояние.Вставить("КэшПред", Неопределено);
	Состояние.Вставить("КэшПост", Неопределено);
КонецПроцедуры

// ============ РЕГИСТРАЦИЯ ПЛАГИНОВ ============

// Подключает плагин. Порядок подключения не важен - сортировка
// выполняется при первом Проверить() и кэшируется.
//
// Параметры:
//   ОбъектПлагина - обработка с обязательными методами Фаза() и Приоритет().
//   Конфигурация  - любое значение; будет передано в Инициализировать()
//                   плагина (если метод есть).
Функция Плагин(ОбъектПлагина, Конфигурация = Неопределено) Экспорт

	Если ОбъектПлагина = Неопределено Тогда
		ВызватьИсключение "zod-1c: ZodX_Обёртка.Плагин() - объект плагина не может быть Неопределено";
	КонецЕсли;

	ФазаПлагина = ПроверитьОбязательныйМетод(ОбъектПлагина, "Фаза", "Строка");
	ПриоритетПлагина = ПроверитьОбязательныйМетод(ОбъектПлагина, "Приоритет", "Число");

	Если НЕ ЭтоДопустимаяФаза(ФазаПлагина) Тогда
		ВызватьИсключение "zod-1c: неизвестная фаза '" + ФазаПлагина + "'. "
			+ "Допустимые: РанняяПредобработка, Предобработка, Постобработка, ПоздняяПостобработка";
	КонецЕсли;

	ИмяПлагина = "";
	Попытка
		ИмяПлагина = ОбъектПлагина.Имя();
	Исключение
		ИмяПлагина = Строка(ТипЗнч(ОбъектПлагина));
	КонецПопытки;

	Запись = Новый Структура;
	Запись.Вставить("Объект", ОбъектПлагина);
	Запись.Вставить("Имя", ИмяПлагина);
	Запись.Вставить("Фаза", ФазаПлагина);
	Запись.Вставить("Фаза_Ord", ОрдиналФазы(ФазаПлагина));
	Запись.Вставить("Приоритет", ПриоритетПлагина);
	Запись.Вставить("Конфигурация", Конфигурация);

	АктивныеХуки = ПолучитьАктивныеХуки(ОбъектПлагина);
	Запись.Вставить("АктивныеХуки", АктивныеХуки);

	// Опциональная инициализация
	ВызватьОпциональныйМетод(ОбъектПлагина, "Инициализировать", Конфигурация);
	ВызватьОпциональныйМетод(ОбъектПлагина, "Подключить", Состояние.Схема);

	Состояние.Плагины.Добавить(Запись);
	СброситьКэши();

	Возврат ЭтотОбъект;

КонецФункции

Функция Плагины() Экспорт
	Результат = Новый Массив;
	Для Каждого П Из Состояние.Плагины Цикл
		Результат.Добавить(П.Объект);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// ============ ДОСТУП К БАЗОВОЙ СХЕМЕ ============

// Escape hatch: достать исходную Zod_Схему.
// Полезно, если нужен метод, который не делегирован обёрткой.
Функция Схема() Экспорт
	Возврат Состояние.Схема;
КонецФункции

Функция ПолучитьТип() Экспорт
	Возврат Состояние.Схема.ПолучитьТип();
КонецФункции

// ============ ФЛЮЕНТ-ДЕЛЕГАТЫ (минимально нужный набор) ============

Функция Поле(Имя, СхемаПоля) Экспорт
	Состояние.Схема.Поле(Имя, СхемаПоля);
	СброситьКэши();
	Возврат ЭтотОбъект;
КонецФункции

Функция Элемент(СхемаЭлемента) Экспорт
	Состояние.Схема.Элемент(СхемаЭлемента);
	СброситьКэши();
	Возврат ЭтотОбъект;
КонецФункции

Функция Необязательное() Экспорт
	Состояние.Схема.Необязательное();
	Возврат ЭтотОбъект;
КонецФункции

Функция Обязательное() Экспорт
	Состояние.Схема.Обязательное();
	Возврат ЭтотОбъект;
КонецФункции

Функция ДопускаетNull() Экспорт
	Состояние.Схема.ДопускаетNull();
	Возврат ЭтотОбъект;
КонецФункции

Функция Мета(Ключ, Значение) Экспорт
	Состояние.Схема.Мета(Ключ, Значение);
	Возврат ЭтотОбъект;
КонецФункции

// ============ ПРОВЕРКА (ПАЙПЛАЙН) ============

Функция Проверить(Данные, ПараметрыПроверки = Неопределено) Экспорт

	Контекст = Новый Структура("Схема, Данные, ПараметрыПроверки, Плагин, Результат, ДополнительныеОшибки");
	Контекст.Схема = Состояние.Схема;
	Контекст.Данные = Данные;
	Контекст.ПараметрыПроверки = ПараметрыПроверки;
	Контекст.Плагин = Неопределено;
	Контекст.Результат = Неопределено;
	Контекст.ДополнительныеОшибки = Новый Массив;

	// Предобработка
	Для Каждого Эл Из ПолучитьПредПлагины() Цикл
		Контекст.Плагин = Эл.Объект;
		Контекст.Данные = ВызватьХук(Эл.Объект, "ПередПроверкой", Контекст.Данные, Контекст);
	КонецЦикла;

	// Ядро
	Контекст.Результат = Состояние.Схема.Проверить(Контекст.Данные, ПараметрыПроверки);

	// Мерж дополнительных ошибок из плагинов.
	// Делается ДО постобработки, чтобы Локализация и другие
	// пост-плагины видели полный список ошибок.
	Если Контекст.ДополнительныеОшибки.Количество() > 0 Тогда
		Для Каждого Доп Из Контекст.ДополнительныеОшибки Цикл
			Контекст.Результат.Ошибки.Добавить(Доп);
		КонецЦикла;
		Контекст.Результат.Успех = Ложь;
		Контекст.Результат.Данные = Неопределено;
	КонецЕсли;

	// Постобработка
	Контекст.Плагин = Неопределено;
	Для Каждого Эл Из ПолучитьПостПлагины() Цикл
		Контекст.Плагин = Эл.Объект;
		Контекст.Результат = ВызватьХук(Эл.Объект, "ПослеПроверки", Контекст.Результат, Контекст);
	КонецЦикла;

	Возврат Контекст.Результат;

КонецФункции

Функция ПроверитьИлиВыбросить(Данные, ПараметрыПроверки = Неопределено) Экспорт
	Рез = Проверить(Данные, ПараметрыПроверки);
	Если НЕ Рез.Успех Тогда
		ВызватьИсключение Zod.КрасивыйТекстОшибок(Рез.Ошибки);
	КонецЕсли;
	Возврат Рез.Данные;
КонецФункции

Функция СоздатьПустой() Экспорт
	Возврат Состояние.Схема.СоздатьПустой();
КонецФункции

Функция СоздатьМинимальный() Экспорт
	Возврат Состояние.Схема.СоздатьМинимальный();
КонецФункции

// ============ ВНУТРЕННЕЕ ============

Процедура СброситьКэши()
	Состояние.КэшПред = Неопределено;
	Состояние.КэшПост = Неопределено;
КонецПроцедуры

Функция ПолучитьПредПлагины()
	Если Состояние.КэшПред <> Неопределено Тогда
		Возврат Состояние.КэшПред;
	КонецЕсли;
	Состояние.КэшПред = СортироватьПлагины(Истина);
	Возврат Состояние.КэшПред;
КонецФункции

Функция ПолучитьПостПлагины()
	Если Состояние.КэшПост <> Неопределено Тогда
		Возврат Состояние.КэшПост;
	КонецЕсли;
	Состояние.КэшПост = СортироватьПлагины(Ложь);
	Возврат Состояние.КэшПост;
КонецФункции

// Сортирует плагины по (Фаза_Ord, Приоритет). Для пред-хуков - по возрастанию,
// для пост-хуков - по убыванию (middleware: last in - first out).
Функция СортироватьПлагины(ПоВозрастанию)
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Фаза_Ord",       Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("Приоритет",      Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("ИсходныйИндекс", Новый ОписаниеТипов("Число"));

	ИмяХука = ?(ПоВозрастанию, "ПередПроверкой", "ПослеПроверки");

	Для Индекс = 0 По Состояние.Плагины.Количество() - 1 Цикл
		П = Состояние.Плагины[Индекс];
		Если П.АктивныеХуки.Получить(ИмяХука) <> Истина Тогда
			Продолжить;
		КонецЕсли;
		Стр = ТЗ.Добавить();
		Стр.Фаза_Ord       = П.Фаза_Ord;
		Стр.Приоритет      = П.Приоритет;
		Стр.ИсходныйИндекс = Индекс;
	КонецЦикла;

	Если ПоВозрастанию Тогда
		ТЗ.Сортировать("Фаза_Ord Возр, Приоритет Возр, ИсходныйИндекс Возр");
	Иначе
		ТЗ.Сортировать("Фаза_Ord Убыв, Приоритет Убыв, ИсходныйИндекс Убыв");
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Стр Из ТЗ Цикл
		Результат.Добавить(Состояние.Плагины[Стр.ИсходныйИндекс]);
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция ВызватьХук(ОбъектПлагина, ИмяХука, Значение, Контекст)
	Если ИмяХука = "ПередПроверкой" Тогда
		Возврат ОбъектПлагина.ПередПроверкой(Значение, Контекст);
	ИначеЕсли ИмяХука = "ПослеПроверки" Тогда
		Возврат ОбъектПлагина.ПослеПроверки(Значение, Контекст);
	Иначе
		ВызватьИсключение "zod-1c: ZodX неизвестный хук '" + ИмяХука + "'";
	КонецЕсли;
КонецФункции

Функция ПроверитьОбязательныйМетод(ОбъектПлагина, ИмяМетода, ТипОжидаемый)
	Попытка
		Если ИмяМетода = "Фаза" Тогда
			Значение = ОбъектПлагина.Фаза();
		ИначеЕсли ИмяМетода = "Приоритет" Тогда
			Значение = ОбъектПлагина.Приоритет();
		Иначе
			ВызватьИсключение "zod-1c: неизвестный метод контракта '" + ИмяМетода + "'";
		КонецЕсли;
	Исключение
		ВызватьИсключение "zod-1c: плагин " + Строка(ТипЗнч(ОбъектПлагина))
			+ " обязан реализовать метод " + ИмяМетода + "()";
	КонецПопытки;
	Если ТипЗнч(Значение) <> Тип(ТипОжидаемый) Тогда
		ВызватьИсключение "zod-1c: плагин " + Строка(ТипЗнч(ОбъектПлагина))
			+ ": " + ИмяМетода + "() должен возвращать " + ТипОжидаемый;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Процедура ВызватьОпциональныйМетод(ОбъектПлагина, ИмяМетода, Аргумент)
	Попытка
		Если ИмяМетода = "Инициализировать" Тогда
			ОбъектПлагина.Инициализировать(Аргумент);
		ИначеЕсли ИмяМетода = "Подключить" Тогда
			ОбъектПлагина.Подключить(Аргумент);
		Иначе
			ВызватьИсключение "zod-1c: неизвестный опциональный метод '" + ИмяМетода + "'";
		КонецЕсли;
	Исключение
		Если ЭтоОшибкаОтсутствияМетода(ИнформацияОбОшибке(), ИмяМетода) Тогда
			Возврат;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Проверяет, что исключение вызвано отсутствием именно метода с именем ИмяМетода.
// В 1С текст ошибки: "Метод объекта не обнаружен (ИмяМетода)".
// Проверка по имени отсекает ложные срабатывания, когда внутри хука падает
// другой метод (например, Свойство() на Соответствии).
Функция ЭтоОшибкаОтсутствияМетода(ИнформацияОбОшибке, ИмяМетода)
	Попытка
		Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	Исключение
		Текст = "";
	КонецПопытки;
	Возврат СтрНайти(Текст, "Метод объекта не обнаружен (" + ИмяМетода + ")") > 0;
КонецФункции

Функция ЭтоДопустимаяФаза(Фаза)
	Возврат Фаза = "РанняяПредобработка"
		ИЛИ Фаза = "Предобработка"
		ИЛИ Фаза = "Постобработка"
		ИЛИ Фаза = "ПоздняяПостобработка";
КонецФункции

Функция ОрдиналФазы(Фаза)
	Если Фаза = "РанняяПредобработка" Тогда
		Возврат 10;
	ИначеЕсли Фаза = "Предобработка" Тогда
		Возврат 20;
	ИначеЕсли Фаза = "Постобработка" Тогда
		Возврат 30;
	ИначеЕсли Фаза = "ПоздняяПостобработка" Тогда
		Возврат 40;
	КонецЕсли;
	ВызватьИсключение "zod-1c: неизвестная фаза '" + Фаза + "'";
КонецФункции

// Определяет, какие хуки поддерживает плагин.
//   - Если плагин реализует Хуки() - берём список из него.
//   - Иначе - оба хука (ПередПроверкой и ПослеПроверки).
// Возвращает Соответствие {ИмяХука -> Истина}.
Функция ПолучитьАктивныеХуки(ОбъектПлагина)
	Результат = Новый Соответствие;

	Массив = Неопределено;
	Попытка
		Массив = ОбъектПлагина.Хуки();
	Исключение
		Если НЕ ЭтоОшибкаОтсутствияМетода(ИнформацияОбОшибке(), "Хуки") Тогда
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;

	Если Массив = Неопределено Тогда
		// Плагин не реализовал Хуки() - считаем, что поддерживаются оба
		Результат.Вставить("ПередПроверкой", Истина);
		Результат.Вставить("ПослеПроверки", Истина);
	Иначе
		Если ТипЗнч(Массив) <> Тип("Массив") Тогда
			ВызватьИсключение "zod-1c: плагин " + Строка(ТипЗнч(ОбъектПлагина))
				+ ": Хуки() должен возвращать Массив";
		КонецЕсли;
		Для Каждого Имя Из Массив Цикл
			Если Имя <> "ПередПроверкой" И Имя <> "ПослеПроверки" Тогда
				ВызватьИсключение "zod-1c: плагин " + Строка(ТипЗнч(ОбъектПлагина))
					+ ": неизвестный хук '" + Имя + "'. "
					+ "Допустимые: ПередПроверкой, ПослеПроверки";
			КонецЕсли;
			Результат.Вставить(Имя, Истина);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;
КонецФункции
