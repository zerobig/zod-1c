////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - типовые трансформеры (модуль менеджера).
// Одна обработка объединяет несколько трансформеров, вызываемых
// через Zod.Трансформер(Обработки.Zod_Трансформеры, "<ИмяМетода>", Параметры).
// Каждый метод имеет сигнатуру (Значение, Параметры).
//
// Методы статические - объект обработки не требуется. Для поддержки
// вызова через Обработки.Zod_Трансформеры.Создать() используются
// тонкие обёртки в модуле объекта.
////////////////////////////////////////////////////////////////////////////////

Функция UnixTimestamp(Значение, Параметры = Неопределено) Экспорт

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ВызватьИсключение "UnixTimestamp: ожидалось число, получено "
			+ Строка(ТипЗнч(Значение));
	КонецЕсли;

	ЕдиницаИзмерения = "Секунды";
	Если ТипЗнч(Параметры) = Тип("Структура")
		И Параметры.Свойство("ЕдиницаИзмерения") Тогда
		ЕдиницаИзмерения = Параметры.ЕдиницаИзмерения;
	КонецЕсли;

	Если ЕдиницаИзмерения = "Миллисекунды" Тогда
		Секунды = Цел(Значение / 1000);
	Иначе
		Секунды = Цел(Значение);
	КонецЕсли;

	// Прибавляем к текущей универсальной дате разницу между целевым
	// Unix-временем и текущим. Разница в секундах / 86400 - это дни
	// (в 1С дата хранится как число дней с 0001-01-01).
	// Погрешность - не более 1 секунды на границе вызова двух функций
	// текущего времени; для конвертации Unix-времени это приемлемо.
	ТекущийUnixСекунды = Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() / 1000);
	Возврат ТекущаяУниверсальнаяДата() + (Секунды - ТекущийUnixСекунды) / 86400;

КонецФункции

Функция СтатусИзСтроки(Значение, Параметры) Экспорт

	Если ТипЗнч(Параметры) <> Тип("Структура")
		ИЛИ НЕ Параметры.Свойство("Карта") Тогда
		ВызватьИсключение "СтатусИзСтроки: в Параметрах требуется "
			+ "Структура(""Карта"", Соответствие)";
	КонецЕсли;

	Если ТипЗнч(Параметры.Карта) <> Тип("Соответствие") Тогда
		ВызватьИсключение "СтатусИзСтроки: Параметры.Карта должна быть Соответствием";
	КонецЕсли;

	Результат = Параметры.Карта.Получить(Значение);
	Если Результат = Неопределено Тогда
		ВызватьИсключение "СтатусИзСтроки: неизвестное значение '"
			+ Строка(Значение) + "'";
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЧислоИзИдентификатора(Значение, Параметры = Неопределено) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение "ЧислоИзИдентификатора: ожидалась строка";
	КонецЕсли;

	ТолькоЦифры = "";
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			ТолькоЦифры = ТолькоЦифры + Символ;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(ТолькоЦифры) Тогда
		ВызватьИсключение "ЧислоИзИдентификатора: в строке нет цифр";
	КонецЕсли;

	Возврат Число(ТолькоЦифры);

КонецФункции
