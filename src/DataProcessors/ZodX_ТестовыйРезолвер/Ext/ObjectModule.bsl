////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - тонкие обёртки для вызова методов менеджера через
// экземпляр обработки (Обработки.ZodX_ТестовыйРезолвер.Создать().Метод(...)).
// Вся логика - в модуле менеджера.
//
// Нужны для того, чтобы .Мета("Резолвер").Обработчик мог быть как
// менеджером (Обработки.ZodX_ТестовыйРезолвер), так и экземпляром
// (Обработки.ZodX_ТестовыйРезолвер.Создать()).
////////////////////////////////////////////////////////////////////////////////

Функция ПоКарте(Значения, Параметры) Экспорт
	Возврат Обработки.ZodX_ТестовыйРезолвер.ПоКарте(Значения, Параметры);
КонецФункции

Функция ВДлину(Значения, Параметры) Экспорт
	Возврат Обработки.ZodX_ТестовыйРезолвер.ВДлину(Значения, Параметры);
КонецФункции

Функция Квадрат(Значения, Параметры) Экспорт
	Возврат Обработки.ZodX_ТестовыйРезолвер.Квадрат(Значения, Параметры);
КонецФункции

Функция СОшибками(Значения, Параметры) Экспорт
	Возврат Обработки.ZodX_ТестовыйРезолвер.СОшибками(Значения, Параметры);
КонецФункции
