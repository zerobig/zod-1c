////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - тестовые и демонстрационные методы-резолверы.
// Обработка, МОДУЛЬ МЕНЕДЖЕРА (не объекта!).
//
// Один объект-диспетчер с несколькими методами. Выбор метода -
// через .Мета("Резолвер").Метод. Как у Zod.Трансформер.
//
// Передавать можно как менеджер (Обработки.ZodX_ТестовыйРезолвер),
// так и экземпляр (Обработки.ZodX_ТестовыйРезолвер.Создать()) -
// при условии, что методы объявлены здесь, в модуле менеджера.
//
// Все методы имеют сигнатуру:
//   Функция ИмяМетода(Значения, Параметры) Экспорт
////////////////////////////////////////////////////////////////////////////////

// Резолвит по карте {ВходноеЗначение → ВыходноеЗначение}.
// Параметры: Структура("Карта") - обязательна.
Функция ПоКарте(Значения, Параметры) Экспорт
	Если Параметры = Неопределено ИЛИ НЕ Параметры.Свойство("Карта") Тогда
		ВызватьИсключение "ZodX_ТестовыйРезолвер.ПоКарте: в Параметры не передана Карта";
	КонецЕсли;
	Карта = Параметры.Карта;
	Результат = Новый Соответствие;
	Для Каждого Значение Из Значения Цикл
		Для Каждого Пара Из Карта Цикл
			Если Пара.Ключ = Значение Тогда
				Результат.Вставить(Значение, Пара.Значение);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Резолвит строку в её длину. Демонстрирует, что резолвер может
// вернуть число, а не объект.
Функция ВДлину(Значения, Параметры) Экспорт
	Результат = Новый Соответствие;
	Для Каждого Значение Из Значения Цикл
		Результат.Вставить(Значение, СтрДлина(Строка(Значение)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Резолвит число в его квадрат.
Функция Квадрат(Значения, Параметры) Экспорт
	Результат = Новый Соответствие;
	Для Каждого Значение Из Значения Цикл
		Попытка
			Результат.Вставить(Значение, Число(Значение) * Число(Значение));
		Исключение
			// Не число - пропускаем
		КонецПопытки;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Расширенный контракт: Структура("Найденные, Ошибки").
// Параметры: Структура("Карта, СообщениеПоУмолчанию").
Функция СОшибками(Значения, Параметры) Экспорт
	Если Параметры = Неопределено ИЛИ НЕ Параметры.Свойство("Карта") Тогда
		ВызватьИсключение "ZodX_ТестовыйРезолвер.СОшибками: в Параметры не передана Карта";
	КонецЕсли;
	Карта = Параметры.Карта;
	СообщениеПоУмолчанию = "Значение не найдено";
	Если Параметры.Свойство("СообщениеПоУмолчанию") Тогда
		СообщениеПоУмолчанию = Параметры.СообщениеПоУмолчанию;
	КонецЕсли;

	Найденные = Новый Соответствие;
	Ошибки = Новый Соответствие;
	Для Каждого Значение Из Значения Цикл
		Найдено = Ложь;
		Для Каждого Пара Из Карта Цикл
			Если Пара.Ключ = Значение Тогда
				Найденные.Вставить(Значение, Пара.Значение);
				Найдено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Найдено Тогда
			Ошибки.Вставить(Значение, СообщениеПоУмолчанию);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Найденные, Ошибки", Найденные, Ошибки);
КонецФункции
