// Возвращает копию карты полей (только для типа "Объект").
// Копия защищает внутреннее состояние схемы от случайной мутации извне.
Функция ПолучитьПоля() Экспорт
	Результат = Новый Соответствие;
	Если Состояние.Тип = "Объект" Тогда
		Для Каждого КЗ Из Состояние.Поля Цикл
			Результат.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

