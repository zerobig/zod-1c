// ============ МАНИПУЛЯЦИИ С ПОЛЯМИ ОБЪЕКТА ============
//
// Все методы возвращают НОВУЮ схему, не изменяя исходную.
// Доступны только для схем типа "Объект".

// Оставить только перечисленные поля. Остальные — удаляются.
// Вход: Массив имён полей или одна строка.
//
// Пример: Схема.Выбрать(Новый Массив("Имя", "Возраст"))
Функция Выбрать(Имена) Экспорт
	ПроверитьЭтоОбъектнаяСхема("Выбрать");
	Имена = НормализоватьИменаПолей(Имена);

	Для Каждого Имя Из Имена Цикл
		Если Состояние.Поля.Получить(Имя) = Неопределено Тогда
			ВызватьИсключение "zod-1c: Выбрать() — поле '" + Имя + "' отсутствует в схеме";
		КонецЕсли;
	КонецЦикла;

	Результат = Клонировать();
	Результат.ОчиститьПоля();

	Для Каждого Имя Из Имена Цикл
		Результат.Поле(Имя, Состояние.Поля.Получить(Имя));
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Убрать перечисленные поля. Остальные — сохраняются.
//
// Пример: Схема.Исключить("id")   // убрать одно
//         Схема.Исключить(Новый Массив("id", "createdAt"))
Функция Исключить(Имена) Экспорт
	ПроверитьЭтоОбъектнаяСхема("Исключить");
	Имена = НормализоватьИменаПолей(Имена);

	МножествоИмён = Новый Соответствие;
	Для Каждого Имя Из Имена Цикл
		Если Состояние.Поля.Получить(Имя) = Неопределено Тогда
			ВызватьИсключение "zod-1c: Исключить() — поле '" + Имя + "' отсутствует в схеме";
		КонецЕсли;
		МножествоИмён.Вставить(Имя, Истина);
	КонецЦикла;

	Результат = Клонировать();
	Результат.ОчиститьПоля();

	Для Каждого КЗ Из Состояние.Поля Цикл
		Если МножествоИмён.Получить(КЗ.Ключ) = Неопределено Тогда
			Результат.Поле(КЗ.Ключ, КЗ.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Сделать перечисленные поля необязательными (снять требование наличия).
// Без аргумента — сделать необязательными ВСЕ поля схемы.
//
// Пример: Схема.СделатьНеобязательными()             // все
//         Схема.СделатьНеобязательными("Отчество")   // одно
Функция СделатьНеобязательными(Имена = Неопределено) Экспорт
	ПроверитьЭтоОбъектнаяСхема("СделатьНеобязательными");
	Возврат ИзменитьОбязательностьПолей(Имена, "Необязательное");
КонецФункции

// Сделать перечисленные поля обязательными (вернуть требование наличия).
// Без аргумента — сделать обязательными ВСЕ поля схемы.
//
// Обрати внимание: снимает только флаг «Необязательное» (отсутствие ключа).
// Если поле было помечено .ДопускаетNull() — этот флаг сохраняется
// (ключ обязан присутствовать, но значение null допустимо). Это совпадает
// с поведением .required() в zod4.
Функция СделатьОбязательными(Имена = Неопределено) Экспорт
	ПроверитьЭтоОбъектнаяСхема("СделатьОбязательными");
	Возврат ИзменитьОбязательностьПолей(Имена, "Обязательное");
КонецФункции

// ============ КОМПОЗИЦИЯ СХЕМ ============

// Расширение объектной схемы полями другой объектной схемы.
// Аналог .extend() из Zod 4.
//
// Правила:
//   - this и аргумент должны быть схемами типа "Объект";
//   - поля аргумента перезаписывают одноимённые поля источника;
//   - режим объекта (Строгий / Свободный / Обычный), трансформеры, проверки
//     и прочие настройки берутся от источника (this);
//   - возвращает НОВУЮ схему, не изменяя ни this, ни аргумент.
//
// Пример:
//   Zod.Объект()
//       .Поле("id", Zod.Числа())
//       .Расширить(Zod.Объект().Поле("Имя", Zod.Строки()))
Функция Расширить(Схема) Экспорт

	ПроверитьЭтоОбъектнаяСхема("Расширить");
	ПроверитьЭтоСхемаАргумент(Схема, "Расширить");

	Если Схема.ПолучитьТип() <> "Объект" Тогда
		ВызватьИсключение "zod-1c: Расширить() — аргумент должен быть объектной схемой. "
			+ "Текущий тип аргумента: " + Схема.ПолучитьТип();
	КонецЕсли;

	Результат = Клонировать();

	Для Каждого Поле Из Схема.ПолучитьПоля() Цикл
		Результат.Поле(Поле.Ключ, Поле.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Синоним Расширить(), сохраняет имя .merge() из Zod 4.
Функция Объединить(Схема) Экспорт
	Возврат Расширить(Схема);
КонецФункции

// Пересечение схем. Аналог .and() из Zod 4.
// Значение должно успешно пройти проверку ОБЕИХ схем.
//
// Поведение результата:
//   - Для объектных схем: результаты валидации мержатся (поля обеих схем
//     попадают в результат). При совпадении имён побеждает последняя.
//   - Для остальных типов: возвращается результат последней схемы.
//   - Если хотя бы одна схема вернула ошибки — значение невалидно,
//     ошибки накапливаются.
//
// Цепочка .Пересечение().Пересечение() разворачивается в плоский список.
//
// Пример:
//   Zod.Строки().МинДлина(3).Пересечение(Zod.Строки().МаксДлина(10))
//   Zod.Объект().Поле("a", Zod.Строки())
//       .Пересечение(Zod.Объект().Поле("b", Zod.Числа()))
Функция Пересечение(Схема) Экспорт

	ПроверитьЭтоСхемаАргумент(Схема, "Пересечение");

	Если Состояние.Тип = "Пересечение" Тогда
		Результат = Клонировать();
		Результат.ДобавитьСхемуПересечения(Схема);
		Возврат Результат;
	КонецЕсли;

	НоваяСхема = Обработки.Zod_Схема.Создать();
	НоваяСхема.Инициализировать("Пересечение", Состояние.ОшибкаПоУмолчанию);
	НоваяСхема.УстановитьСхемыПересечения(НовыйМассивИзДвух(ЭтотОбъект, Схема));
	Возврат НоваяСхема;

КонецФункции

// Конвейер (pipe). Аналог .pipe() из Zod 4.
// Результат проверки первой схемы передаётся на вход второй.
//
// Полезно, когда первая схема трансформирует значение, а вторая
// валидирует результат. Например, JSON-строка → объект:
//   Zod.Строки()
//       .Трансформировать(Обработки.Zod_Трансформер_JSONПарсер.Создать())
//       .Конвейер(Zod.Объект().Поле("Имя", Zod.Строки()))
//
// Цепочка .Конвейер().Конвейер() разворачивается в плоский список.
Функция Конвейер(Схема) Экспорт

	ПроверитьЭтоСхемаАргумент(Схема, "Конвейер");

	Если Состояние.Тип = "Конвейер" Тогда
		Результат = Клонировать();
		Результат.ДобавитьСхемуКонвейера(Схема);
		Возврат Результат;
	КонецЕсли;

	НоваяСхема = Обработки.Zod_Схема.Создать();
	НоваяСхема.Инициализировать("Конвейер", Состояние.ОшибкаПоУмолчанию);
	НоваяСхема.УстановитьСхемыКонвейера(НовыйМассивИзДвух(ЭтотОбъект, Схема));
	Возврат НоваяСхема;

КонецФункции

// --- Служебные методы для композиции ---

Процедура ПроверитьЭтоСхемаАргумент(Схема, ИмяМетода)
	Если Схема = Неопределено ИЛИ ТипЗнч(Схема) <> Тип("ОбработкаОбъект.Zod_Схема") Тогда
		ВызватьИсключение "zod-1c: " + ИмяМетода + "() ожидает объект обработки Zod_Схема";
	КонецЕсли;
КонецПроцедуры

Функция НовыйМассивИзДвух(Первый, Второй)
	Результат = Новый Массив;
	Результат.Добавить(Первый);
	Результат.Добавить(Второй);
	Возврат Результат;
КонецФункции

// Служебный. Не использовать в прикладном коде.
// Оставлен для обратной совместимости со старым прототипом.
Функция ЮТКоллекцииНеИспользуй_ЭтоТест()
	Возврат Неопределено;
КонецФункции

