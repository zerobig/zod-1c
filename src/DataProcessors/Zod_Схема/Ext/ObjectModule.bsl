////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - класс схемы. Модуль объекта обработки.
////////////////////////////////////////////////////////////////////////////////

Перем Состояние;

Процедура Инициализировать(ТипСхемы, Ошибка = Неопределено, Приведение = Ложь) Экспорт

	// Инициализация состояния при первом вызове
	Состояние = Новый Структура;
	Состояние.Вставить("Тип", ТипСхемы);
	Состояние.Вставить("ОшибкаПоУмолчанию", Ошибка);
	Состояние.Вставить("Приведение", Приведение);
	Состояние.Вставить("Необязательное", Ложь);
	Состояние.Вставить("ДопускаетNull", Ложь);
	Состояние.Вставить("Ограничения", Новый Структура);
	Состояние.Вставить("Поля", Новый Соответствие);
	Состояние.Вставить("РежимОбъекта", "Обычный");
	Состояние.Вставить("ЭлементСхема", Неопределено);
	Состояние.Вставить("СхемаКлючаЗаписи", Неопределено);
	Состояние.Вставить("СхемаЗначенияЗаписи", Неопределено);
	Состояние.Вставить("Варианты", Новый Массив);
	Состояние.Вставить("ДопустимыеЗначения", Новый Массив);
	Состояние.Вставить("ДопустимыеТипыСсылки", Новый Массив);
	Состояние.Вставить("ЛюбыеТипыСсылки", Ложь);
	Состояние.Вставить("ПроверятьСуществование", Ложь);
	Состояние.Вставить("ВидМетаданных", Неопределено);
	Состояние.Вставить("ОбъектВид", Неопределено);
	Состояние.Вставить("ОбъектИмя", Неопределено);
	Состояние.Вставить("ЗаполнятьПоУмолчанию", Ложь);
	Состояние.Вставить("ТабличныеЧасти", Новый Соответствие);
	Состояние.Вставить("Трансформеры", Новый Массив);
	Состояние.Вставить("Проверки", Новый Массив);
	Состояние.Вставить("ЗначениеПоУмолчанию", Неопределено);
	Состояние.Вставить("ЕстьЗначениеПоУмолчанию", Ложь);
	Состояние.Вставить("ЗначениеПриОшибке", Неопределено);
	Состояние.Вставить("ЕстьЗначениеПриОшибке", Ложь);	
	Состояние.Вставить("Литерал", Неопределено);
	Состояние.Вставить("Дискриминатор", Неопределено);
	Состояние.Вставить("КартаВариантов", Неопределено);
	Состояние.Вставить("СхемыПересечения", Новый Массив);
	Состояние.Вставить("СхемыКонвейера", Новый Массив);

КонецПроцедуры

// ============ МОДИФИКАТОРЫ ============

Функция Необязательное() Экспорт
	Состояние.Необязательное = Истина;
	Возврат ЭтотОбъект;
КонецФункции

// Разрешает значение Неопределено (в JSON - null), но ключ объекта
// ОБЯЗАН присутствовать. В отличие от .Необязательное(), которое
// разрешает и отсутствие ключа.
//
// Используется для OpenAPI-свойств, которые в required + nullable: true.
Функция ДопускаетNull() Экспорт
	Состояние.ДопускаетNull = Истина;
	Возврат ЭтотОбъект;
КонецФункции

// Возвращает Истина, если схема допускает отсутствие ключа в объекте.
// С .ПоУмолчанию() поле также становится необязательным на входе —
// отсутствие ключа не ошибка, будет подставлено значение по умолчанию.
Функция ДопускаетОтсутствие() Экспорт
	Возврат Состояние.Необязательное ИЛИ Состояние.ЕстьЗначениеПоУмолчанию;
КонецФункции

// Возвращает Истина, если схема допускает значение Неопределено.
Функция ДопускаетНеопределено() Экспорт
	Возврат Состояние.Необязательное
		ИЛИ Состояние.ДопускаетNull
		ИЛИ Состояние.ЕстьЗначениеПоУмолчанию;
КонецФункции

// Возвращает Истина, если у схемы задано значение по умолчанию
// (.ПоУмолчанию()). Используется в ПроверитьОбъект / ПроверитьОбъект1С
// для решения: если ключа нет, но default есть — вызвать проверку
// с Неопределено, чтобы default сработал.
Функция ЭтоСПоУмолчанию() Экспорт
	Возврат Состояние.ЕстьЗначениеПоУмолчанию;
КонецФункции	

Функция Обязательное() Экспорт
	Состояние.Необязательное = Ложь;
	Возврат ЭтотОбъект;
КонецФункции

Функция МинЗначение(Значение, Ошибка = Неопределено) Экспорт
	Состояние.Ограничения.Вставить("Мин", Новый Структура("Значение, Ошибка", Значение, Ошибка));
	Возврат ЭтотОбъект;
КонецФункции

Функция МаксЗначение(Значение, Ошибка = Неопределено) Экспорт
	Состояние.Ограничения.Вставить("Макс", Новый Структура("Значение, Ошибка", Значение, Ошибка));
	Возврат ЭтотОбъект;
КонецФункции

Функция МинДлина(Значение, Ошибка = Неопределено) Экспорт
	Состояние.Ограничения.Вставить("МинДлина", Новый Структура("Значение, Ошибка", Значение, Ошибка));
	Возврат ЭтотОбъект;
КонецФункции

Функция МаксДлина(Значение, Ошибка = Неопределено) Экспорт
	Состояние.Ограничения.Вставить("МаксДлина", Новый Структура("Значение, Ошибка", Значение, Ошибка));
	Возврат ЭтотОбъект;
КонецФункции

Функция Непустая(Ошибка = Неопределено) Экспорт
	Состояние.Ограничения.Вставить("Непустая", Ошибка);
	Возврат ЭтотОбъект;
КонецФункции

Функция Паттерн(Регулярка, Ошибка = Неопределено) Экспорт
	Если НЕ Состояние.Ограничения.Свойство("Паттерны") Тогда
		Состояние.Ограничения.Вставить("Паттерны", Новый Массив);
	КонецЕсли;
	Состояние.Ограничения.Паттерны.Добавить(
		Новый Структура("Регулярка, Ошибка", Регулярка, Ошибка));
	Возврат ЭтотОбъект;
КонецФункции

// --- Top-level строковые форматы (только регекс) ---

Функция Email(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$",
		?(Ошибка = Неопределено, "Некорректный email", Ошибка));
КонецФункции

Функция URL(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^https?://\S+$",
		?(Ошибка = Неопределено, "Некорректный URL", Ошибка));
КонецФункции

Функция UUID(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
		?(Ошибка = Неопределено, "Некорректный UUID", Ошибка));
КонецФункции

Функция IPv4(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^((25[0-5]|2[0-4]\d|[01]?\d?\d)\.){3}(25[0-5]|2[0-4]\d|[01]?\d?\d)$",
		?(Ошибка = Неопределено, "Некорректный IPv4", Ошибка));
КонецФункции

Функция IPv6(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^[0-9a-fA-F:]{2,39}$",
		?(Ошибка = Неопределено, "Некорректный IPv6", Ошибка));
КонецФункции

Функция ДатаISO(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$",
		?(Ошибка = Неопределено, "Ожидается дата в формате YYYY-MM-DD", Ошибка));
КонецФункции

Функция ХешMD5(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^[a-fA-F0-9]{32}$",
		?(Ошибка = Неопределено, "Некорректный MD5 хеш", Ошибка));
КонецФункции

Функция ХешSHA256(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^[a-fA-F0-9]{64}$",
		?(Ошибка = Неопределено, "Некорректный SHA256 хеш", Ошибка));
КонецФункции

Функция ИНН(Ошибка = Неопределено) Экспорт
	// 10 цифр (ЮЛ) или 12 цифр (ФЛ/ИП)
	Возврат Паттерн("^(\d{10}|\d{12})$",
		?(Ошибка = Неопределено, "Некорректный ИНН", Ошибка));
КонецФункции

Функция СНИЛС(Ошибка = Неопределено) Экспорт
	// XXX-XXX-XXX YY  или  11 цифр подряд
	Возврат Паттерн("^(\d{3}-\d{3}-\d{3}\s\d{2}|\d{11})$",
		?(Ошибка = Неопределено, "Некорректный СНИЛС", Ошибка));
КонецФункции

Функция ОГРН(Ошибка = Неопределено) Экспорт
	// 13 цифр (ЮЛ) или 15 цифр (ИП)
	Возврат Паттерн("^(\d{13}|\d{15})$",
		?(Ошибка = Неопределено, "Некорректный ОГРН", Ошибка));
КонецФункции

Функция КПП(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^\d{9}$",
		?(Ошибка = Неопределено, "Некорректный КПП", Ошибка));
КонецФункции

Функция БИК(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^\d{9}$",
		?(Ошибка = Неопределено, "Некорректный БИК", Ошибка));
КонецФункции

Функция РасчетныйСчет(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^\d{20}$",
		?(Ошибка = Неопределено, "Некорректный расчётный счёт", Ошибка));
КонецФункции

Функция Телефон(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^(\+7|8)[\s\-]?\(?\d{3}\)?[\s\-]?\d{3}[\s\-]?\d{2}[\s\-]?\d{2}$",
		?(Ошибка = Неопределено, "Некорректный телефон", Ошибка));
КонецФункции

