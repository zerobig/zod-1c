////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - класс схемы. Модуль объекта обработки.
////////////////////////////////////////////////////////////////////////////////

Перем Состояние;

Процедура Инициализировать(ТипСхемы, Ошибка = Неопределено, Приведение = Ложь) Экспорт

	// Инициализация состояния при первом вызове
	Состояние = Новый Структура;
	Состояние.Вставить("Тип", ТипСхемы);
	Состояние.Вставить("ОшибкаПоУмолчанию", Ошибка);
	Состояние.Вставить("Приведение", Приведение);
	Состояние.Вставить("Необязательное", Ложь);
	Состояние.Вставить("Ограничения", Новый Структура);
	Состояние.Вставить("Поля", Новый Соответствие);
	Состояние.Вставить("РежимОбъекта", "Обычный");
	Состояние.Вставить("ЭлементСхема", Неопределено);
	Состояние.Вставить("СхемаКлючаЗаписи", Неопределено);
	Состояние.Вставить("СхемаЗначенияЗаписи", Неопределено);
	Состояние.Вставить("Варианты", Новый Массив);
	Состояние.Вставить("ДопустимыеЗначения", Новый Массив);
	Состояние.Вставить("ДопустимыеТипыСсылки", Новый Массив);
	Состояние.Вставить("ЛюбыеТипыСсылки", Ложь);
	Состояние.Вставить("ПроверятьСуществование", Ложь);
	Состояние.Вставить("ВидМетаданных", Неопределено);
	Состояние.Вставить("ОбъектВид", Неопределено);
	Состояние.Вставить("ОбъектИмя", Неопределено);
	Состояние.Вставить("ЗаполнятьПоУмолчанию", Ложь);
	Состояние.Вставить("ТабличныеЧасти", Новый Соответствие);
	Состояние.Вставить("Трансформеры", Новый Массив);
	Состояние.Вставить("Проверки", Новый Массив);

КонецПроцедуры

// ============ МОДИФИКАТОРЫ ============

Функция Необязательное() Экспорт
	Состояние.Необязательное = Истина;
	Возврат ЭтотОбъект;
КонецФункции

Функция Обязательное() Экспорт
	Состояние.Необязательное = Ложь;
	Возврат ЭтотОбъект;
КонецФункции

