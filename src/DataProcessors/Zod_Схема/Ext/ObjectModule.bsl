// --- Объекты 1С ---

Процедура УстановитьВидОбъекта1С(Вид, Имя) Экспорт
	Состояние.ОбъектВид = Вид;
	Состояние.ОбъектИмя = Имя;
	Если Метаданные.НайтиПоПолномуИмени(Вид + "." + Имя) = Неопределено Тогда
		ВызватьИсключение "zod-1c: неизвестный тип объекта '" + Вид + "." + Имя + "'";
	КонецЕсли;
