// --- Ссылки ---

Функция ИлиСсылка(Имя) Экспорт
	ДобавитьДопустимыйТипСсылки(Имя);
	Возврат ЭтотОбъект;
КонецФункции

Процедура ДобавитьДопустимыйТипСсылки(Имя) Экспорт
	Если Состояние.ЛюбыеТипыСсылки Тогда
		ВызватьИсключение "zod-1c: нельзя добавить конкретный тип к схеме ЛюбаяСсылка()";
	КонецЕсли;
	ПозицияТочки = СтрНайти(Имя, ".");
	Если ПозицияТочки <= 0 Тогда
		ВызватьИсключение "zod-1c: некорректное имя типа ссылки '" + Имя + "' (ожидается 'Вид.ИмяОбъекта')";
	КонецЕсли;
	Вид = Лев(Имя, ПозицияТочки - 1);
	ИмяОбъекта = Сред(Имя, ПозицияТочки + 1);
	Попытка
		ТипСсылки = Тип(СтрЗаменить(Имя, ".", "Ссылка."));
	Исключение
		ВызватьИсключение "zod-1c: неизвестный тип ссылки '" + Имя + "'";
	КонецПопытки;
	Состояние.ДопустимыеТипыСсылки.Добавить(
		Новый Структура("Имя, Вид, ИмяОбъекта, ТипСсылки", Имя, Вид, ИмяОбъекта, ТипСсылки));
КонецПроцедуры

Функция УстановитьЛюбыеТипыСсылки() Экспорт
	Если Состояние.ДопустимыеТипыСсылки.Количество() > 0 Тогда
		ВызватьИсключение "zod-1c: нельзя установить ЛюбаяСсылка() после добавления конкретных типов";
	КонецЕсли;
	Состояние.ЛюбыеТипыСсылки = Истина;
	Возврат ЭтотОбъект;
КонецФункции

Функция ТолькоСуществующая() Экспорт
	Состояние.ПроверятьСуществование = Истина;
