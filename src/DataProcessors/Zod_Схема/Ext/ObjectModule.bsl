		?(Ошибка = Неопределено, "Некорректный расчётный счёт", Ошибка));
КонецФункции

Функция Телефон(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^(\+7|8)[\s\-]?\(?\d{3}\)?[\s\-]?\d{3}[\s\-]?\d{2}[\s\-]?\d{2}$",
		?(Ошибка = Неопределено, "Некорректный телефон", Ошибка));
КонецФункции

