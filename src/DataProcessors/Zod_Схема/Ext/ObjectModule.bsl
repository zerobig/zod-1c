КонецФункции

Функция Паттерн(Регулярка, Ошибка = Неопределено) Экспорт
	Если НЕ Состояние.Ограничения.Свойство("Паттерны") Тогда
		Состояние.Ограничения.Вставить("Паттерны", Новый Массив);
	КонецЕсли;
	Состояние.Ограничения.Паттерны.Добавить(
		Новый Структура("Регулярка, Ошибка", Регулярка, Ошибка));
	Возврат ЭтотОбъект;
КонецФункции

// --- Top-level строковые форматы (только регекс) ---

Функция Email(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$",
		?(Ошибка = Неопределено, "Некорректный email", Ошибка));
КонецФункции

Функция URL(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^https?://\S+$",
		?(Ошибка = Неопределено, "Некорректный URL", Ошибка));
КонецФункции

Функция UUID(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
		?(Ошибка = Неопределено, "Некорректный UUID", Ошибка));
КонецФункции

Функция IPv4(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^((25[0-5]|2[0-4]\d|[01]?\d?\d)\.){3}(25[0-5]|2[0-4]\d|[01]?\d?\d)$",
		?(Ошибка = Неопределено, "Некорректный IPv4", Ошибка));
КонецФункции

Функция IPv6(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^[0-9a-fA-F:]{2,39}$",
		?(Ошибка = Неопределено, "Некорректный IPv6", Ошибка));
КонецФункции

Функция ДатаISO(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$",
		?(Ошибка = Неопределено, "Ожидается дата в формате YYYY-MM-DD", Ошибка));
КонецФункции

Функция ХешMD5(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^[a-fA-F0-9]{32}$",
		?(Ошибка = Неопределено, "Некорректный MD5 хеш", Ошибка));
КонецФункции

Функция ХешSHA256(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^[a-fA-F0-9]{64}$",
		?(Ошибка = Неопределено, "Некорректный SHA256 хеш", Ошибка));
КонецФункции

Функция ИНН(Ошибка = Неопределено) Экспорт
	// 10 цифр (ЮЛ) или 12 цифр (ФЛ/ИП)
	Возврат Паттерн("^(\d{10}|\d{12})$",
		?(Ошибка = Неопределено, "Некорректный ИНН", Ошибка));
КонецФункции

Функция СНИЛС(Ошибка = Неопределено) Экспорт
	// XXX-XXX-XXX YY  или  11 цифр подряд
	Возврат Паттерн("^(\d{3}-\d{3}-\d{3}\s\d{2}|\d{11})$",
		?(Ошибка = Неопределено, "Некорректный СНИЛС", Ошибка));
КонецФункции

Функция ОГРН(Ошибка = Неопределено) Экспорт
	// 13 цифр (ЮЛ) или 15 цифр (ИП)
	Возврат Паттерн("^(\d{13}|\d{15})$",
		?(Ошибка = Неопределено, "Некорректный ОГРН", Ошибка));
КонецФункции

Функция КПП(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^\d{9}$",
		?(Ошибка = Неопределено, "Некорректный КПП", Ошибка));
КонецФункции

Функция БИК(Ошибка = Неопределено) Экспорт
	Возврат Паттерн("^\d{9}$",
		?(Ошибка = Неопределено, "Некорректный БИК", Ошибка));
КонецФункции

Функция РасчетныйСчет(Ошибка = Неопределено) Экспорт
