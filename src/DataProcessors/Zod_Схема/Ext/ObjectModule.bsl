// --- Приватные хелперы для манипуляций ---

Процедура ПроверитьЭтоОбъектнаяСхема(ИмяМетода)
	Если Состояние.Тип <> "Объект" Тогда
		ВызватьИсключение "zod-1c: метод " + ИмяМетода + "() доступен только для схем "
			+ "типа Объект. Текущий тип: " + Состояние.Тип;
	КонецЕсли;
КонецПроцедуры

Функция НормализоватьИменаПолей(Имена)
	Если ТипЗнч(Имена) = Тип("Строка") Тогда
		Результат = Новый Массив;
		Результат.Добавить(Имена);
		Возврат Результат;
	ИначеЕсли ТипЗнч(Имена) = Тип("Массив") Тогда
		Возврат Имена;
	КонецЕсли;
	ВызватьИсключение "zod-1c: ожидался массив имён полей или одна строка";
КонецФункции

Функция ИзменитьОбязательностьПолей(Имена, Действие)

	Результат = Клонировать();

	Если Имена = Неопределено Тогда
		// Все поля
		Для Каждого КЗ Из Состояние.Поля Цикл
			СхемаПоля = КЗ.Значение.Клонировать();
			ПрименитьДействие(СхемаПоля, Действие);
			Результат.Поле(КЗ.Ключ, СхемаПоля);
		КонецЦикла;
	Иначе
		Имена = НормализоватьИменаПолей(Имена);
		Для Каждого Имя Из Имена Цикл
			Если Состояние.Поля.Получить(Имя) = Неопределено Тогда
				ВызватьИсключение "zod-1c: ИзменитьОбязательность — поле '" + Имя + "' отсутствует в схеме";
			КонецЕсли;
			СхемаПоля = Результат.НайтиСхемуПоля(Имя).Клонировать();
			ПрименитьДействие(СхемаПоля, Действие);
			Результат.Поле(Имя, СхемаПоля);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ПрименитьДействие(Схема, Действие)
	Если Действие = "Необязательное" Тогда
		Схема.Необязательное();
	ИначеЕсли Действие = "Обязательное" Тогда
		Схема.Обязательное();
	Иначе
		ВызватьИсключение "zod-1c: неизвестное действие: " + Действие;
	КонецЕсли;
КонецПроцедуры

