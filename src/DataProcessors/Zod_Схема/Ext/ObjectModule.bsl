// --- Дискриминированные объединения ---

Функция УстановитьДискриминированныеВарианты(Дискриминатор, Варианты) Экспорт

	Состояние.Дискриминатор = Дискриминатор;
	Состояние.Варианты = Варианты;
	Состояние.КартаВариантов = Новый Соответствие;

	Для Каждого Вариант Из Варианты Цикл

		Если ТипЗнч(Вариант) <> Тип("ОбработкаОбъект.Zod_Схема") Тогда
			ВызватьИсключение "zod-1c: вариант дискриминированного объединения должен быть Zod_Схема";
		КонецЕсли;

		Если Вариант.ПолучитьТип() <> "Объект" Тогда
			ВызватьИсключение "zod-1c: вариант дискриминированного объединения должен быть объектной схемой (Объект/СтрогийОбъект/СвободныйОбъект)";
		КонецЕсли;

		СхемаДискриминатора = Вариант.НайтиСхемуПоля(Дискриминатор);
		Если СхемаДискриминатора = Неопределено Тогда
			ВызватьИсключение "zod-1c: у варианта отсутствует поле-дискриминатор '" + Дискриминатор + "'";
		КонецЕсли;
		Если СхемаДискриминатора.ПолучитьТип() <> "Литерал" Тогда
			ВызватьИсключение "zod-1c: поле-дискриминатор '" + Дискриминатор + "' должно иметь тип Литерал()";
		КонецЕсли;

		ЗначениеЛитерала = СхемаДискриминатора.ПолучитьЛитерал();
		Если ЗначениеЛитерала = Неопределено Тогда
			ВызватьИсключение "zod-1c: значение дискриминатора не может быть Неопределено";
		КонецЕсли;

		Если Состояние.КартаВариантов.Получить(ЗначениеЛитерала) <> Неопределено Тогда
			ВызватьИсключение "zod-1c: дублирующееся значение дискриминатора "
				+ ПредставлениеЛитерала(ЗначениеЛитерала);
		КонецЕсли;
	
		Состояние.КартаВариантов.Вставить(ЗначениеЛитерала, Вариант);

	КонецЦикла;

	Возврат ЭтотОбъект;

КонецФункции

Функция УстановитьДопустимыеЗначения(Значения) Экспорт
	Состояние.ДопустимыеЗначения = Значения;
