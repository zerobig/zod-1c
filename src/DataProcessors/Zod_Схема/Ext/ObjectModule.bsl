// ============ ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ И ОБРАБОТКА ОШИБОК ============

// Значение, подставляемое, когда на вход приходит Неопределено или ключ
// отсутствует. Соответствует .default() из Zod 4.
//
// Особенности:
//   - Само значение по умолчанию НЕ проверяется схемой (как в Zod 4).
//   - Поле становится необязательным на входе (ДопускаетОтсутствие()
//     возвращает Истина).
//   - Если задано и .Необязательное(), и .ПоУмолчанию() — при отсутствии
//     ключа срабатывает default (default «сильнее»).
//   - Для Массив / Структура / Соответствие значение shallow-клонируется,
//     чтобы разные результаты не делили один объект.
//   - Если вместо значения передана обработка с методом Создать() Экспорт —
//     она вызывается при каждом срабатывании для получения нового значения
//     (аналог .default(() => ...) в Zod 4).
//
// Пример:
//   Zod.Строки().ПоУмолчанию("без имени")
//   Zod.Массивы().Элемент(Zod.Числа()).ПоУмолчанию(ФабрикаМассива)
Функция ПоУмолчанию(Значение) Экспорт
	Состояние.ЗначениеПоУмолчанию = Значение;
	Состояние.ЕстьЗначениеПоУмолчанию = Истина;
	Возврат ЭтотОбъект;
КонецФункции

// Значение, возвращаемое при любой ошибке валидации (включая исключения
// из пользовательских проверок и трансформеров). Соответствует .catch()
// из Zod 4.
//
// Особенности:
//   - Ловит и ошибки валидации, и исключения (через Попытка/Исключение).
//   - Ошибки НЕ попадают в результирующий массив Ошибки — они «проглатываются».
//   - При валидном значении fallback не применяется.
//   - Shallow-клон и фабрики работают так же, как в .ПоУмолчанию().
//   - Порядок: если задан и .ПоУмолчанию(), и .Поймать(), то на
//     Неопределено/отсутствие срабатывает default, на любую другую
//     невалидность — fallback.
//
// Пример:
//   Zod.Числа().Поймать(0)
//   Zod.Строки().Поймать("некорректно")
Функция Поймать(Значение) Экспорт
	Состояние.ЗначениеПриОшибке = Значение;
	Состояние.ЕстьЗначениеПриОшибке = Истина;
	Возврат ЭтотОбъект;
КонецФункции

// ============ КЛОНИРОВАНИЕ ============

// Возвращает независимую копию схемы. Все коллекции (поля, ограничения,
// трансформеры, проверки, варианты, карты) копируются. Схемы полей
// переиспользуются по ссылке — их мутация через модификаторы извне
// затрагивает обе схемы (так же, как если бы пользователь сохранил ссылку
// на схему поля и мутировал её).
//
// Используется внутри .Выбрать(), .Исключить(), .СделатьНеобязательными(),
// .СделатьОбязательными(). Может применяться пользователем самостоятельно
// для защиты от нежелательных мутаций.
Функция Клонировать() Экспорт
	НоваяСхема = Обработки.Zod_Схема.Создать();
	НоваяСхема.Инициализировать(Состояние.Тип, Состояние.ОшибкаПоУмолчанию, Состояние.Приведение);
	НоваяСхема.ЗаменитьСостояние(Состояние);
	Возврат НоваяСхема;
КонецФункции

// Служебный: копирует состояние из другой схемы (того же модуля).
Процедура ЗаменитьСостояние(Источник) Экспорт
	Состояние.ОшибкаПоУмолчанию       = Источник.ОшибкаПоУмолчанию;
	Состояние.Приведение              = Источник.Приведение;
	Состояние.Необязательное          = Источник.Необязательное;
	Состояние.ДопускаетNull           = Источник.ДопускаетNull;
	Состояние.РежимОбъекта            = Источник.РежимОбъекта;
	Состояние.ЭлементСхема            = Источник.ЭлементСхема;
	Состояние.СхемаКлючаЗаписи        = Источник.СхемаКлючаЗаписи;
	Состояние.СхемаЗначенияЗаписи     = Источник.СхемаЗначенияЗаписи;
	Состояние.ЛюбыеТипыСсылки         = Источник.ЛюбыеТипыСсылки;
	Состояние.ПроверятьСуществование  = Источник.ПроверятьСуществование;
	Состояние.ВидМетаданных           = Источник.ВидМетаданных;
	Состояние.ОбъектВид               = Источник.ОбъектВид;
	Состояние.ОбъектИмя               = Источник.ОбъектИмя;
	Состояние.ЗаполнятьПоУмолчанию    = Источник.ЗаполнятьПоУмолчанию;
	Состояние.ЗначениеПоУмолчанию     = Источник.ЗначениеПоУмолчанию;
	Состояние.ЕстьЗначениеПоУмолчанию = Источник.ЕстьЗначениеПоУмолчанию;
	Состояние.ЗначениеПриОшибке       = Источник.ЗначениеПриОшибке;
	Состояние.ЕстьЗначениеПриОшибке   = Источник.ЕстьЗначениеПриОшибке;
	Состояние.Литерал                 = Источник.Литерал;
	Состояние.Дискриминатор           = Источник.Дискриминатор;

	Состояние.Ограничения = Новый Структура;
	Для Каждого КЗ Из Источник.Ограничения Цикл
		Состояние.Ограничения.Вставить(КЗ.Ключ, КЗ.Значение);
	КонецЦикла;

	Состояние.Поля = Новый Соответствие;
	Для Каждого КЗ Из Источник.Поля Цикл
		Состояние.Поля.Вставить(КЗ.Ключ, КЗ.Значение);
	КонецЦикла;

	Состояние.ТабличныеЧасти = Новый Соответствие;
	Для Каждого КЗ Из Источник.ТабличныеЧасти Цикл
		Состояние.ТабличныеЧасти.Вставить(КЗ.Ключ, КЗ.Значение);
	КонецЦикла;

	Состояние.Варианты             = СкопироватьМассив(Источник.Варианты);
	Состояние.ДопустимыеЗначения   = СкопироватьМассив(Источник.ДопустимыеЗначения);
	Состояние.ДопустимыеТипыСсылки = СкопироватьМассив(Источник.ДопустимыеТипыСсылки);
	Состояние.Трансформеры         = СкопироватьМассив(Источник.Трансформеры);
	Состояние.Проверки             = СкопироватьМассив(Источник.Проверки);
	Состояние.СхемыПересечения     = СкопироватьМассив(Источник.СхемыПересечения);
	Состояние.СхемыКонвейера       = СкопироватьМассив(Источник.СхемыКонвейера);

	Состояние.КартаВариантов = Новый Соответствие;
	Если Источник.КартаВариантов <> Неопределено Тогда
		Для Каждого КЗ Из Источник.КартаВариантов Цикл
			Состояние.КартаВариантов.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция СкопироватьМассив(Источник)
	Результат = Новый Массив;
	Если Источник = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Значение Из Источник Цикл
		Результат.Добавить(Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ОчиститьПоля() Экспорт
	Состояние.Поля = Новый Соответствие;
КонецПроцедуры

// ============ ГЕНЕРАЦИЯ ПУСТЫХ ЗНАЧЕНИЙ ============

Функция СоздатьПустой() Экспорт
	Возврат СоздатьПустойВнутренний(Истина);
КонецФункции

Функция СоздатьМинимальный() Экспорт
	Возврат СоздатьПустойВнутренний(Ложь);
КонецФункции

Функция СоздатьПустойВнутренний(ВключатьНеобязательные) Экспорт

	// Если задан .ПоУмолчанию() — пустое значение схемы и есть default
	Если Состояние.ЕстьЗначениеПоУмолчанию Тогда
		Возврат СкопироватьРезервноеЗначение(Состояние.ЗначениеПоУмолчанию);
	КонецЕсли;

	Если Состояние.Необязательное Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Состояние.Тип = "Строка" Тогда
		Возврат "";
	ИначеЕсли Состояние.Тип = "Число" Тогда
		Возврат 0;
	ИначеЕсли Состояние.Тип = "Булево" Тогда
		Возврат Ложь;
	ИначеЕсли Состояние.Тип = "Дата" Тогда
		Возврат Дата(1, 1, 1);
	ИначеЕсли Состояние.Тип = "Объект" Тогда
		Результат = Новый Структура;
		Для Каждого Поле Из Состояние.Поля Цикл
			Если НЕ ВключатьНеобязательные И Поле.Значение.ДопускаетОтсутствие() Тогда
				Продолжить;
			КонецЕсли;
			Результат.Вставить(Поле.Ключ,
				Поле.Значение.СоздатьПустойВнутренний(ВключатьНеобязательные));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Состояние.Тип = "Массив" Тогда
		Возврат Новый Массив;
	ИначеЕсли Состояние.Тип = "Запись" Тогда
		Возврат Новый Соответствие;
	ИначеЕсли Состояние.Тип = "Перечисление" Тогда
		Если Состояние.ДопустимыеЗначения.Количество() > 0 Тогда
			Возврат Состояние.ДопустимыеЗначения[0];
		КонецЕсли;
		Возврат Неопределено;
	ИначеЕсли Состояние.Тип = "Объединение" Тогда
		Для Каждого Вариант Из Состояние.Варианты Цикл
			Попытка
				Возврат Вариант.СоздатьПустойВнутренний(ВключатьНеобязательные);
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЦикла;
		Возврат Неопределено;
	ИначеЕсли Состояние.Тип = "Ссылка" Тогда
		Возврат СоздатьПустуюСсылку();
	ИначеЕсли Состояние.Тип = "Метаданные" Тогда
		Возврат Неопределено;
	ИначеЕсли Состояние.Тип = "Объект1С" Тогда
		Возврат СоздатьПустойОбъект1С();
	ИначеЕсли Состояние.Тип = "Литерал" Тогда
		Возврат Состояние.Литерал;
	ИначеЕсли Состояние.Тип = "ДискриминированноеОбъединение" Тогда
		Если Состояние.Варианты.Количество() > 0 Тогда
			Возврат Состояние.Варианты[0].СоздатьПустойВнутренний(ВключатьНеобязательные);
		КонецЕсли;
		Возврат Неопределено;
	ИначеЕсли Состояние.Тип = "Пересечение" Тогда
		Если Состояние.СхемыПересечения.Количество() > 0 Тогда
			Возврат Состояние.СхемыПересечения[0].СоздатьПустойВнутренний(ВключатьНеобязательные);
		КонецЕсли;
		Возврат Неопределено;
	ИначеЕсли Состояние.Тип = "Конвейер" Тогда
		Если Состояние.СхемыКонвейера.Количество() > 0 Тогда
			Возврат Состояние.СхемыКонвейера[0].СоздатьПустойВнутренний(ВключатьНеобязательные);
		КонецЕсли;
		Возврат Неопределено;
	ИначеЕсли Состояние.Тип = "Любое" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Создаёт новый объект через правильный менеджерный метод.
// Использует СоздатьДокумент/СоздатьЭлемент/СоздатьБизнесПроцесс/... -
// в отличие от Новый(Тип(...)), эти методы полностью инициализируют объект.
Функция СоздатьОбъектМенеджером(Вид, ИмяОбъекта)
	Если Вид = "Документ" Тогда
		Возврат Документы[ИмяОбъекта].СоздатьДокумент();
	ИначеЕсли Вид = "Справочник" Тогда
		Возврат Справочники[ИмяОбъекта].СоздатьЭлемент();
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[ИмяОбъекта].СоздатьЭлемент();
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат ПланыСчетов[ИмяОбъекта].СоздатьЭлемент();
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат ПланыОбмена[ИмяОбъекта].СоздатьЭлемент();
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат БизнесПроцессы[ИмяОбъекта].СоздатьБизнесПроцесс();
	ИначеЕсли Вид = "Задача" Тогда
		Возврат Задачи[ИмяОбъекта].СоздатьЗадачу();
	КонецЕсли;
	ВызватьИсключение "zod-1c: неизвестный вид объекта '" + Вид + "'";
КонецФункции

Функция ПолучитьМенеджерСсылки(Вид, ИмяОбъекта)
	Если Вид = "Справочник" Тогда
		Возврат Справочники[ИмяОбъекта];
	ИначеЕсли Вид = "Документ" Тогда
		Возврат Документы[ИмяОбъекта];
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[ИмяОбъекта];
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат ПланыСчетов[ИмяОбъекта];
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат ПланыОбмена[ИмяОбъекта];
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат БизнесПроцессы[ИмяОбъекта];
	ИначеЕсли Вид = "Задача" Тогда
		Возврат Задачи[ИмяОбъекта];
	ИначеЕсли Вид = "Перечисление" Тогда
		Возврат Перечисления[ИмяОбъекта];
	КонецЕсли;
	ВызватьИсключение "zod-1c: неизвестный вид ссылки '" + Вид + "'";
КонецФункции

Функция СоздатьПустуюСсылку()
	Если Состояние.ЛюбыеТипыСсылки Тогда
		Возврат Неопределено; // Без конкретного типа нельзя
	КонецЕсли;
	Если Состояние.ДопустимыеТипыСсылки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипСсылки = Состояние.ДопустимыеТипыСсылки[0].ТипСсылки;
	Возврат Новый(ТипСсылки);
КонецФункции

Функция СоздатьПустойОбъект1С()
	Объект = СоздатьОбъектМенеджером(Состояние.ОбъектВид, Состояние.ОбъектИмя);
	Если Состояние.ЗаполнятьПоУмолчанию Тогда
		Попытка
			Объект.Заполнить(Неопределено);
		Исключение
			// Не подавляем - пробрасываем дальше, пусть тест/сервис увидит
			ВызватьИсключение "zod-1c: Ошибка Заполнить() у "
			+ Состояние.ОбъектВид + "." + Состояние.ОбъектИмя + ": "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	Возврат Объект;
КонецФункции

// ============ ПРОВЕРКА ============

Функция Проверить(Значение) Экспорт
	Ошибки = Новый Массив;
	Приведенное = ПроверитьВнутренний(Значение, "", Ошибки);
	Результат = Новый Структура("Успех, Данные, Ошибки");
	Результат.Успех = (Ошибки.Количество() = 0);
	Результат.Данные = ?(Результат.Успех, Приведенное, Неопределено);
	Результат.Ошибки = Ошибки;
	Возврат Результат;
КонецФункции

Функция ПроверитьИлиВыбросить(Значение) Экспорт
	Рез = Проверить(Значение);
	Если НЕ Рез.Успех Тогда
		ВызватьИсключение Zod.КрасивыйТекстОшибок(Рез.Ошибки);
	КонецЕсли;
	Возврат Рез.Данные;
КонецФункции

// Публичный вход. Если задан .Поймать() — оборачивает всю проверку
// в Попытку и подменяет результат на fallback при любой ошибке.
Функция ПроверитьВнутренний(Значение, Путь, Ошибки) Экспорт

	Если Состояние.ЕстьЗначениеПриОшибке Тогда
		Возврат ПроверитьВнутреннийСПоймать(Значение, Путь, Ошибки);
	КонецЕсли;

	Возврат ПроверитьВнутреннийБаза(Значение, Путь, Ошибки);

КонецФункции

// Обработка .Поймать(): изолируем ошибки, чтобы они не попали в родительский
// массив. Если проверка провалилась (или выбросила исключение) — возвращаем
// fallback, а ошибки «проглатываем».
Функция ПроверитьВнутреннийСПоймать(Значение, Путь, Ошибки)

	ЛокальныеОшибки = Новый Массив;
	Результат = Неопределено;

	Попытка
		Результат = ПроверитьВнутреннийБаза(Значение, Путь, ЛокальныеОшибки);
	Исключение
		// Исключение из пользовательской проверки/трансформера — тоже
		// повод применить fallback, как в JS-варианте .catch().
		ЛокальныеОшибки.Добавить(Новый Структура("Путь, Сообщение",
			Путь, "Перехвачено: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	Если ЛокальныеОшибки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат СкопироватьРезервноеЗначение(Состояние.ЗначениеПриОшибке);

КонецФункции

// Базовая проверка без catch. Содержит проверку .ПоУмолчанию() и всю
// остальную логику (трансформеры, приведение, тип, кастомные проверки).
Функция ПроверитьВнутреннийБаза(Значение, Путь, Ошибки)

	Для Каждого Трансформер Из Состояние.Трансформеры Цикл
		Значение = Трансформер.Преобразовать(Значение);
	КонецЦикла;

	// .ПоУмолчанию() применяется ДО проверки на Неопределено.
	// Это обеспечивает «силу» default над .Необязательное().
	Если Значение = Неопределено И Состояние.ЕстьЗначениеПоУмолчанию Тогда
		Возврат СкопироватьРезервноеЗначение(Состояние.ЗначениеПоУмолчанию);
	КонецЕсли;

	Если Значение = Неопределено Тогда
		Если Состояние.Необязательное ИЛИ Состояние.ДопускаетNull Тогда
			Возврат Неопределено;
		Иначе
			ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Обязательное значение"));
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	Если Состояние.Приведение Тогда
		Значение = ПривестиЗначение(Значение);
		Если Значение = Неопределено Тогда
			ДобавитьОшибку(Ошибки, Путь,
				СообщениеПоУмолчанию("Не удалось привести к типу " + Состояние.Тип));
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	ОшибокДо = Ошибки.Количество();
	Результат = ПроверитьПоТипу(Значение, Путь, Ошибки);

	Если Ошибки.Количество() = ОшибокДо И Результат <> Неопределено Тогда
		ПрименитьКастомныеПроверки(Результат, Путь, Ошибки);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПроверитьПоТипу(Значение, Путь, Ошибки)
	Если Состояние.Тип = "Строка" Тогда
		Возврат ПроверитьСтроку(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Число" Тогда
		Возврат ПроверитьЧисло(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Булево" Тогда
		Возврат ПроверитьТип(Значение, Путь, Ошибки, Тип("Булево"), "булево");
	ИначеЕсли Состояние.Тип = "Дата" Тогда
		Возврат ПроверитьТип(Значение, Путь, Ошибки, Тип("Дата"), "дату");
	ИначеЕсли Состояние.Тип = "Объект" Тогда
		Возврат ПроверитьОбъект(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Массив" Тогда
		Возврат ПроверитьМассив(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Запись" Тогда
		Возврат ПроверитьЗапись(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Перечисление" Тогда
		Возврат ПроверитьПеречисление(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Литерал" Тогда
		Возврат ПроверитьЛитерал(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "ДискриминированноеОбъединение" Тогда
		Возврат ПроверитьДискриминированноеОбъединение(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Объединение" Тогда
		Возврат ПроверитьОбъединение(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Ссылка" Тогда
		Возврат ПроверитьСсылку(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Метаданные" Тогда
		Возврат ПроверитьМетаданные(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Объект1С" Тогда
		Возврат ПроверитьОбъект1С(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Пересечение" Тогда
		Возврат ПроверитьПересечение(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Конвейер" Тогда
		Возврат ПроверитьКонвейер(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Любое" Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// --- Кастомные проверки ---

Процедура ПрименитьКастомныеПроверки(Значение, Путь, Ошибки)
	Если НЕ Состояние.Ограничения.Свойство("Проверки") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Проверка Из Состояние.Ограничения.Проверки Цикл
		Результат = ВызватьПользовательскуюПроверку(Проверка.Объект, Значение);

		Если Результат = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Валидно = Ложь;
		Сообщение = Неопределено;

		Если ТипЗнч(Результат) = Тип("Булево") Тогда
			Валидно = Результат;
		ИначеЕсли ТипЗнч(Результат) = Тип("Строка") Тогда
			Валидно = Ложь;
			Сообщение = Результат;
		ИначеЕсли ТипЗнч(Результат) = Тип("Структура") Тогда
			Валидно = Ложь;
			Если Результат.Свойство("Валидно") Тогда
				Валидно = Результат.Валидно;
			КонецЕсли;
			Если Результат.Свойство("Сообщение") Тогда
				Сообщение = Результат.Сообщение;
			КонецЕсли;
		Иначе
			ВызватьИсключение "zod-1c: объект проверки вернул недопустимый тип "
			+ Строка(ТипЗнч(Результат))
			+ ". Ожидалось: Булево, Строка, Структура или Неопределено";
		КонецЕсли;

		Если НЕ Валидно Тогда
			ИтоговоеСообщение = Проверка.Ошибка;
			Если ИтоговоеСообщение = Неопределено Тогда
				ИтоговоеСообщение = ?(Сообщение = Неопределено,
						"Пользовательская проверка не пройдена", Сообщение);
			КонецЕсли;
			ДобавитьОшибку(Ошибки, Путь, ИтоговоеСообщение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ВызватьПользовательскуюПроверку(Объект, Значение)
	Попытка
		Возврат Объект.Проверить(Значение);
	Исключение
		ВызватьИсключение "zod-1c: ошибка в пользовательской проверке '"
		+ Строка(ТипЗнч(Объект)) + "': " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// --- Строка ---
Функция ПроверитьСтроку(Значение, Путь, Ошибки)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидалась строка"));
		Возврат Неопределено;
	КонецЕсли;
	Длина = СтрДлина(Значение);
	О = Состояние.Ограничения;
	Если О.Свойство("МинДлина") И Длина < О.МинДлина.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.МинДлина.Ошибка, "Мин. длина: " + О.МинДлина.Значение));
	КонецЕсли;
	Если О.Свойство("МаксДлина") И Длина > О.МаксДлина.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.МаксДлина.Ошибка, "Макс. длина: " + О.МаксДлина.Значение));
	КонецЕсли;
	Если О.Свойство("Мин") И Длина < О.Мин.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.Мин.Ошибка, "Мин. длина: " + О.Мин.Значение));
	КонецЕсли;
	Если О.Свойство("Макс") И Длина > О.Макс.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.Макс.Ошибка, "Макс. длина: " + О.Макс.Значение));
	КонецЕсли;
	Если О.Свойство("Непустая") И Значение = "" Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.Непустая, "Строка не может быть пустой"));
	КонецЕсли;
	Если О.Свойство("Паттерны") Тогда
		Для Каждого П Из О.Паттерны Цикл
			Если НЕ СоответствуетРегулярномуВыражению(Значение, П.Регулярка) Тогда
				ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(П.Ошибка, "Строка не соответствует формату"));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// --- Число ---
Функция ПроверитьЧисло(Значение, Путь, Ошибки)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидалось число"));
		Возврат Неопределено;
	КонецЕсли;
	О = Состояние.Ограничения;
	Если О.Свойство("Целое") И Цел(Значение) <> Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.Целое, "Ожидалось целое число"));
	КонецЕсли;
	Если О.Свойство("Мин") И Значение < О.Мин.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.Мин.Ошибка, "Мин. значение: " + О.Мин.Значение));
	КонецЕсли;
	Если О.Свойство("Макс") И Значение > О.Макс.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.Макс.Ошибка, "Макс. значение: " + О.Макс.Значение));
	КонецЕсли;
	Если О.Свойство("Положительное") И Значение <= 0 Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.Положительное, "Значение должно быть положительным"));
	КонецЕсли;
	Возврат Значение;
КонецФункции

// --- Универсальная проверка типа ---
Функция ПроверитьТип(Значение, Путь, Ошибки, ОжидаемыйТип, ИмяТипа)
	Если ТипЗнч(Значение) <> ОжидаемыйТип Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидалось " + ИмяТипа));
		Возврат Неопределено;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// --- Объект ---
Функция ПроверитьОбъект(Значение, Путь, Ошибки)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения <> Тип("Структура") И ТипЗначения <> Тип("Соответствие") Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидался объект"));
		Возврат Неопределено;
	КонецЕсли;

	// Результат того же типа, что и вход - чтобы не терять произвольные ключи
	Если ТипЗначения = Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
	Иначе
		Результат = Новый Структура;
	КонецЕсли;

	ИзвестныеКлючи = Новый Соответствие;
	Для Каждого Поле Из Состояние.Поля Цикл

		ИмяПоля = Поле.Ключ;
		СхемаПоля = Поле.Значение;
		ИзвестныеКлючи.Вставить(ИмяПоля, Истина);
		ПутьПоля = ?(Путь = "", ИмяПоля, Путь + "." + ИмяПоля);

		ЗначениеПоля = Неопределено;
		ЕстьПоле = Ложь;
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			ЕстьПоле = Значение.Свойство(ИмяПоля, ЗначениеПоля);
		Иначе
			ЕстьПоле = Значение.Получить(ИмяПоля) <> Неопределено;
			Если ЕстьПоле Тогда
				ЗначениеПоля = Значение.Получить(ИмяПоля);
			КонецЕсли;
		КонецЕсли;

		Если НЕ ЕстьПоле Тогда
			// Ключа нет - проверяем, разрешает ли схема отсутствие
			Если НЕ СхемаПоля.ДопускаетОтсутствие() Тогда
				ДобавитьОшибку(Ошибки, ПутьПоля, "Обязательное поле отсутствует");
				Продолжить;
			КонецЕсли;

			// Схема допускает отсутствие. Если у неё есть .ПоУмолчанию() —
			// вызываем ПроверитьВнутренний с Неопределено, чтобы default
			// сработал и значение попало в результат. Если default нет —
			// просто пропускаем поле (Необязательное/ДопускаетNull).
			Если СхемаПоля.ЭтоСПоУмолчанию() Тогда
				Результат.Вставить(ИмяПоля,
					СхемаПоля.ПроверитьВнутренний(Неопределено, ПутьПоля, Ошибки));
			КонецЕсли;

			Продолжить;
		КонецЕсли;
	
		// Ключ есть - обычная проверка через ПроверитьВнутренний.
		// Если значение Неопределено и схема .ДопускаетNull() - пройдёт.
		Результат.Вставить(ИмяПоля,
			СхемаПоля.ПроверитьВнутренний(ЗначениеПоля, ПутьПоля, Ошибки));

	КонецЦикла;
	Для Каждого КЗ Из Значение Цикл
		Если ИзвестныеКлючи.Получить(КЗ.Ключ) = Неопределено Тогда
			Если Состояние.РежимОбъекта = "Строгий" Тогда
				ПутьПоля = ?(Путь = "", КЗ.Ключ, Путь + "." + КЗ.Ключ);
				ДобавитьОшибку(Ошибки, ПутьПоля, "Неизвестное поле");
			ИначеЕсли Состояние.РежимОбъекта = "Свободный" Тогда
				Результат.Вставить(КЗ.Ключ, КЗ.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// --- Массив ---
Функция ПроверитьМассив(Значение, Путь, Ошибки)
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидался массив"));
		Возврат Неопределено;
	КонецЕсли;
	О = Состояние.Ограничения;
	Если О.Свойство("МинЭлементов") И Значение.Количество() < О.МинЭлементов.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.МинЭлементов.Ошибка, "Мин. элементов: " + О.МинЭлементов.Значение));
	КонецЕсли;
	Если О.Свойство("МаксЭлементов") И Значение.Количество() > О.МаксЭлементов.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.МаксЭлементов.Ошибка, "Макс. элементов: " + О.МаксЭлементов.Значение));
	КонецЕсли;
	Если Состояние.ЭлементСхема = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Результат = Новый Массив;
	Для Индекс = 0 По Значение.Количество() - 1 Цикл
		Результат.Добавить(Состояние.ЭлементСхема.ПроверитьВнутренний(
				Значение[Индекс], Путь + "[" + Индекс + "]", Ошибки));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// --- Запись ---
Функция ПроверитьЗапись(Значение, Путь, Ошибки)
	Если ТипЗнч(Значение) <> Тип("Структура") И ТипЗнч(Значение) <> Тип("Соответствие") Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидалась запись"));
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Соответствие;
	Для Каждого Элемент Из Значение Цикл
		Ключ = Элемент.Ключ;
		ЗначениеЭлемента = Элемент.Значение;
		ЛокальныеОшибки = Новый Массив;
		ПриведенныйКлюч = Состояние.СхемаКлючаЗаписи.ПроверитьВнутренний(Ключ, Путь + "{ключ}", ЛокальныеОшибки);
		Если ЛокальныеОшибки.Количество() > 0 Тогда
			Для Каждого Ош Из ЛокальныеОшибки Цикл
				Ошибки.Добавить(Ош);
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		ПутьКлюча = ?(Путь = "", Ключ, Путь + "." + Ключ);
		ПриведенноеЗначение = Состояние.СхемаЗначенияЗаписи.ПроверитьВнутренний(
				ЗначениеЭлемента, ПутьКлюча, Ошибки);
		Результат.Вставить(ПриведенныйКлюч, ПриведенноеЗначение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// --- Перечисление (значений) ---
Функция ПроверитьПеречисление(Значение, Путь, Ошибки)
	Для Каждого Допустимое Из Состояние.ДопустимыеЗначения Цикл
		Если Допустимое = Значение Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Недопустимое значение"));
	Возврат Неопределено;
КонецФункции

// --- Объединение ---
Функция ПроверитьОбъединение(Значение, Путь, Ошибки)
	Для Каждого Вариант Из Состояние.Варианты Цикл
		ЛокальныеОшибки = Новый Массив;
		Приведенное = Вариант.ПроверитьВнутренний(Значение, Путь, ЛокальныеОшибки);
		Если ЛокальныеОшибки.Количество() = 0 Тогда
			Возврат Приведенное;
		КонецЕсли;
	КонецЦикла;
	ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Значение не соответствует ни одному из вариантов"));
	Возврат Неопределено;
КонецФункции

// --- Литерал ---
Функция ПроверитьЛитерал(Значение, Путь, Ошибки)

	Если ТипЗнч(Значение) <> ТипЗнч(Состояние.Литерал) Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию(
				"Ожидалось значение " + ПредставлениеЛитерала(Состояние.Литерал)));
		Возврат Неопределено;
	КонецЕсли;

	Если Значение <> Состояние.Литерал Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию(
				"Ожидалось значение " + ПредставлениеЛитерала(Состояние.Литерал)));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// --- Дискриминированное объединение ---
Функция ПроверитьДискриминированноеОбъединение(Значение, Путь, Ошибки)

	Если ТипЗнч(Значение) <> Тип("Структура") И ТипЗнч(Значение) <> Тип("Соответствие") Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию(
			"Ожидался объект с полем-дискриминатором '" + Состояние.Дискриминатор + "'"));
		Возврат Неопределено;
	КонецЕсли;

	ПутьДиск = ?(Путь = "", Состояние.Дискриминатор, Путь + "." + Состояние.Дискриминатор);

	// Извлекаем значение дискриминатора.
	// Для Соответствия нельзя различить «ключа нет» и «ключ есть, значение Неопределено»:
	// Получить() вернёт Неопределено в обоих случаях. Для нас это одно и то же —
	// null и отсутствие одинаково недопустимы как значение дискриминатора.
	ЗначениеДискриминатора = Неопределено;
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Значение.Свойство(Состояние.Дискриминатор, ЗначениеДискриминатора);
	Иначе
		ЗначениеДискриминатора = Значение.Получить(Состояние.Дискриминатор);
	КонецЕсли;

	Если ЗначениеДискриминатора = Неопределено Тогда
		ДобавитьОшибку(Ошибки, ПутьДиск,
			"Отсутствует или недопустимое значение поля-дискриминатора '"
			+ Состояние.Дискриминатор + "'");
		Возврат Неопределено;
	КонецЕсли;

	Вариант = Состояние.КартаВариантов.Получить(ЗначениеДискриминатора);
	Если Вариант = Неопределено Тогда
		ДобавитьОшибку(Ошибки, ПутьДиск,
			"Недопустимое значение дискриминатора: "
			+ ПредставлениеЛитерала(ЗначениеДискриминатора));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Вариант.ПроверитьВнутренний(Значение, Путь, Ошибки);

КонецФункции

Функция ПредставлениеЛитерала(Значение)
	Если Значение = Неопределено Тогда
		Возврат "null";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат """" + Значение + """";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Истина", "Ложь");
	Иначе
		Возврат Строка(Значение);
	КонецЕсли;
КонецФункции

// --- Ссылка 1С ---
Функция ПроверитьСсылку(Значение, Путь, Ошибки)
	Если НЕ Состояние.ЛюбыеТипыСсылки И Состояние.ДопустимыеТипыСсылки.Количество() = 0 Тогда
		ВызватьИсключение "zod-1c: схема Ссылка не инициализирована";
	КонецЕсли;
	Если Zod.ЭтоСсылка1С(Значение) Тогда
		Возврат ОбработатьСсылку1С(Значение, Путь, Ошибки);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ОбработатьUUIDСтроку(Значение, Путь, Ошибки);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат ОбработатьОбъектСсылки(Значение, Путь, Ошибки);
	КонецЕсли;
	ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидалась ссылка"));
	Возврат Неопределено;
КонецФункции

Функция СоответствуетТипамСсылки(ТипСсылки)
	Если Состояние.ЛюбыеТипыСсылки Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Доп Из Состояние.ДопустимыеТипыСсылки Цикл
		Если ТипСсылки = Доп.ТипСсылки Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ОбработатьСсылку1С(Ссылка, Путь, Ошибки)
	Если НЕ СоответствуетТипамСсылки(ТипЗнч(Ссылка)) Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Недопустимый тип ссылки"));
		Возврат Неопределено;
	КонецЕсли;
	Если Состояние.ПроверятьСуществование И Ссылка.Пустая() Тогда
		ДобавитьОшибку(Ошибки, Путь, "Ссылка не существует");
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция ОбработатьUUIDСтроку(СтрокаUUID, Путь, Ошибки)
	Если Состояние.ЛюбыеТипыСсылки ИЛИ Состояние.ДопустимыеТипыСсылки.Количество() <> 1 Тогда
		ДобавитьОшибку(Ошибки, Путь, "Для составной или любой ссылки нужен объект {type, id}");
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Ид = Новый УникальныйИдентификатор(СтрокаUUID);
	Исключение
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Некорректный UUID"));
		Возврат Неопределено;
	КонецПопытки;

	ДопустимыйТип = Состояние.ДопустимыеТипыСсылки[0];

	Попытка
		Менеджер = ПолучитьМенеджерСсылки(ДопустимыйТип.Вид, ДопустимыйТип.ИмяОбъекта);
		Ссылка = Менеджер.ПолучитьСсылку(Ид);
	Исключение
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Не удалось получить ссылку"));
		Возврат Неопределено;
	КонецПопытки;

	Если Состояние.ПроверятьСуществование И Ссылка.Пустая() Тогда
		ДобавитьОшибку(Ошибки, Путь, "Ссылка не существует");
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ссылка;
КонецФункции

Функция ОбработатьОбъектСсылки(Объект, Путь, Ошибки)
	ТипИмя = ПрочитатьПоле(Объект, "type");
	ИдСтрокой = ПрочитатьПоле(Объект, "id");
	Если ТипИмя = Неопределено ИЛИ ИдСтрокой = Неопределено Тогда
		ДобавитьОшибку(Ошибки, Путь, "Ожидался объект {type, id}");
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(ТипИмя) <> Тип("Строка") ИЛИ ТипЗнч(ИдСтрокой) <> Тип("Строка") Тогда
		ДобавитьОшибку(Ошибки, Путь, "Поля type и id должны быть строками");
		Возврат Неопределено;
	КонецЕсли;

	// Проверяем, что тип входит в список допустимых (если он задан)
	ДопустимыйТип = Неопределено;
	Если НЕ Состояние.ЛюбыеТипыСсылки Тогда
		Для Каждого Доп Из Состояние.ДопустимыеТипыСсылки Цикл
			Если Доп.Имя = ТипИмя Тогда
				ДопустимыйТип = Доп;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ДопустимыйТип = Неопределено Тогда
			ДобавитьОшибку(Ошибки, Путь, "Недопустимый тип ссылки: " + ТипИмя);
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		// ЛюбаяСсылка: разбираем строку вручную
		ПозицияТочки = СтрНайти(ТипИмя, ".");
		Если ПозицияТочки <= 0 Тогда
			ДобавитьОшибку(Ошибки, Путь, "Некорректное имя типа: " + ТипИмя);
			Возврат Неопределено;
		КонецЕсли;
		Попытка
			ПроверочныйТип = Тип(СтрЗаменить(ТипИмя, ".", "Ссылка."));
		Исключение
			ДобавитьОшибку(Ошибки, Путь, "Неизвестный тип: " + ТипИмя);
			Возврат Неопределено;
		КонецПопытки;
		ДопустимыйТип = Новый Структура("Имя, Вид, ИмяОбъекта, ТипСсылки",
				ТипИмя,
				Лев(ТипИмя, ПозицияТочки - 1),
				Сред(ТипИмя, ПозицияТочки + 1),
				ПроверочныйТип);
	КонецЕсли;

	Попытка
		Ид = Новый УникальныйИдентификатор(ИдСтрокой);
	Исключение
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Некорректный UUID"));
		Возврат Неопределено;
	КонецПопытки;

	Попытка
		Менеджер = ПолучитьМенеджерСсылки(ДопустимыйТип.Вид, ДопустимыйТип.ИмяОбъекта);
		Ссылка = Менеджер.ПолучитьСсылку(Ид);
	Исключение
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Не удалось получить ссылку"));
		Возврат Неопределено;
	КонецПопытки;

	Если Состояние.ПроверятьСуществование И Ссылка.Пустая() Тогда
		ДобавитьОшибку(Ошибки, Путь, "Ссылка не существует");
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ссылка;
КонецФункции

// --- Метаданные ---
Функция ПроверитьМетаданные(Значение, Путь, Ошибки)
	Если НЕ ЭтоОбъектМетаданных(Значение) Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидался объект метаданных"));
		Возврат Неопределено;
	КонецЕсли;
	Если Состояние.ВидМетаданных <> Неопределено Тогда
		ПолноеИмя = Значение.ПолноеИмя();
		Позиция = СтрНайти(ПолноеИмя, ".");
		Вид = ?(Позиция > 0, Лев(ПолноеИмя, Позиция - 1), ПолноеИмя);
		Если Вид <> Состояние.ВидМетаданных Тогда
			ДобавитьОшибку(Ошибки, Путь, "Ожидался объект метаданных вида " + Состояние.ВидМетаданных);
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ЭтоОбъектМетаданных(Значение)
	Попытка
		Возврат Метаданные.НайтиПоПолномуИмени(Значение.ПолноеИмя()) = Значение;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// --- Объект 1С ---
Функция ПроверитьОбъект1С(Значение, Путь, Ошибки)
	Если Состояние.ОбъектВид = Неопределено ИЛИ Состояние.ОбъектИмя = Неопределено Тогда
		ВызватьИсключение "zod-1c: схема Объект1С не инициализирована";
	КонецЕсли;

	ОбъектТип = Тип(Состояние.ОбъектВид + "Объект." + Состояние.ОбъектИмя);

	Если ТипЗнч(Значение) = ОбъектТип Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат СоздатьОбъект1СИзДанных(Значение, Путь, Ошибки);
	КонецЕсли;

	ДобавитьОшибку(Ошибки, Путь,
		СообщениеПоУмолчанию("Ожидался объект " + Состояние.ОбъектВид + "." + Состояние.ОбъектИмя));
	Возврат Неопределено;
КонецФункции

Функция СоздатьОбъект1СИзДанных(Данные, Путь, Ошибки)
	НовыйОбъект = СоздатьОбъектМенеджером(Состояние.ОбъектВид, Состояние.ОбъектИмя);

	Если Состояние.ЗаполнятьПоУмолчанию Тогда
		Попытка
			НовыйОбъект.Заполнить(Неопределено);
		Исключение
			ДобавитьОшибку(Ошибки, Путь,
				"Ошибка Заполнить(): "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Для Каждого Поле Из Состояние.Поля Цикл
		ИмяПоля = Поле.Ключ;
		СхемаПоля = Поле.Значение;
		ПутьПоля = ?(Путь = "", ИмяПоля, Путь + "." + ИмяПоля);

		ЗначениеПоля = Неопределено;
		ЕстьПоле = Ложь;
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			ЕстьПоле = Данные.Свойство(ИмяПоля, ЗначениеПоля);
		Иначе
			ЕстьПоле = Данные.Получить(ИмяПоля) <> Неопределено;
			Если ЕстьПоле Тогда
				ЗначениеПоля = Данные.Получить(ИмяПоля);
			КонецЕсли;
		КонецЕсли;

		Если НЕ ЕстьПоле Тогда
			Если НЕ СхемаПоля.ДопускаетОтсутствие() Тогда
				ДобавитьОшибку(Ошибки, ПутьПоля, "Обязательное поле отсутствует");
				Продолжить;
			КонецЕсли;

			// Аналогично ПроверитьОбъект: default должен попасть в объект 1С
			Если СхемаПоля.ЭтоСПоУмолчанию() Тогда
				ЛокальныеОшибки = Новый Массив;
				ПроверенноеЗначение = СхемаПоля.ПроверитьВнутренний(
					Неопределено, ПутьПоля, ЛокальныеОшибки);
				Для Каждого Ош Из ЛокальныеОшибки Цикл
					Ошибки.Добавить(Ош);
				КонецЦикла;
				Если ЛокальныеОшибки.Количество() = 0 Тогда
					Попытка
						НовыйОбъект[ИмяПоля] = ПроверенноеЗначение;
					Исключение
						ДобавитьОшибку(Ошибки, ПутьПоля,
							"Ошибка присвоения значения: "
							+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;

			Продолжить;
		КонецЕсли;
	
		ЛокальныеОшибки = Новый Массив;
		ПроверенноеЗначение = СхемаПоля.ПроверитьВнутренний(ЗначениеПоля, ПутьПоля, ЛокальныеОшибки);
		Для Каждого Ош Из ЛокальныеОшибки Цикл
			Ошибки.Добавить(Ош);
		КонецЦикла;

		Если ЛокальныеОшибки.Количество() = 0 Тогда
			Попытка
				НовыйОбъект[ИмяПоля] = ПроверенноеЗначение;
			Исключение
				ДобавитьОшибку(Ошибки, ПутьПоля,
					"Ошибка присвоения значения: "
					+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТЧ Из Состояние.ТабличныеЧасти Цикл
		ИмяТЧ = ТЧ.Ключ;
		СхемаСтроки = ТЧ.Значение;
		ПутьТЧ = ?(Путь = "", ИмяТЧ, Путь + "." + ИмяТЧ);

		ЗначениеТЧ = Неопределено;
		ЕстьТЧ = Ложь;
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			ЕстьТЧ = Данные.Свойство(ИмяТЧ, ЗначениеТЧ);
		Иначе
			ЕстьТЧ = Данные.Получить(ИмяТЧ) <> Неопределено;
			Если ЕстьТЧ Тогда
				ЗначениеТЧ = Данные.Получить(ИмяТЧ);
			КонецЕсли;
		КонецЕсли;

		Если НЕ ЕстьТЧ Тогда
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(ЗначениеТЧ) <> Тип("Массив") Тогда
			ДобавитьОшибку(Ошибки, ПутьТЧ, "Ожидался массив строк");
			Продолжить;
		КонецЕсли;

		Для Индекс = 0 По ЗначениеТЧ.Количество() - 1 Цикл
			СтрокаДанных = ЗначениеТЧ[Индекс];
			ПутьСтроки = ПутьТЧ + "[" + Индекс + "]";

			ЛокальныеОшибки = Новый Массив;
			РезультатСтроки = СхемаСтроки.ПроверитьВнутренний(СтрокаДанных, ПутьСтроки, ЛокальныеОшибки);
			Для Каждого Ош Из ЛокальныеОшибки Цикл
				Ошибки.Добавить(Ош);
			КонецЦикла;

			Если ЛокальныеОшибки.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;

			Попытка
				НоваяСтрока = НовыйОбъект[ИмяТЧ].Добавить();
				Для Каждого ПолеСтроки Из РезультатСтроки Цикл
					НоваяСтрока[ПолеСтроки.Ключ] = ПолеСтроки.Значение;
				КонецЦикла;
			Исключение
				ДобавитьОшибку(Ошибки, ПутьСтроки, "Ошибка заполнения строки табличной части");
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	Если Состояние.РежимОбъекта = "Строгий" Тогда
		Известные = Новый Соответствие;
		Для Каждого Поле Из Состояние.Поля Цикл
			Известные.Вставить(Поле.Ключ, Истина);
		КонецЦикла;
		Для Каждого ТЧ Из Состояние.ТабличныеЧасти Цикл
			Известные.Вставить(ТЧ.Ключ, Истина);
		КонецЦикла;
		Для Каждого КЗ Из Данные Цикл
			Если Известные.Получить(КЗ.Ключ) = Неопределено Тогда
				ПутьПоля = ?(Путь = "", КЗ.Ключ, Путь + "." + КЗ.Ключ);
				ДобавитьОшибку(Ошибки, ПутьПоля, "Неизвестное поле");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат НовыйОбъект;
КонецФункции

// --- Пересечение ---
Функция ПроверитьПересечение(Значение, Путь, Ошибки)

	ВсеСтруктуры = Истина;
	Результаты = Новый Массив;

	Для Каждого Схема Из Состояние.СхемыПересечения Цикл
		Результат = Схема.ПроверитьВнутренний(Значение, Путь, Ошибки);

		Если ТипЗнч(Результат) <> Тип("Структура")
			И ТипЗнч(Результат) <> Тип("Соответствие") Тогда
			ВсеСтруктуры = Ложь;
		КонецЕсли;

		Результаты.Добавить(Результат);
	КонецЦикла;

	// Если хоть одна схема вернула ошибки — общий результат уже невалиден,
	// ошибки накоплены, возвращаем Неопределено.
	Если ЕстьОшибкиПоПути(Ошибки, Путь) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Если все результаты — структуры/соответствия, мержим их
	Если ВсеСтруктуры И Результаты.Количество() > 0 Тогда
		Первый = Результаты[0];
		Результат = ?(ТипЗнч(Первый) = Тип("Соответствие"),
			Новый Соответствие, Новый Структура);
		Для Каждого Часть Из Результаты Цикл
			Для Каждого КЗ Из Часть Цикл
				Если ТипЗнч(Результат) = Тип("Соответствие") Тогда
					Результат.Вставить(КЗ.Ключ, КЗ.Значение);
				Иначе
					Результат.Вставить(КЗ.Ключ, КЗ.Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Иначе — результат последней схемы
	Если Результаты.Количество() > 0 Тогда
		Возврат Результаты[Результаты.Количество() - 1];
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Проверяет, добавились ли новые ошибки с указанным путём (для нужд
// ПроверитьПересечение). Сравнение — по префиксу пути или точному совпадению.
Функция ЕстьОшибкиПоПути(Ошибки, Путь)
	Для Каждого Ош Из Ошибки Цикл
		Если Путь = "" Тогда
			Возврат Истина;
		КонецЕсли;
		Если Ош.Путь = Путь
			ИЛИ СтрНачинаетсяС(Ош.Путь, Путь + ".")
			ИЛИ СтрНачинаетсяС(Ош.Путь, Путь + "[") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// --- Конвейер ---
Функция ПроверитьКонвейер(Значение, Путь, Ошибки)

	Если Состояние.СхемыКонвейера.Количество() = 0 Тогда
		Возврат Значение;
	КонецЕсли;

	// Первая схема
	Промежуточное = Состояние.СхемыКонвейера[0].ПроверитьВнутренний(Значение, Путь, Ошибки);

	// Промежуточные схемы (если цепочка из 3+)
	Для Индекс = 1 По Состояние.СхемыКонвейера.Количество() - 1 Цикл
		ОшибокДо = Ошибки.Количество();
		Промежуточное = Состояние.СхемыКонвейера[Индекс].ПроверитьВнутренний(
			Промежуточное, Путь, Ошибки);
		Если Ошибки.Количество() > ОшибокДо Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Промежуточное;

КонецФункции

// ============ ВСПОМОГАТЕЛЬНЫЕ ============

Функция ПрочитатьПоле(Коллекция, Имя)
	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Коллекция.Свойство(Имя, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Возврат Коллекция.Получить(Имя);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ДобавитьОшибку(Ошибки, Путь, Сообщение)
	Ошибки.Добавить(Новый Структура("Путь, Сообщение", Путь, Сообщение));
КонецПроцедуры

Функция СообщениеПоУмолчанию(Стандартное)
	Если Состояние.ОшибкаПоУмолчанию <> Неопределено Тогда
		Возврат Состояние.ОшибкаПоУмолчанию;
	КонецЕсли;
	Возврат Стандартное;
КонецФункции

Функция СообщениеИлиПоУмолчанию(Ошибка, Стандартное)
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;
	Возврат Стандартное;
КонецФункции

Функция ПривестиЗначение(Значение)
	Если Состояние.Тип = "Строка" Тогда
		Возврат Строка(Значение);
	ИначеЕсли Состояние.Тип = "Число" Тогда
		Попытка
			Возврат Число(Значение);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	ИначеЕсли Состояние.Тип = "Булево" Тогда
		Если ТипЗнч(Значение) = Тип("Булево") Тогда
			Возврат Значение;
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			С = ВРег(СокрЛП(Значение));
			Если С = "TRUE" ИЛИ С = "1" ИЛИ С = "ДА" Тогда
				Возврат Истина;
			ИначеЕсли С = "FALSE" ИЛИ С = "0" ИЛИ С = "НЕТ" Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат Значение <> 0;
		КонецЕсли;
		Возврат Неопределено;
	ИначеЕсли Состояние.Тип = "Дата" Тогда
		Если ТипЗнч(Значение) = Тип("Дата") Тогда
			Возврат Значение;
		КонецЕсли;
		Попытка
			Возврат Дата(Значение);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Проверяет, соответствует ли вся строка регулярному выражению.
// Использует встроенную функцию СтрНайтиПоРегулярномуВыражению.
Функция СоответствуетРегулярномуВыражению(Значение, Регекс)
	Попытка
		Результат = СтрНайтиПоРегулярномуВыражению(Значение, Регекс);
		Возврат Результат.НачальнаяПозиция > 0;
	Исключение
		Возврат Ложь; // некорректное регулярное выражение
	КонецПопытки;
КонецФункции

// Возвращает значение для подстановки в .ПоУмолчанию() / .Поймать().
//   - Если передана обработка с методом Создать() — вызывает его
//     (аналог .default(() => ...) в Zod).
//   - Массив / Структура / Соответствие — shallow-клон.
//   - Примитивы — как есть.
//
// Shallow-клон защищает от протекания мутаций между результатами
// (совпадает с поведением .default() в Zod 4).
Функция СкопироватьРезервноеЗначение(Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Проверяем, не фабрика ли это
	РезультатФабрики = ПопробоватьВызватьФабрику(Значение);
	Если РезультатФабрики <> Неопределено Тогда
		Возврат РезультатФабрики;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(Элемент);
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗначения = Тип("Структура") Тогда
		Результат = Новый Структура;
		Для Каждого КЗ Из Значение Цикл
			Результат.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КЗ Из Значение Цикл
			Результат.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Пытается вызвать метод Создать() Экспорт у значения, если это
// объект обработки. Возвращает Неопределено, если это не фабрика.
// Отличить «фабрика вернула Неопределено» от «это не фабрика» невозможно —
// поэтому фабрика НЕ должна возвращать Неопределено (документируем).
Функция ПопробоватьВызватьФабрику(Значение)
	ИмяТипа = Строка(ТипЗнч(Значение));
	Если НЕ СтрНачинаетсяС(ИмяТипа, "ОбработкаОбъект.") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Значение.Создать();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции
