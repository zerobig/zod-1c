// --- Кастомные проверки ---

Функция Проверка(ОбъектПроверки, Ошибка = Неопределено) Экспорт
	Если ОбъектПроверки = Неопределено Тогда
		ВызватьИсключение "zod-1c: объект проверки не может быть Неопределено";
	КонецЕсли;
	Если НЕ Состояние.Ограничения.Свойство("Проверки") Тогда
		Состояние.Ограничения.Вставить("Проверки", Новый Массив);
	КонецЕсли;
	Состояние.Ограничения.Проверки.Добавить(
		Новый Структура("Объект, Ошибка", ОбъектПроверки, Ошибка));
	Возврат ЭтотОбъект;
КонецФункции

Функция Трансформировать(ОбъектТрансформера) Экспорт
	Если ОбъектТрансформера = Неопределено Тогда
		ВызватьИсключение "zod-1c: объект трансформера не может быть Неопределено";
	КонецЕсли;
	Состояние.Трансформеры.Добавить(ОбъектТрансформера);
	Возврат ЭтотОбъект;
КонецФункции

// ============ ГЕНЕРАЦИЯ ПУСТЫХ ЗНАЧЕНИЙ ============

Функция СоздатьПустой() Экспорт
	Возврат СоздатьПустойВнутренний(Истина);
КонецФункции

Функция СоздатьМинимальный() Экспорт
	Возврат СоздатьПустойВнутренний(Ложь);
КонецФункции

Функция СоздатьПустойВнутренний(ВключатьНеобязательные) Экспорт
	Если Состояние.Необязательное Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Состояние.Тип = "Строка" Тогда
		Возврат "";
	ИначеЕсли Состояние.Тип = "Число" Тогда
		Возврат 0;
	ИначеЕсли Состояние.Тип = "Булево" Тогда
		Возврат Ложь;
	ИначеЕсли Состояние.Тип = "Дата" Тогда
		Возврат Дата(1, 1, 1);
	ИначеЕсли Состояние.Тип = "Объект" Тогда
		Результат = Новый Структура;
		Для Каждого Поле Из Состояние.Поля Цикл
			Если НЕ ВключатьНеобязательные И Поле.Значение.ЭтоНеобязательное() Тогда
				Продолжить;
			КонецЕсли;
			Результат.Вставить(Поле.Ключ,
				Поле.Значение.СоздатьПустойВнутренний(ВключатьНеобязательные));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Состояние.Тип = "Массив" Тогда
		Возврат Новый Массив;
	ИначеЕсли Состояние.Тип = "Запись" Тогда
		Возврат Новый Соответствие;
	ИначеЕсли Состояние.Тип = "Перечисление" Тогда
		Если Состояние.ДопустимыеЗначения.Количество() > 0 Тогда
			Возврат Состояние.ДопустимыеЗначения[0];
		КонецЕсли;
		Возврат Неопределено;
	ИначеЕсли Состояние.Тип = "Объединение" Тогда
		Для Каждого Вариант Из Состояние.Варианты Цикл
			Попытка
				Возврат Вариант.СоздатьПустойВнутренний(ВключатьНеобязательные);
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЦикла;
		Возврат Неопределено;
	ИначеЕсли Состояние.Тип = "Ссылка" Тогда
		Возврат СоздатьПустуюСсылку();
	ИначеЕсли Состояние.Тип = "Метаданные" Тогда
		Возврат Неопределено;
	ИначеЕсли Состояние.Тип = "Объект1С" Тогда
		Возврат СоздатьПустойОбъект1С();
	ИначеЕсли Состояние.Тип = "Любое" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Создаёт новый объект через правильный менеджерный метод.
// Использует СоздатьДокумент/СоздатьЭлемент/СоздатьБизнесПроцесс/... -
// в отличие от Новый(Тип(...)), эти методы полностью инициализируют объект.
Функция СоздатьОбъектМенеджером(Вид, ИмяОбъекта)
	Если Вид = "Документ" Тогда
		Возврат Документы[ИмяОбъекта].СоздатьДокумент();
	ИначеЕсли Вид = "Справочник" Тогда
		Возврат Справочники[ИмяОбъекта].СоздатьЭлемент();
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[ИмяОбъекта].СоздатьЭлемент();
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат ПланыСчетов[ИмяОбъекта].СоздатьЭлемент();
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат ПланыОбмена[ИмяОбъекта].СоздатьЭлемент();
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат БизнесПроцессы[ИмяОбъекта].СоздатьБизнесПроцесс();
	ИначеЕсли Вид = "Задача" Тогда
		Возврат Задачи[ИмяОбъекта].СоздатьЗадачу();
	КонецЕсли;
	ВызватьИсключение "zod-1c: неизвестный вид объекта '" + Вид + "'";
КонецФункции

Функция ПолучитьМенеджерСсылки(Вид, ИмяОбъекта)
	Если Вид = "Справочник" Тогда
		Возврат Справочники[ИмяОбъекта];
	ИначеЕсли Вид = "Документ" Тогда
		Возврат Документы[ИмяОбъекта];
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[ИмяОбъекта];
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат ПланыСчетов[ИмяОбъекта];
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат ПланыОбмена[ИмяОбъекта];
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат БизнесПроцессы[ИмяОбъекта];
	ИначеЕсли Вид = "Задача" Тогда
		Возврат Задачи[ИмяОбъекта];
	ИначеЕсли Вид = "Перечисление" Тогда
		Возврат Перечисления[ИмяОбъекта];
	КонецЕсли;
	ВызватьИсключение "zod-1c: неизвестный вид ссылки '" + Вид + "'";
КонецФункции

Функция СоздатьПустуюСсылку()
	Если Состояние.ЛюбыеТипыСсылки Тогда
		Возврат Неопределено; // Без конкретного типа нельзя
	КонецЕсли;
	Если Состояние.ДопустимыеТипыСсылки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипСсылки = Состояние.ДопустимыеТипыСсылки[0].ТипСсылки;
	Возврат Новый(ТипСсылки);
КонецФункции

Функция СоздатьПустойОбъект1С()
	Объект = СоздатьОбъектМенеджером(Состояние.ОбъектВид, Состояние.ОбъектИмя);
	Если Состояние.ЗаполнятьПоУмолчанию Тогда
		Попытка
			Объект.Заполнить(Неопределено);
		Исключение
			// Не подавляем - пробрасываем дальше, пусть тест/сервис увидит
			ВызватьИсключение "zod-1c: Ошибка Заполнить() у "
			+ Состояние.ОбъектВид + "." + Состояние.ОбъектИмя + ": "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	Возврат Объект;
КонецФункции

// ============ ПРОВЕРКА ============

Функция Проверить(Значение) Экспорт
	Ошибки = Новый Массив;
	Приведенное = ПроверитьВнутренний(Значение, "", Ошибки);
	Результат = Новый Структура("Успех, Данные, Ошибки");
	Результат.Успех = (Ошибки.Количество() = 0);
	Результат.Данные = ?(Результат.Успех, Приведенное, Неопределено);
	Результат.Ошибки = Ошибки;
	Возврат Результат;
КонецФункции

Функция ПроверитьИлиВыбросить(Значение) Экспорт
	Рез = Проверить(Значение);
	Если НЕ Рез.Успех Тогда
		ВызватьИсключение Zod.КрасивыйТекстОшибок(Рез.Ошибки);
	КонецЕсли;
	Возврат Рез.Данные;
КонецФункции

Функция ПроверитьВнутренний(Значение, Путь, Ошибки) Экспорт
	Для Каждого Трансформер Из Состояние.Трансформеры Цикл
		Значение = Трансформер.Преобразовать(Значение);
	КонецЦикла;

	Если Значение = Неопределено Тогда
		Если Состояние.Необязательное Тогда
			Возврат Неопределено;
		Иначе
			ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Обязательное значение"));
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	Если Состояние.Приведение Тогда
		Значение = ПривестиЗначение(Значение);
		Если Значение = Неопределено Тогда
			ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Не удалось привести к типу " + Состояние.Тип));
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	ОшибокДо = Ошибки.Количество();
	Результат = ПроверитьПоТипу(Значение, Путь, Ошибки);

	Если Ошибки.Количество() = ОшибокДо И Результат <> Неопределено Тогда
		ПрименитьКастомныеПроверки(Результат, Путь, Ошибки);
	КонецЕсли;

	Возврат Результат;
КонецФункции

Функция ПроверитьПоТипу(Значение, Путь, Ошибки)
	Если Состояние.Тип = "Строка" Тогда
		Возврат ПроверитьСтроку(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Число" Тогда
		Возврат ПроверитьЧисло(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Булево" Тогда
		Возврат ПроверитьТип(Значение, Путь, Ошибки, Тип("Булево"), "булево");
	ИначеЕсли Состояние.Тип = "Дата" Тогда
		Возврат ПроверитьТип(Значение, Путь, Ошибки, Тип("Дата"), "дату");
	ИначеЕсли Состояние.Тип = "Объект" Тогда
		Возврат ПроверитьОбъект(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Массив" Тогда
		Возврат ПроверитьМассив(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Запись" Тогда
		Возврат ПроверитьЗапись(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Перечисление" Тогда
		Возврат ПроверитьПеречисление(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Объединение" Тогда
		Возврат ПроверитьОбъединение(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Ссылка" Тогда
		Возврат ПроверитьСсылку(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Метаданные" Тогда
		Возврат ПроверитьМетаданные(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Объект1С" Тогда
		Возврат ПроверитьОбъект1С(Значение, Путь, Ошибки);
	ИначеЕсли Состояние.Тип = "Любое" Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// --- Кастомные проверки ---

Процедура ПрименитьКастомныеПроверки(Значение, Путь, Ошибки)
	Если НЕ Состояние.Ограничения.Свойство("Проверки") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Проверка Из Состояние.Ограничения.Проверки Цикл
		Результат = ВызватьПользовательскуюПроверку(Проверка.Объект, Значение);

		Если Результат = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Валидно = Ложь;
		Сообщение = Неопределено;

		Если ТипЗнч(Результат) = Тип("Булево") Тогда
			Валидно = Результат;
		ИначеЕсли ТипЗнч(Результат) = Тип("Строка") Тогда
			Валидно = Ложь;
			Сообщение = Результат;
		ИначеЕсли ТипЗнч(Результат) = Тип("Структура") Тогда
			Валидно = Ложь;
			Если Результат.Свойство("Валидно") Тогда
				Валидно = Результат.Валидно;
			КонецЕсли;
			Если Результат.Свойство("Сообщение") Тогда
				Сообщение = Результат.Сообщение;
			КонецЕсли;
		Иначе
			ВызватьИсключение "zod-1c: объект проверки вернул недопустимый тип "
			+ Строка(ТипЗнч(Результат))
			+ ". Ожидалось: Булево, Строка, Структура или Неопределено";
		КонецЕсли;

		Если НЕ Валидно Тогда
			ИтоговоеСообщение = Проверка.Ошибка;
			Если ИтоговоеСообщение = Неопределено Тогда
				ИтоговоеСообщение = ?(Сообщение = Неопределено,
						"Пользовательская проверка не пройдена", Сообщение);
			КонецЕсли;
			ДобавитьОшибку(Ошибки, Путь, ИтоговоеСообщение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ВызватьПользовательскуюПроверку(Объект, Значение)
	Попытка
		Возврат Объект.Проверить(Значение);
	Исключение
		ВызватьИсключение "zod-1c: ошибка в пользовательской проверке '"
		+ Строка(ТипЗнч(Объект)) + "': " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// --- Строка ---
Функция ПроверитьСтроку(Значение, Путь, Ошибки)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидалась строка"));
		Возврат Неопределено;
	КонецЕсли;
	Длина = СтрДлина(Значение);
	О = Состояние.Ограничения;
	Если О.Свойство("МинДлина") И Длина < О.МинДлина.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.МинДлина.Ошибка, "Мин. длина: " + О.МинДлина.Значение));
	КонецЕсли;
	Если О.Свойство("МаксДлина") И Длина > О.МаксДлина.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.МаксДлина.Ошибка, "Макс. длина: " + О.МаксДлина.Значение));
	КонецЕсли;
	Если О.Свойство("Мин") И Длина < О.Мин.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.Мин.Ошибка, "Мин. длина: " + О.Мин.Значение));
	КонецЕсли;
	Если О.Свойство("Макс") И Длина > О.Макс.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.Макс.Ошибка, "Макс. длина: " + О.Макс.Значение));
	КонецЕсли;
	Если О.Свойство("Непустая") И Значение = "" Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.Непустая, "Строка не может быть пустой"));
	КонецЕсли;
	Если О.Свойство("Паттерны") Тогда
		Для Каждого П Из О.Паттерны Цикл
			Если НЕ СоответствуетРегулярномуВыражению(Значение, П.Регулярка) Тогда
				ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(П.Ошибка, "Строка не соответствует формату"));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// --- Число ---
Функция ПроверитьЧисло(Значение, Путь, Ошибки)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидалось число"));
		Возврат Неопределено;
	КонецЕсли;
	О = Состояние.Ограничения;
	Если О.Свойство("Целое") И Цел(Значение) <> Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.Целое, "Ожидалось целое число"));
	КонецЕсли;
	Если О.Свойство("Мин") И Значение < О.Мин.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.Мин.Ошибка, "Мин. значение: " + О.Мин.Значение));
	КонецЕсли;
	Если О.Свойство("Макс") И Значение > О.Макс.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.Макс.Ошибка, "Макс. значение: " + О.Макс.Значение));
	КонецЕсли;
	Если О.Свойство("Положительное") И Значение <= 0 Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.Положительное, "Значение должно быть положительным"));
	КонецЕсли;
	Возврат Значение;
КонецФункции

// --- Универсальная проверка типа ---
Функция ПроверитьТип(Значение, Путь, Ошибки, ОжидаемыйТип, ИмяТипа)
	Если ТипЗнч(Значение) <> ОжидаемыйТип Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидалось " + ИмяТипа));
		Возврат Неопределено;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// --- Объект ---
Функция ПроверитьОбъект(Значение, Путь, Ошибки)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения <> Тип("Структура") И ТипЗначения <> Тип("Соответствие") Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидался объект"));
		Возврат Неопределено;
	КонецЕсли;

	// Результат того же типа, что и вход - чтобы не терять произвольные ключи
	Если ТипЗначения = Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
	Иначе
		Результат = Новый Структура;
	КонецЕсли;

	ИзвестныеКлючи = Новый Соответствие;
	Для Каждого Поле Из Состояние.Поля Цикл
		ИмяПоля = Поле.Ключ;
		СхемаПоля = Поле.Значение;
		ИзвестныеКлючи.Вставить(ИмяПоля, Истина);
		ПутьПоля = ?(Путь = "", ИмяПоля, Путь + "." + ИмяПоля);
		ЗначениеПоля = Неопределено;
		ЕстьПоле = Ложь;
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			ЕстьПоле = Значение.Свойство(ИмяПоля, ЗначениеПоля);
		Иначе
			ЕстьПоле = Значение.Получить(ИмяПоля) <> Неопределено;
			Если ЕстьПоле Тогда
				ЗначениеПоля = Значение.Получить(ИмяПоля);
			КонецЕсли;
		КонецЕсли;
		Если НЕ ЕстьПоле Тогда
			Если НЕ СхемаПоля.ЭтоНеобязательное() Тогда
				ДобавитьОшибку(Ошибки, ПутьПоля, "Обязательное поле отсутствует");
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Результат.Вставить(ИмяПоля, СхемаПоля.ПроверитьВнутренний(ЗначениеПоля, ПутьПоля, Ошибки));
	КонецЦикла;
	Для Каждого КЗ Из Значение Цикл
		Если ИзвестныеКлючи.Получить(КЗ.Ключ) = Неопределено Тогда
			Если Состояние.РежимОбъекта = "Строгий" Тогда
				ПутьПоля = ?(Путь = "", КЗ.Ключ, Путь + "." + КЗ.Ключ);
				ДобавитьОшибку(Ошибки, ПутьПоля, "Неизвестное поле");
			ИначеЕсли Состояние.РежимОбъекта = "Свободный" Тогда
				Результат.Вставить(КЗ.Ключ, КЗ.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// --- Массив ---
Функция ПроверитьМассив(Значение, Путь, Ошибки)
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидался массив"));
		Возврат Неопределено;
	КонецЕсли;
	О = Состояние.Ограничения;
	Если О.Свойство("МинЭлементов") И Значение.Количество() < О.МинЭлементов.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.МинЭлементов.Ошибка, "Мин. элементов: " + О.МинЭлементов.Значение));
	КонецЕсли;
	Если О.Свойство("МаксЭлементов") И Значение.Количество() > О.МаксЭлементов.Значение Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеИлиПоУмолчанию(О.МаксЭлементов.Ошибка, "Макс. элементов: " + О.МаксЭлементов.Значение));
	КонецЕсли;
	Если Состояние.ЭлементСхема = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Результат = Новый Массив;
	Для Индекс = 0 По Значение.Количество() - 1 Цикл
		Результат.Добавить(Состояние.ЭлементСхема.ПроверитьВнутренний(
				Значение[Индекс], Путь + "[" + Индекс + "]", Ошибки));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// --- Запись ---
Функция ПроверитьЗапись(Значение, Путь, Ошибки)
	Если ТипЗнч(Значение) <> Тип("Структура") И ТипЗнч(Значение) <> Тип("Соответствие") Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидалась запись"));
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Соответствие;
	Для Каждого Элемент Из Значение Цикл
		Ключ = Элемент.Ключ;
		ЗначениеЭлемента = Элемент.Значение;
		ЛокальныеОшибки = Новый Массив;
		ПриведенныйКлюч = Состояние.СхемаКлючаЗаписи.ПроверитьВнутренний(Ключ, Путь + "{ключ}", ЛокальныеОшибки);
		Если ЛокальныеОшибки.Количество() > 0 Тогда
			Для Каждого Ош Из ЛокальныеОшибки Цикл
				Ошибки.Добавить(Ош);
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		ПутьКлюча = ?(Путь = "", Ключ, Путь + "." + Ключ);
		ПриведенноеЗначение = Состояние.СхемаЗначенияЗаписи.ПроверитьВнутренний(
				ЗначениеЭлемента, ПутьКлюча, Ошибки);
		Результат.Вставить(ПриведенныйКлюч, ПриведенноеЗначение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// --- Перечисление (значений) ---
Функция ПроверитьПеречисление(Значение, Путь, Ошибки)
	Для Каждого Допустимое Из Состояние.ДопустимыеЗначения Цикл
		Если Допустимое = Значение Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Недопустимое значение"));
	Возврат Неопределено;
КонецФункции

// --- Объединение ---
Функция ПроверитьОбъединение(Значение, Путь, Ошибки)
	Для Каждого Вариант Из Состояние.Варианты Цикл
		ЛокальныеОшибки = Новый Массив;
		Приведенное = Вариант.ПроверитьВнутренний(Значение, Путь, ЛокальныеОшибки);
		Если ЛокальныеОшибки.Количество() = 0 Тогда
			Возврат Приведенное;
		КонецЕсли;
	КонецЦикла;
	ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Значение не соответствует ни одному из вариантов"));
	Возврат Неопределено;
КонецФункции

// --- Ссылка 1С ---
Функция ПроверитьСсылку(Значение, Путь, Ошибки)
	Если НЕ Состояние.ЛюбыеТипыСсылки И Состояние.ДопустимыеТипыСсылки.Количество() = 0 Тогда
		ВызватьИсключение "zod-1c: схема Ссылка не инициализирована";
	КонецЕсли;
	Если Zod.ЭтоСсылка1С(Значение) Тогда
		Возврат ОбработатьСсылку1С(Значение, Путь, Ошибки);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ОбработатьUUIDСтроку(Значение, Путь, Ошибки);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат ОбработатьОбъектСсылки(Значение, Путь, Ошибки);
	КонецЕсли;
	ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидалась ссылка"));
	Возврат Неопределено;
КонецФункции

Функция СоответствуетТипамСсылки(ТипСсылки)
	Если Состояние.ЛюбыеТипыСсылки Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Доп Из Состояние.ДопустимыеТипыСсылки Цикл
		Если ТипСсылки = Доп.ТипСсылки Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ОбработатьСсылку1С(Ссылка, Путь, Ошибки)
	Если НЕ СоответствуетТипамСсылки(ТипЗнч(Ссылка)) Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Недопустимый тип ссылки"));
		Возврат Неопределено;
	КонецЕсли;
	Если Состояние.ПроверятьСуществование И Ссылка.Пустая() Тогда
		ДобавитьОшибку(Ошибки, Путь, "Ссылка не существует");
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция ОбработатьUUIDСтроку(СтрокаUUID, Путь, Ошибки)
	Если Состояние.ЛюбыеТипыСсылки ИЛИ Состояние.ДопустимыеТипыСсылки.Количество() <> 1 Тогда
		ДобавитьОшибку(Ошибки, Путь, "Для составной или любой ссылки нужен объект {type, id}");
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Ид = Новый УникальныйИдентификатор(СтрокаUUID);
	Исключение
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Некорректный UUID"));
		Возврат Неопределено;
	КонецПопытки;

	ДопустимыйТип = Состояние.ДопустимыеТипыСсылки[0];

	Попытка
		Менеджер = ПолучитьМенеджерСсылки(ДопустимыйТип.Вид, ДопустимыйТип.ИмяОбъекта);
		Ссылка = Менеджер.ПолучитьСсылку(Ид);
	Исключение
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Не удалось получить ссылку"));
		Возврат Неопределено;
	КонецПопытки;

	Если Состояние.ПроверятьСуществование И Ссылка.Пустая() Тогда
		ДобавитьОшибку(Ошибки, Путь, "Ссылка не существует");
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ссылка;
КонецФункции

Функция ОбработатьОбъектСсылки(Объект, Путь, Ошибки)
	ТипИмя = ПрочитатьПоле(Объект, "type");
	ИдСтрокой = ПрочитатьПоле(Объект, "id");
	Если ТипИмя = Неопределено ИЛИ ИдСтрокой = Неопределено Тогда
		ДобавитьОшибку(Ошибки, Путь, "Ожидался объект {type, id}");
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(ТипИмя) <> Тип("Строка") ИЛИ ТипЗнч(ИдСтрокой) <> Тип("Строка") Тогда
		ДобавитьОшибку(Ошибки, Путь, "Поля type и id должны быть строками");
		Возврат Неопределено;
	КонецЕсли;

	// Проверяем, что тип входит в список допустимых (если он задан)
	ДопустимыйТип = Неопределено;
	Если НЕ Состояние.ЛюбыеТипыСсылки Тогда
		Для Каждого Доп Из Состояние.ДопустимыеТипыСсылки Цикл
			Если Доп.Имя = ТипИмя Тогда
				ДопустимыйТип = Доп;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ДопустимыйТип = Неопределено Тогда
			ДобавитьОшибку(Ошибки, Путь, "Недопустимый тип ссылки: " + ТипИмя);
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		// ЛюбаяСсылка: разбираем строку вручную
		ПозицияТочки = СтрНайти(ТипИмя, ".");
		Если ПозицияТочки <= 0 Тогда
			ДобавитьОшибку(Ошибки, Путь, "Некорректное имя типа: " + ТипИмя);
			Возврат Неопределено;
		КонецЕсли;
		Попытка
			ПроверочныйТип = Тип(СтрЗаменить(ТипИмя, ".", "Ссылка."));
		Исключение
			ДобавитьОшибку(Ошибки, Путь, "Неизвестный тип: " + ТипИмя);
			Возврат Неопределено;
		КонецПопытки;
		ДопустимыйТип = Новый Структура("Имя, Вид, ИмяОбъекта, ТипСсылки",
				ТипИмя,
				Лев(ТипИмя, ПозицияТочки - 1),
				Сред(ТипИмя, ПозицияТочки + 1),
				ПроверочныйТип);
	КонецЕсли;

	Попытка
		Ид = Новый УникальныйИдентификатор(ИдСтрокой);
	Исключение
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Некорректный UUID"));
		Возврат Неопределено;
	КонецПопытки;

	Попытка
		Менеджер = ПолучитьМенеджерСсылки(ДопустимыйТип.Вид, ДопустимыйТип.ИмяОбъекта);
		Ссылка = Менеджер.ПолучитьСсылку(Ид);
	Исключение
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Не удалось получить ссылку"));
		Возврат Неопределено;
	КонецПопытки;

	Если Состояние.ПроверятьСуществование И Ссылка.Пустая() Тогда
		ДобавитьОшибку(Ошибки, Путь, "Ссылка не существует");
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ссылка;
КонецФункции

// --- Метаданные ---
Функция ПроверитьМетаданные(Значение, Путь, Ошибки)
	Если НЕ ЭтоОбъектМетаданных(Значение) Тогда
		ДобавитьОшибку(Ошибки, Путь, СообщениеПоУмолчанию("Ожидался объект метаданных"));
		Возврат Неопределено;
	КонецЕсли;
	Если Состояние.ВидМетаданных <> Неопределено Тогда
		ПолноеИмя = Значение.ПолноеИмя();
		Позиция = СтрНайти(ПолноеИмя, ".");
		Вид = ?(Позиция > 0, Лев(ПолноеИмя, Позиция - 1), ПолноеИмя);
		Если Вид <> Состояние.ВидМетаданных Тогда
			ДобавитьОшибку(Ошибки, Путь, "Ожидался объект метаданных вида " + Состояние.ВидМетаданных);
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ЭтоОбъектМетаданных(Значение)
	Попытка
		Возврат Метаданные.НайтиПоПолномуИмени(Значение.ПолноеИмя()) = Значение;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// --- Объект 1С ---
Функция ПроверитьОбъект1С(Значение, Путь, Ошибки)
	Если Состояние.ОбъектВид = Неопределено ИЛИ Состояние.ОбъектИмя = Неопределено Тогда
		ВызватьИсключение "zod-1c: схема Объект1С не инициализирована";
	КонецЕсли;

	ОбъектТип = Тип(Состояние.ОбъектВид + "Объект." + Состояние.ОбъектИмя);

	Если ТипЗнч(Значение) = ОбъектТип Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат СоздатьОбъект1СИзДанных(Значение, Путь, Ошибки);
	КонецЕсли;

	ДобавитьОшибку(Ошибки, Путь,
		СообщениеПоУмолчанию("Ожидался объект " + Состояние.ОбъектВид + "." + Состояние.ОбъектИмя));
	Возврат Неопределено;
КонецФункции

Функция СоздатьОбъект1СИзДанных(Данные, Путь, Ошибки)
	НовыйОбъект = СоздатьОбъектМенеджером(Состояние.ОбъектВид, Состояние.ОбъектИмя);

	Если Состояние.ЗаполнятьПоУмолчанию Тогда
		Попытка
			НовыйОбъект.Заполнить(Неопределено);
		Исключение
			ДобавитьОшибку(Ошибки, Путь,
				"Ошибка Заполнить(): "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Для Каждого Поле Из Состояние.Поля Цикл
		ИмяПоля = Поле.Ключ;
		СхемаПоля = Поле.Значение;
		ПутьПоля = ?(Путь = "", ИмяПоля, Путь + "." + ИмяПоля);

		ЗначениеПоля = Неопределено;
		ЕстьПоле = Ложь;
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			ЕстьПоле = Данные.Свойство(ИмяПоля, ЗначениеПоля);
		Иначе
			ЕстьПоле = Данные.Получить(ИмяПоля) <> Неопределено;
			Если ЕстьПоле Тогда
				ЗначениеПоля = Данные.Получить(ИмяПоля);
			КонецЕсли;
		КонецЕсли;

		Если НЕ ЕстьПоле Тогда
			Если НЕ СхемаПоля.ЭтоНеобязательное() Тогда
				ДобавитьОшибку(Ошибки, ПутьПоля, "Обязательное поле отсутствует");
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		ЛокальныеОшибки = Новый Массив;
		ПроверенноеЗначение = СхемаПоля.ПроверитьВнутренний(ЗначениеПоля, ПутьПоля, ЛокальныеОшибки);
		Для Каждого Ош Из ЛокальныеОшибки Цикл
			Ошибки.Добавить(Ош);
		КонецЦикла;

		Если ЛокальныеОшибки.Количество() = 0 Тогда
			Попытка
				НовыйОбъект[ИмяПоля] = ПроверенноеЗначение;
			Исключение
				ДобавитьОшибку(Ошибки, ПутьПоля,
					"Ошибка присвоения значения: "
					+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТЧ Из Состояние.ТабличныеЧасти Цикл
		ИмяТЧ = ТЧ.Ключ;
		СхемаСтроки = ТЧ.Значение;
		ПутьТЧ = ?(Путь = "", ИмяТЧ, Путь + "." + ИмяТЧ);

		ЗначениеТЧ = Неопределено;
		ЕстьТЧ = Ложь;
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			ЕстьТЧ = Данные.Свойство(ИмяТЧ, ЗначениеТЧ);
		Иначе
			ЕстьТЧ = Данные.Получить(ИмяТЧ) <> Неопределено;
			Если ЕстьТЧ Тогда
				ЗначениеТЧ = Данные.Получить(ИмяТЧ);
			КонецЕсли;
		КонецЕсли;

		Если НЕ ЕстьТЧ Тогда
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(ЗначениеТЧ) <> Тип("Массив") Тогда
			ДобавитьОшибку(Ошибки, ПутьТЧ, "Ожидался массив строк");
			Продолжить;
		КонецЕсли;

		Для Индекс = 0 По ЗначениеТЧ.Количество() - 1 Цикл
			СтрокаДанных = ЗначениеТЧ[Индекс];
			ПутьСтроки = ПутьТЧ + "[" + Индекс + "]";

			ЛокальныеОшибки = Новый Массив;
			РезультатСтроки = СхемаСтроки.ПроверитьВнутренний(СтрокаДанных, ПутьСтроки, ЛокальныеОшибки);
			Для Каждого Ош Из ЛокальныеОшибки Цикл
				Ошибки.Добавить(Ош);
			КонецЦикла;

			Если ЛокальныеОшибки.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;

			Попытка
				НоваяСтрока = НовыйОбъект[ИмяТЧ].Добавить();
				Для Каждого ПолеСтроки Из РезультатСтроки Цикл
					НоваяСтрока[ПолеСтроки.Ключ] = ПолеСтроки.Значение;
				КонецЦикла;
			Исключение
				ДобавитьОшибку(Ошибки, ПутьСтроки, "Ошибка заполнения строки табличной части");
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	Если Состояние.РежимОбъекта = "Строгий" Тогда
		Известные = Новый Соответствие;
		Для Каждого Поле Из Состояние.Поля Цикл
			Известные.Вставить(Поле.Ключ, Истина);
		КонецЦикла;
		Для Каждого ТЧ Из Состояние.ТабличныеЧасти Цикл
			Известные.Вставить(ТЧ.Ключ, Истина);
		КонецЦикла;
		Для Каждого КЗ Из Данные Цикл
			Если Известные.Получить(КЗ.Ключ) = Неопределено Тогда
				ПутьПоля = ?(Путь = "", КЗ.Ключ, Путь + "." + КЗ.Ключ);
				ДобавитьОшибку(Ошибки, ПутьПоля, "Неизвестное поле");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат НовыйОбъект;
КонецФункции

// ============ ВСПОМОГАТЕЛЬНЫЕ ============

Функция ПрочитатьПоле(Коллекция, Имя)
	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Коллекция.Свойство(Имя, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Возврат Коллекция.Получить(Имя);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ДобавитьОшибку(Ошибки, Путь, Сообщение)
	Ошибки.Добавить(Новый Структура("Путь, Сообщение", Путь, Сообщение));
КонецПроцедуры

Функция СообщениеПоУмолчанию(Стандартное)
	Если Состояние.ОшибкаПоУмолчанию <> Неопределено Тогда
		Возврат Состояние.ОшибкаПоУмолчанию;
	КонецЕсли;
	Возврат Стандартное;
КонецФункции

Функция СообщениеИлиПоУмолчанию(Ошибка, Стандартное)
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;
	Возврат Стандартное;
КонецФункции

Функция ПривестиЗначение(Значение)
	Если Состояние.Тип = "Строка" Тогда
		Возврат Строка(Значение);
	ИначеЕсли Состояние.Тип = "Число" Тогда
		Попытка
			Возврат Число(Значение);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	ИначеЕсли Состояние.Тип = "Булево" Тогда
		Если ТипЗнч(Значение) = Тип("Булево") Тогда
			Возврат Значение;
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			С = ВРег(СокрЛП(Значение));
			Если С = "TRUE" ИЛИ С = "1" ИЛИ С = "ДА" Тогда
				Возврат Истина;
			ИначеЕсли С = "FALSE" ИЛИ С = "0" ИЛИ С = "НЕТ" Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат Значение <> 0;
		КонецЕсли;
		Возврат Неопределено;
	ИначеЕсли Состояние.Тип = "Дата" Тогда
		Если ТипЗнч(Значение) = Тип("Дата") Тогда
			Возврат Значение;
		КонецЕсли;
		Попытка
			Возврат Дата(Значение);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Проверяет, соответствует ли вся строка регулярному выражению.
// Использует встроенную функцию СтрНайтиПоРегулярномуВыражению.
Функция СоответствуетРегулярномуВыражению(Значение, Регекс)
	Попытка
		Результат = СтрНайтиПоРегулярномуВыражению(Значение, Регекс);
		Возврат Результат.НачальнаяПозиция > 0;
	Исключение
		Возврат Ложь; // некорректное регулярное выражение
	КонецПопытки;
КонецФункции
