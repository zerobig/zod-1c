////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - адаптер-трансформер.
// Позволяет вызывать произвольный публичный метод обработки как
// трансформер схемы. Создаётся через Zod.Трансформер().
////////////////////////////////////////////////////////////////////////////////

Перем _Объект;
Перем _ИмяМетода;
Перем _Параметры;

Процедура Инициализировать(Объект, ИмяМетода, Параметры) Экспорт
	_Объект = Объект;
	_ИмяМетода = ИмяМетода;
	_Параметры = Параметры;
КонецПроцедуры

Функция Преобразовать(Значение) Экспорт

	// В 1С нет first-class functions. Единственный способ вызвать метод
	// по имени - Выполнить(). Передаём объект, значение и параметры
	// через структуру-контекст, чтобы избежать интерполяции данных
	// в текст кода (только имя метода интерполируется, но оно
	// провалидировано как идентификатор в Zod.Трансформер).
	Контекст = Новый Структура;
	Контекст.Вставить("Объект",    _Объект);
	Контекст.Вставить("Значение",  Значение);
	Контекст.Вставить("Параметры", _Параметры);
	Контекст.Вставить("Результат", Неопределено);

	Текст = "Контекст.Результат = Контекст.Объект." + _ИмяМетода
		+ "(Контекст.Значение, Контекст.Параметры);";

	Попытка
		Выполнить(Текст);
	Исключение
		Информация = ИнформацияОбОшибке();
		ВызватьИсключение "zod-1c: Трансформер(" + Строка(ТипЗнч(_Объект)) + "."
			+ _ИмяМетода + "): " + КраткоеПредставлениеОшибки(Информация);
	КонецПопытки;

	Возврат Контекст.Результат;

КонецФункции
