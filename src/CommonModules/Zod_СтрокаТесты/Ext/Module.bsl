Процедура МетодСМинДлиной() Экспорт
	// Chain: Email + МинДлина одновременно
	Схема = Zod.Строки().Email().МинДлина(10);

	ЮТест.ОжидаетЧто(Схема.Проверить("a@b.co").Успех).ЭтоЛожь(); // email ок, но 6 < 10
	ЮТест.ОжидаетЧто(Схема.Проверить("test@example.com").Успех).ЭтоИстина(); // ок
	ЮТест.ОжидаетЧто(Схема.Проверить("bad@long-bad-string").Успех).ЭтоЛожь(); // длина ок, но не email
КонецПроцедуры

Процедура НесколькоПаттернов() Экспорт
	// Два паттерна - оба должны совпасть
	Схема = Zod.Строки()
		.Паттерн("^\d+$") // только цифры
		.Паттерн("^1\d*$"); // начинается с 1

	ЮТест.ОжидаетЧто(Схема.Проверить("123").Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить("1234").Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить("abc").Успех).ЭтоЛожь(); // не цифры
	ЮТест.ОжидаетЧто(Схема.Проверить("234").Успех).ЭтоЛожь(); // не начинается с 1
КонецПроцедуры

