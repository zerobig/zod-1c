Процедура ВалиднаяСтрока() Экспорт
	Результат = Zod.Строки().Проверить("Привет");
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные).Равно("Привет");
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(0);
КонецПроцедуры

Процедура НеверныйТип() Экспорт

	// 1. Обязательное поле с Неопределено → "Обязательное значение"
	Результат = Zod.Строки().Проверить(Неопределено);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Обязательное значение");

	// 2. Остальные значения → "Ожидалась строка"
	Для Каждого Значение Из ЮТКоллекции.ЗначениеВМассиве(
			123, 1.5, Истина, Новый Структура, Новый Массив) Цикл

		Результат = Zod.Строки().Проверить(Значение);
		ЮТест.ОжидаетЧто(Результат.Успех, "Значение: " + Строка(Значение)).ЭтоЛожь();
		ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
		ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Ожидалась строка");
	КонецЦикла;

КонецПроцедуры

Процедура Неопределено_ОбязательноеVsНеобязательное() Экспорт

	// Обязательное → ошибка "Обязательное значение"
	Результат1 = Zod.Строки().Проверить(Неопределено);
	ЮТест.ОжидаетЧто(Результат1.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат1.Ошибки[0].Сообщение).Равно("Обязательное значение");

	// Необязательное → без ошибки, результат Неопределено
	Результат2 = Zod.Строки().Необязательное().Проверить(Неопределено);
	ЮТест.ОжидаетЧто(Результат2.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат2.Данные).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Результат2.Ошибки.Количество()).Равно(0);

КонецПроцедуры

Процедура НепустаяСтрока() Экспорт
	// Пустая строка - ошибка
	ЮТест.ОжидаетЧто(Zod.Строки().Непустая().Проверить("").Успех).ЭтоЛожь();

	// Строка из пробелов - не пустая (СтрДлина > 0), проходит
	ЮТест.ОжидаетЧто(Zod.Строки().Непустая().Проверить("   ").Успех).ЭтоИстина();

	// Кастомная ошибка
	Результат = Zod.Строки().Непустая("Поле обязательно").Проверить("");
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Поле обязательно");
КонецПроцедуры

Процедура МинДлина() Экспорт
	Схема = Zod.Строки().МинДлина(3);

	ЮТест.ОжидаетЧто(Схема.Проверить("ab").Успех).ЭтоЛожь(); // 2 < 3
	ЮТест.ОжидаетЧто(Схема.Проверить("abc").Успех).ЭтоИстина(); // 3 = 3
	ЮТест.ОжидаетЧто(Схема.Проверить("abcd").Успех).ЭтоИстина(); // 4 > 3

	Результат = Zod.Строки().МинДлина(3, "Слишком коротко").Проверить("ab");
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Слишком коротко");
КонецПроцедуры

Процедура МаксДлина() Экспорт
	Схема = Zod.Строки().МаксДлина(3);

	ЮТест.ОжидаетЧто(Схема.Проверить("abc").Успех).ЭтоИстина(); // 3 = 3
	ЮТест.ОжидаетЧто(Схема.Проверить("abcd").Успех).ЭтоЛожь(); // 4 > 3
	ЮТест.ОжидаетЧто(Схема.Проверить("").Успех).ЭтоИстина(); // 0 <= 3

	Результат = Zod.Строки().МаксДлина(3, "Слишком длинно").Проверить("abcd");
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Слишком длинно");
КонецПроцедуры

