Процедура НеобязательноеПоле() Экспорт
	// Отсутствие значения (Неопределено) - ок
	ЮТест.ОжидаетЧто(Zod.Строки().Необязательное().Проверить(Неопределено).Успех).ЭтоИстина();

	// Пустая строка с Непустая - всё равно ошибка (значение передано, хоть и пустое)
	ЮТест.ОжидаетЧто(Zod.Строки().Непустая().Необязательное().Проверить("").Успех).ЭтоЛожь();

	// Валидное значение - ок
	ЮТест.ОжидаетЧто(Zod.Строки().Необязательное().Проверить("ok").Успех).ЭтоИстина();
КонецПроцедуры

