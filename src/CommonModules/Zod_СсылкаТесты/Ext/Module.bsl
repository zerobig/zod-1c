Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		.ДобавитьТест("UUIDСтрокаДляКонкретногоТипа")
		.ДобавитьТест("ОбъектTypeIdДляКонкретногоТипа")
		.ДобавитьТест("ОбъектTypeIdДляСоставной")
		.ДобавитьТест("НеверныйТипВОбъекте")
		.ДобавитьТест("НеверныйUUID")
		.ДобавитьТест("ГотоваяСсылка")
		.ДобавитьТест("ТолькоСуществующая")
		.ДобавитьТест("ЛюбаяСсылка")
		.ДобавитьТест("ИлиСсылка");
КонецПроцедуры

Процедура UUIDСтрокаДляКонкретногоТипа() Экспорт
	Схема = Zod.Справочник("Zod_Справочник1");
	UUID = "00000000-0000-0000-0000-000000000001";

	Результат = Схема.Проверить(UUID);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.Данные)).Равно(Тип("СправочникСсылка.Zod_Справочник1"));
КонецПроцедуры

Процедура ОбъектTypeIdДляКонкретногоТипа() Экспорт
	Схема = Zod.Справочник("Zod_Справочник1");
	Данные = Новый Структура("type, id",
			"Справочник.Zod_Справочник1",
			"00000000-0000-0000-0000-000000000001");

	Результат = Схема.Проверить(Данные);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
КонецПроцедуры

Процедура ОбъектTypeIdДляСоставной() Экспорт
	Схема = Zod.СоставнаяСсылка("Справочник.Zod_Справочник1")
		.ИлиСсылка("Справочник.Контрагенты");

	Данные = Новый Структура("type, id",
			"Справочник.Контрагенты",
			"00000000-0000-0000-0000-000000000001");

	Результат = Схема.Проверить(Данные);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
КонецПроцедуры

Процедура НеверныйТипВОбъекте() Экспорт
	Схема = Zod.Справочник("Zod_Справочник1");

	// Тип не тот
	Данные = Новый Структура("type, id",
			"Справочник.Контрагенты",
			"00000000-0000-0000-0000-000000000001");

	ЮТест.ОжидаетЧто(Схема.Проверить(Данные).Успех).ЭтоЛожь();

	// Тип не существует
	Данные = Новый Структура("type, id",
			"Справочник.Несуществующий",
			"00000000-0000-0000-0000-000000000001");
	ЮТест.ОжидаетЧто(Схема.Проверить(Данные).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура НеверныйUUID() Экспорт
	Схема = Zod.Справочник("Zod_Справочник1");

	ЮТест.ОжидаетЧто(Схема.Проверить("not-a-uuid").Успех).ЭтоЛожь();

	Данные = Новый Структура("type, id", "Справочник.Zod_Справочник1", "not-a-uuid");
	ЮТест.ОжидаетЧто(Схема.Проверить(Данные).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ГотоваяСсылка() Экспорт
	// Создаём элемент, чтобы получить реальную ссылку
	Ссылка = ЮТест.Данные().СоздатьЭлемент("Справочник.Zod_Справочник1", "Тестовый элемент");

	Схема = Zod.Справочник("Zod_Справочник1");
	Результат = Схема.Проверить(Ссылка);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные).Равно(Ссылка);
КонецПроцедуры

Процедура ТолькоСуществующая() Экспорт
	// Пустая ссылка без проверки существования - ок
	СхемаБезПроверки = Zod.Справочник("Zod_Справочник1");
	ЮТест.ОжидаетЧто(СхемаБезПроверки.Проверить("00000000-0000-0000-0000-000000000000").Успех).ЭтоИстина();

	// Пустая ссылка с проверкой существования - ошибка
	СхемаСПроверкой = Zod.Справочник("Zod_Справочник1").ТолькоСуществующая();
	ЮТест.ОжидаетЧто(СхемаСПроверкой.Проверить("00000000-0000-0000-0000-000000000000").Успех).ЭтоЛожь();

	// Существующая ссылка - ок
	Ссылка = ЮТест.Данные().СоздатьЭлемент("Справочник.Zod_Справочник1", "Существующая");
	ЮТест.ОжидаетЧто(СхемаСПроверкой.Проверить(Ссылка).Успех).ЭтоИстина();
КонецПроцедуры

Процедура ЛюбаяСсылка() Экспорт
	Схема = Zod.ЛюбаяСсылка();

	// Конкретный тип в {type, id}
	Данные = Новый Структура("type, id",
			"Справочник.Zod_Справочник1",
			"00000000-0000-0000-0000-000000000001");
	ЮТест.ОжидаетЧто(Схема.Проверить(Данные).Успех).ЭтоИстина();

	// UUID-строка без типа - ошибка
	ЮТест.ОжидаетЧто(Схема.Проверить("00000000-0000-0000-0000-000000000001").Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ИлиСсылка() Экспорт
	Схема = Zod.СоставнаяСсылка("Справочник.Zod_Справочник1")
		.ИлиСсылка("Справочник.Контрагенты");

	// Первый тип
	Данные = Новый Структура("type, id",
			"Справочник.Zod_Справочник1",
			"00000000-0000-0000-0000-000000000001");
	ЮТест.ОжидаетЧто(Схема.Проверить(Данные).Успех).ЭтоИстина();

	// Второй тип
	Данные = Новый Структура("type, id",
			"Справочник.Контрагенты",
			"00000000-0000-0000-0000-000000000001");
	ЮТест.ОжидаетЧто(Схема.Проверить(Данные).Успех).ЭтоИстина();

	// Третий тип - ошибка
	Данные = Новый Структура("type, id",
			"Справочник.Организации",
			"00000000-0000-0000-0000-000000000001");
	ЮТест.ОжидаетЧто(Схема.Проверить(Данные).Успех).ЭтоЛожь();
КонецПроцедуры
