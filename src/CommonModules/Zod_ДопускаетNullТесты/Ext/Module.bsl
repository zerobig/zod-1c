////////////////////////////////////////////////////////////////////////////////
// YaxUnit-тесты для модификатора .ДопускаетNull() в zod-1c.
//
// Проверяют матрицу семантики:
//   required + nullable, optional + nullable, и т.д.
////////////////////////////////////////////////////////////////////////////////

Процедура ИсполняемыеСценарии() Экспорт
    ЮТТесты
        .ДобавитьТестовыйНабор("zod-1c: ДопускаетNull - примитивы")
            .ДобавитьТест("СтрокаДопускаетNull_ПринимаетНеопределено")
            .ДобавитьТест("СтрокаДопускаетNull_ПринимаетЗначение")
            .ДобавитьТест("СтрокаДопускаетNull_НеПринимаетДругойТип")
        .ДобавитьТестовыйНабор("zod-1c: ДопускаетNull - объекты")
            .ДобавитьТест("ОбязательноеСДопускаетNull_КлючОбязателен")
            .ДобавитьТест("ОбязательноеСДопускаетNull_ПринимаетНеопределено")
            .ДобавитьТест("ОбязательноеСДопускаетNull_ПринимаетЗначение")
            .ДобавитьТест("ОпциональноеСДопускаетNull_КлючМожетОтсутствовать")
            .ДобавитьТест("ОпциональноеСДопускаетNull_ПринимаетНеопределено")
            .ДобавитьТест("ОбязательноеБезNull_НеопределеноОшибка")
            .ДобавитьТест("ОпциональноеБезNull_НеопределеноПринимает")
        .ДобавитьТестовыйНабор("zod-1c: ДопускаетNull - массивы")
            .ДобавитьТест("МассивСЭлементомДопускаетNull")
            .ДобавитьТест("МассивБезДопускаетNull_НеопределеноОшибка")
        .ДобавитьТестовыйНабор("zod-1c: ДопускаетNull - утилиты")
            .ДобавитьТест("ДопускаетОтсутствие_ТолькоНеобязательное")
            .ДобавитьТест("ДопускаетНеопределено_НеобязательноеИлиNull")
            .ДобавитьТест("ЭтоНеобязательное_АлиасДопускаетОтсутствие")
    ;
КонецПроцедуры

// ============ ПРИМИТИВЫ ============

Процедура СтрокаДопускаетNull_ПринимаетНеопределено() Экспорт
    Схема = Zod.Строки().ДопускаетNull();

    Рез = Схема.Проверить(Неопределено);
    ЮТест.ОжидаетЧто(Рез.Успех).ЭтоИстина();
    ЮТест.ОжидаетЧто(Рез.Данные).Равно(Неопределено);
КонецПроцедуры

Процедура СтрокаДопускаетNull_ПринимаетЗначение() Экспорт
    Схема = Zod.Строки().ДопускаетNull();

    Рез = Схема.Проверить("abc");
    ЮТест.ОжидаетЧто(Рез.Успех).ЭтоИстина();
    ЮТест.ОжидаетЧто(Рез.Данные).Равно("abc");
КонецПроцедуры

Процедура СтрокаДопускаетNull_НеПринимаетДругойТип() Экспорт
    Схема = Zod.Строки().ДопускаетNull();

    Рез = Схема.Проверить(123);
    ЮТест.ОжидаетЧто(Рез.Успех).ЭтоЛожь();
    ЮТест.ОжидаетЧто(Рез.Ошибки.Количество()).Равно(1);
КонецПроцедуры

// ============ ОБЪЕКТЫ ============

Процедура ОбязательноеСДопускаетNull_КлючОбязателен() Экспорт
    Схема = Zod.СтрогийОбъект()
        .Поле("id", Zod.Строки().ДопускаетNull());

    // Ключа id нет - ошибка, несмотря на ДопускаетNull
    Рез = Схема.Проверить(Новый Структура);
    ЮТест.ОжидаетЧто(Рез.Успех).ЭтоЛожь();
    ЮТест.ОжидаетЧто(Рез.Ошибки.Количество()).Равно(1);
    ЮТест.ОжидаетЧто(Рез.Ошибки[0].Путь).Равно("id");
    ЮТест.ОжидаетЧто(Рез.Ошибки[0].Сообщение)
        .Равно("Обязательное поле отсутствует");
КонецПроцедуры

Процедура ОбязательноеСДопускаетNull_ПринимаетНеопределено() Экспорт
    Схема = Zod.СтрогийОбъект()
        .Поле("id", Zod.Строки().ДопускаетNull());

    // Ключ есть, значение Неопределено - ok
    Рез = Схема.Проверить(Новый Структура("id", Неопределено));
    ЮТест.ОжидаетЧто(Рез.Успех).ЭтоИстина();
КонецПроцедуры

Процедура ОбязательноеСДопускаетNull_ПринимаетЗначение() Экспорт
    Схема = Zod.СтрогийОбъект()
        .Поле("id", Zod.Строки().ДопускаетNull());

    Рез = Схема.Проверить(Новый Структура("id", "abc"));
    ЮТест.ОжидаетЧто(Рез.Успех).ЭтоИстина();
    ЮТест.ОжидаетЧто(Рез.Данные.id).Равно("abc");
КонецПроцедуры

Процедура ОпциональноеСДопускаетNull_КлючМожетОтсутствовать() Экспорт
    Схема = Zod.СтрогийОбъект()
        .Поле("id", Zod.Строки().ДопускаетNull().Необязательное());

    Рез = Схема.Проверить(Новый Структура);
    ЮТест.ОжидаетЧто(Рез.Успех).ЭтоИстина();
КонецПроцедуры

Процедура ОпциональноеСДопускаетNull_ПринимаетНеопределено() Экспорт
    Схема = Zod.СтрогийОбъект()
        .Поле("id", Zod.Строки().ДопускаетNull().Необязательное());

    Рез = Схема.Проверить(Новый Структура("id", Неопределено));
    ЮТест.ОжидаетЧто(Рез.Успех).ЭтоИстина();
КонецПроцедуры

Процедура ОбязательноеБезNull_НеопределеноОшибка() Экспорт
    // Без .ДопускаетNull() и без .Необязательное():
    // ключ есть, значение Неопределено → ошибка «Обязательное значение»
    Схема = Zod.СтрогийОбъект()
        .Поле("id", Zod.Строки());

    Рез = Схема.Проверить(Новый Структура("id", Неопределено));
    ЮТест.ОжидаетЧто(Рез.Успех).ЭтоЛожь();
    ЮТест.ОжидаетЧто(Рез.Ошибки[0].Сообщение).Равно("Обязательное значение");
КонецПроцедуры

Процедура ОпциональноеБезNull_НеопределеноПринимает() Экспорт
    // Текущее поведение .Необязательное() - как .nullish() в Zod:
    // пропускает и отсутствие ключа, и Неопределено.
    Схема = Zod.СтрогийОбъект()
        .Поле("id", Zod.Строки().Необязательное());

    Рез = Схема.Проверить(Новый Структура("id", Неопределено));
    ЮТест.ОжидаетЧто(Рез.Успех).ЭтоИстина();
КонецПроцедуры

// ============ МАССИВЫ ============

Процедура МассивСЭлементомДопускаетNull() Экспорт
    Схема = Zod.Массивы().Элемент(Zod.Строки().ДопускаетNull());

    Массив = ЮТКоллекции.ЗначениеВМассиве("a", Неопределено, "b");
    Рез = Схема.Проверить(Массив);

    ЮТест.ОжидаетЧто(Рез.Успех).ЭтоИстина();
    ЮТест.ОжидаетЧто(Рез.Данные.Количество()).Равно(3);
    ЮТест.ОжидаетЧто(Рез.Данные[1]).Равно(Неопределено);
КонецПроцедуры

Процедура МассивБезДопускаетNull_НеопределеноОшибка() Экспорт
    Схема = Zod.Массивы().Элемент(Zod.Строки());

    Массив = ЮТКоллекции.ЗначениеВМассиве("a", Неопределено);
    Рез = Схема.Проверить(Массив);

    ЮТест.ОжидаетЧто(Рез.Успех).ЭтоЛожь();
    ЮТест.ОжидаетЧто(Рез.Ошибки.Количество()).Больше(0);
    ЮТест.ОжидаетЧто(Рез.Ошибки[0].Путь).Равно("[1]");
КонецПроцедуры

// ============ УТИЛИТЫ ============

Процедура ДопускаетОтсутствие_ТолькоНеобязательное() Экспорт
    // Без флагов - не допускает отсутствия
    ЮТест.ОжидаетЧто(Zod.Строки().ДопускаетОтсутствие()).ЭтоЛожь();

    // С Необязательное - допускает
    ЮТест.ОжидаетЧто(Zod.Строки().Необязательное().ДопускаетОтсутствие())
        .ЭтоИстина();

    // Только с ДопускаетNull - НЕ допускает отсутствия
    ЮТест.ОжидаетЧто(Zod.Строки().ДопускаетNull().ДопускаетОтсутствие())
        .ЭтоЛожь();

    // С ДопускаетNull + Необязательное - допускает
    ЮТест.ОжидаетЧто(Zod.Строки().ДопускаетNull().Необязательное().ДопускаетОтсутствие())
        .ЭтоИстина();
КонецПроцедуры

Процедура ДопускаетНеопределено_НеобязательноеИлиNull() Экспорт
    // Без флагов - не допускает
    ЮТест.ОжидаетЧто(Zod.Строки().ДопускаетНеопределено()).ЭтоЛожь();

    // С Необязательное - допускает
    ЮТест.ОжидаетЧто(Zod.Строки().Необязательное().ДопускаетНеопределено())
        .ЭтоИстина();

    // С ДопускаетNull - допускает
    ЮТест.ОжидаетЧто(Zod.Строки().ДопускаетNull().ДопускаетНеопределено())
        .ЭтоИстина();
КонецПроцедуры

Процедура ЭтоНеобязательное_АлиасДопускаетОтсутствие() Экспорт
    // Старый метод должен работать как алиас
    Схема = Zod.Строки().Необязательное();
    ЮТест.ОжидаетЧто(Схема.ЭтоНеобязательное()).ЭтоИстина();
    ЮТест.ОжидаетЧто(Схема.ЭтоНеобязательное())
        .Равно(Схема.ДопускаетОтсутствие());
	КонецПроцедуры
