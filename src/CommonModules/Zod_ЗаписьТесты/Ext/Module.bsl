Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		.ДобавитьТест("ВалиднаяЗапись")
		.ДобавитьТест("НеверныйТип")
		.ДобавитьТест("ПроверкаКлючей")
		.ДобавитьТест("ОшибкиЗначений");
КонецПроцедуры

Процедура ВалиднаяЗапись() Экспорт
	Схема = Zod.Запись(Zod.Строки(), Zod.Числа());

	Данные = Новый Соответствие;
	Данные.Вставить("a", 1);
	Данные.Вставить("b", 2);

	Результат = Схема.Проверить(Данные);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Получить("a")).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Данные.Получить("b")).Равно(2);
КонецПроцедуры

Процедура НеверныйТип() Экспорт
	Схема = Zod.Запись(Zod.Строки(), Zod.Числа());

	Для Каждого Значение Из ЮТКоллекции.ЗначениеВМассиве(
			"не запись", 123, Новый Массив) Цикл

		ЮТест.ОжидаетЧто(Схема.Проверить(Значение).Успех).ЭтоЛожь();
	КонецЦикла;
КонецПроцедуры

Процедура ПроверкаКлючей() Экспорт
	// Ключи должны быть UUID-строками
	Схема = Zod.Запись(Zod.UUID(), Zod.Числа());

	Данные = Новый Соответствие;
	Данные.Вставить("not-a-uuid", 1);

	Результат = Схема.Проверить(Данные);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).БольшеИлиРавно(1);
КонецПроцедуры

Процедура ОшибкиЗначений() Экспорт
	Схема = Zod.Запись(Zod.Строки(), Zod.Числа().Положительное());

	Данные = Новый Соответствие;
	Данные.Вставить("a", 1);
	Данные.Вставить("b", -5); // ошибка

	Результат = Схема.Проверить(Данные);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Путь).Равно("b");
КонецПроцедуры
