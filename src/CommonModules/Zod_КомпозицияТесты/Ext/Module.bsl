////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - тесты композиции схем: Расширить/Объединить, И, Конвейер.
// Исполняемые сценарии для YaxUnit.
////////////////////////////////////////////////////////////////////////////////

Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		// Расширить / Объединить
		.ДобавитьТест("РасширитьДобавляетПоля")
		.ДобавитьТест("РасширитьПерезаписываетПоле")
		.ДобавитьТест("РасширитьИммутабельность")
		.ДобавитьТест("РасширитьСохраняетРежимСтрогий")
		.ДобавитьТест("РасширитьНеОбъектИсключение")
		.ДобавитьТест("РасширитьАргументНеОбъектИсключение")
		.ДобавитьТест("ОбъединитьЭквивалентноРасширить")
		// Пересечение (аналог .and())
		.ДобавитьТест("ПересечениеДвухОбъектныхСхемМержитПоля")
		.ДобавитьТест("ПересечениеПровалЛюбойСхемы")
		.ДобавитьТест("ПересечениеПримитивыОбеПроверки")
		.ДобавитьТест("ПересечениеЦепочкаРазворачиваетсяПлоско")
		.ДобавитьТест("ПересечениеСоСтрогойСхемойЛовитЛишнее")
		// Конвейер (pipe)
		.ДобавитьТест("КонвейерРезультатВоВторую")
		.ДобавитьТест("КонвейерОшибкаВПервойОстанавливает")
		.ДобавитьТест("КонвейерОшибкаВВторойВозвращает")
		.ДобавитьТест("КонвейерЦепочкаРазворачиваетсяПлоско")
		.ДобавитьТест("КонвейерСПриведениемТипа")
		// СоздатьПустой
		.ДобавитьТест("СоздатьПустойПересечение")
		.ДобавитьТест("СоздатьПустойКонвейер");
КонецПроцедуры

// ============ РАСШИРИТЬ / ОБЪЕДИНИТЬ ============

Процедура РасширитьДобавляетПоля() Экспорт
	Базовая = Zod.Объект()
		.Поле("a", Zod.Строки());
	Расширение = Zod.Объект()
		.Поле("b", Zod.Числа());

	Результат = Базовая.Расширить(Расширение);

	ЮТест.ОжидаетЧто(Результат.ПолучитьТип()).Равно("Объект");
	ЮТест.ОжидаетЧто(Результат.НайтиСхемуПоля("a")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Результат.НайтиСхемуПоля("b")).ЭтоНеНеопределено();

	// Валидация проходит по обоим полям
	ЮТест.ОжидаетЧто(Результат.Проверить(
		Новый Структура("a, b", "x", 1)).Успех).ЭтоИстина();
КонецПроцедуры

Процедура РасширитьПерезаписываетПоле() Экспорт
	Базовая = Zod.Объект()
		.Поле("x", Zod.Строки());
	Расширение = Zod.Объект()
		.Поле("x", Zod.Числа());

	Результат = Базовая.Расширить(Расширение);

	// Поле x теперь Число (перезаписано)
	ЮТест.ОжидаетЧто(Результат.Проверить(
		Новый Структура("x", 1)).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Проверить(
		Новый Структура("x", "abc")).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура РасширитьИммутабельность() Экспорт
	Базовая = Zod.Объект().Поле("a", Zod.Строки());
	Расширение = Zod.Объект().Поле("b", Zod.Числа());

	Результат = Базовая.Расширить(Расширение);

	// Базовая не изменилась
	ЮТест.ОжидаетЧто(Базовая.НайтиСхемуПоля("a")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Базовая.НайтиСхемуПоля("b")).ЭтоНеопределено();
	// Расширение не изменилось
	ЮТест.ОжидаетЧто(Расширение.НайтиСхемуПоля("a")).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Расширение.НайтиСхемуПоля("b")).ЭтоНеНеопределено();
КонецПроцедуры

Процедура РасширитьСохраняетРежимСтрогий() Экспорт
	Строгая = Zod.СтрогийОбъект().Поле("a", Zod.Строки());
	Обычная = Zod.Объект().Поле("b", Zod.Числа());

	Результат = Строгая.Расширить(Обычная);

	// Режим "Строгий" сохранился — лишнее поле даёт ошибку
	ЮТест.ОжидаетЧто(Результат.Проверить(
		Новый Структура("a, b, лишнее", "x", 1, 99)).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура РасширитьНеОбъектИсключение() Экспорт
	Выброшено = Ложь;
	Попытка
		Zod.Строки().Расширить(Zod.Объект());
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

Процедура РасширитьАргументНеОбъектИсключение() Экспорт
	Выброшено = Ложь;
	Попытка
		Zod.Объект().Расширить(Zod.Строки());
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

Процедура ОбъединитьЭквивалентноРасширить() Экспорт
	A = Zod.Объект().Поле("a", Zod.Строки());
	B = Zod.Объект().Поле("b", Zod.Числа());

	ЧерезРасширить = A.Расширить(B);
	ЧерезОбъединить = A.Объединить(B);

	ЮТест.ОжидаетЧто(ЧерезРасширить.НайтиСхемуПоля("a")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(ЧерезОбъединить.НайтиСхемуПоля("a")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(ЧерезРасширить.НайтиСхемуПоля("b")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(ЧерезОбъединить.НайтиСхемуПоля("b")).ЭтоНеНеопределено();
КонецПроцедуры

// ============ ПЕРЕСЕЧЕНИЕ ============

Процедура ПересечениеДвухОбъектныхСхемМержитПоля() Экспорт
	A = Zod.Объект().Поле("a", Zod.Строки());
	B = Zod.Объект().Поле("b", Zod.Числа());

	Схема = A.Пересечение(B);
	ЮТест.ОжидаетЧто(Схема.ПолучитьТип()).Равно("Пересечение");

	Результат = Схема.Проверить(Новый Структура("a, b", "x", 1));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	// Оба поля в результате (мерж)
	ЮТест.ОжидаетЧто(Результат.Данные.a).Равно("x");
	ЮТест.ОжидаетЧто(Результат.Данные.b).Равно(1);
КонецПроцедуры

Процедура ПересечениеПровалЛюбойСхемы() Экспорт
	A = Zod.Объект().Поле("a", Zod.Строки().Непустая());
	B = Zod.Объект().Поле("b", Zod.Числа().Целое());

	Схема = A.Пересечение(B);

	// Провал A (пустая строка)
	ЮТест.ОжидаетЧто(Схема.Проверить(
		Новый Структура("a, b", "", 1)).Успех).ЭтоЛожь();
	// Провал B (не целое)
	ЮТест.ОжидаетЧто(Схема.Проверить(
		Новый Структура("a, b", "x", 1.5)).Успех).ЭтоЛожь();
	// Обе ок
	ЮТест.ОжидаетЧто(Схема.Проверить(
		Новый Структура("a, b", "x", 1)).Успех).ЭтоИстина();
КонецПроцедуры

Процедура ПересечениеПримитивыОбеПроверки() Экспорт
	Схема = Zod.Строки().МинДлина(3).Пересечение(Zod.Строки().МаксДлина(5));

	ЮТест.ОжидаетЧто(Схема.Проверить("ab").Успех).ЭтоЛожь();     // < 3
	ЮТест.ОжидаетЧто(Схема.Проверить("abcdef").Успех).ЭтоЛожь(); // > 5
	ЮТест.ОжидаетЧто(Схема.Проверить("abcd").Успех).ЭтоИстина(); // 3..5
КонецПроцедуры

Процедура ПересечениеЦепочкаРазворачиваетсяПлоско() Экспорт
	A = Zod.Объект().Поле("a", Zod.Строки());
	B = Zod.Объект().Поле("b", Zod.Числа());
	C = Zod.Объект().Поле("c", Zod.Булевы());

	Схема = A.Пересечение(B).Пересечение(C);

	ЮТест.ОжидаетЧто(Схема.ПолучитьСхемыПересечения().Количество()).Равно(3);
КонецПроцедуры

Процедура ПересечениеСоСтрогойСхемойЛовитЛишнее() Экспорт
	Строгая = Zod.СтрогийОбъект().Поле("a", Zod.Строки());
	Обычная = Zod.Объект().Поле("b", Zod.Числа());

	Схема = Строгая.Пересечение(Обычная);

	// Строгая схема увидит "b" как лишнее — это ожидаемое поведение
	ЮТест.ОжидаетЧто(Схема.Проверить(
		Новый Структура("a, b", "x", 1)).Успех).ЭтоЛожь();
КонецПроцедуры

// ============ КОНВЕЙЕР (PIPE) ============

Процедура КонвейерРезультатВоВторую() Экспорт
	// Первая схема приводит к числу, вторая проверяет целочисленность
	Схема = Zod.ПриведенноеЧисло().Конвейер(Zod.Числа().Целое());

	ЮТест.ОжидаетЧто(Схема.Проверить("42").Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить("42").Данные).Равно(42);
	// Дробное число отсекается второй схемой
	ЮТест.ОжидаетЧто(Схема.Проверить("1.5").Успех).ЭтоЛожь();
КонецПроцедуры

Процедура КонвейерОшибкаВПервойОстанавливает() Экспорт
	Схема = Zod.Строки().Конвейер(Zod.Строки().Непустая());
	// Первая схема получит число — ошибка
	ЮТест.ОжидаетЧто(Схема.Проверить(123).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура КонвейерОшибкаВВторойВозвращает() Экспорт
	Схема = Zod.Строки().Конвейер(Zod.Строки().Непустая());
	// Первая схема ок, вторая — пустая строка
	ЮТест.ОжидаетЧто(Схема.Проверить("").Успех).ЭтоЛожь();
КонецПроцедуры

Процедура КонвейерЦепочкаРазворачиваетсяПлоско() Экспорт
	Схема = Zod.Любое()
		.Конвейер(Zod.ПриведеннаяСтрока())
		.Конвейер(Zod.Строки().Непустая())
		.Конвейер(Zod.Строки().МинДлина(2));

	ЮТест.ОжидаетЧто(Схема.ПолучитьСхемыКонвейера().Количество()).Равно(4);
	ЮТест.ОжидаетЧто(Схема.Проверить("abc").Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить("a").Успех).ЭтоЛожь();
КонецПроцедуры

Процедура КонвейерСПриведениемТипа() Экспорт
	// Типичный кейс: строка "true"/"false" → булево
	Схема = Zod.ПриведенноеБулево().Конвейер(Zod.Булевы());
	ЮТест.ОжидаетЧто(Схема.Проверить("true").Данные).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить("false").Данные).ЭтоЛожь();
КонецПроцедуры

// ============ СОЗДАТЬ ПУСТОЙ ============

Процедура СоздатьПустойПересечение() Экспорт
	A = Zod.Объект().Поле("a", Zod.Строки());
	B = Zod.Объект().Поле("b", Zod.Числа());
	Схема = A.Пересечение(B);

	Пустой = Схема.СоздатьПустой();
	// Пустое от первой схемы
	ЮТест.ОжидаетЧто(Пустой).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Пустой.Свойство("a")).ЭтоИстина();
КонецПроцедуры

Процедура СоздатьПустойКонвейер() Экспорт
	Схема = Zod.Строки().Конвейер(Zod.Строки().Непустая());
	Пустой = Схема.СоздатьПустой();
	// Пустое от первой схемы — пустая строка
	ЮТест.ОжидаетЧто(Пустой).Равно("");
КонецПроцедуры
