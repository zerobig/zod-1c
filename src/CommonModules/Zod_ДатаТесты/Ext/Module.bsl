Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		.ДобавитьТест("ВалиднаяДата")
		.ДобавитьТест("НеверныйТип")
		.ДобавитьТест("Приведение")
		.ДобавитьТест("Необязательное");
КонецПроцедуры

Процедура ВалиднаяДата() Экспорт
	Дата = Дата(2024, 1, 15, 12, 30, 0);
	Результат = Zod.Даты().Проверить(Дата);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные).Равно(Дата);
КонецПроцедуры

Процедура НеверныйТип() Экспорт
	Для Каждого Значение Из ЮТКоллекции.ЗначениеВМассиве(
			"2024-01-15", 123, Истина, Неопределено) Цикл

		ЮТест.ОжидаетЧто(Zod.Даты().Проверить(Значение).Успех).ЭтоЛожь();
	КонецЦикла;
КонецПроцедуры

Процедура Приведение() Экспорт
	Схема = Zod.ПриведеннаяДата();

	// Уже дата
	Дата = Дата(2024, 1, 15);
	ЮТест.ОжидаетЧто(Схема.Проверить(Дата).Данные).Равно(Дата);

	// Строка в формате 1С
	ЮТест.ОжидаетЧто(Схема.Проверить("20240115").Данные).Равно(Дата);

	// Неверная строка
	ЮТест.ОжидаетЧто(Схема.Проверить("not-a-date").Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить("20241301").Успех).ЭтоЛожь(); // 13-й месяц
КонецПроцедуры

Процедура Необязательное() Экспорт
	ЮТест.ОжидаетЧто(Zod.Даты().Необязательное().Проверить(Неопределено).Успех).ЭтоИстина();
КонецПроцедуры
