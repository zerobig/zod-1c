Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		.ДобавитьТест("ВалидныйМассив")
		.ДобавитьТест("НеверныйТип")
		.ДобавитьТест("МинЭлементов")
		.ДобавитьТест("МаксЭлементов")
		.ДобавитьТест("ПроверкаЭлементов")
		.ДобавитьТест("ОшибкиСИндексами")
		.ДобавитьТест("ПустойМассив");
КонецПроцедуры

Процедура ВалидныйМассив() Экспорт
	Схема = Zod.Массивы().Элемент(Zod.Числа());
	Результат = Схема.Проверить(ЮТКоллекции.ЗначениеВМассиве(1, 2, 3));

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Количество()).Равно(3);
КонецПроцедуры

Процедура НеверныйТип() Экспорт
	Схема = Zod.Массивы();

	Для Каждого Значение Из ЮТКоллекции.ЗначениеВМассиве(
			"не массив", 123, Новый Структура, Истина) Цикл

		ЮТест.ОжидаетЧто(Схема.Проверить(Значение).Успех).ЭтоЛожь();
	КонецЦикла;
КонецПроцедуры

Процедура МинЭлементов() Экспорт
	Схема = Zod.Массивы().МинЭлементов(2);

	ЮТест.ОжидаетЧто(Схема.Проверить(Новый Массив).Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить(ЮТКоллекции.ЗначениеВМассиве(1)).Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить(ЮТКоллекции.ЗначениеВМассиве(1, 2)).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(ЮТКоллекции.ЗначениеВМассиве(1, 2, 3)).Успех).ЭтоИстина();

	Результат = Zod.Массивы().МинЭлементов(2, "Мало элементов").Проверить(Новый Массив);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Мало элементов");
КонецПроцедуры

Процедура МаксЭлементов() Экспорт
	Схема = Zod.Массивы().МаксЭлементов(2);

	ЮТест.ОжидаетЧто(Схема.Проверить(ЮТКоллекции.ЗначениеВМассиве(1, 2)).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(ЮТКоллекции.ЗначениеВМассиве(1, 2, 3)).Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить(Новый Массив).Успех).ЭтоИстина();

	Результат = Zod.Массивы().МаксЭлементов(2, "Много элементов").Проверить(ЮТКоллекции.ЗначениеВМассиве(1, 2, 3));
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Много элементов");
КонецПроцедуры

Процедура ПроверкаЭлементов() Экспорт
	Схема = Zod.Массивы().Элемент(Zod.Числа().Целое().Положительное());

	ЮТест.ОжидаетЧто(Схема.Проверить(ЮТКоллекции.ЗначениеВМассиве(1, 2, 3)).Успех).ЭтоИстина();

	// Есть невалидные элементы
	ЮТест.ОжидаетЧто(Схема.Проверить(ЮТКоллекции.ЗначениеВМассиве(1, 0, 3)).Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить(ЮТКоллекции.ЗначениеВМассиве(1, 1.5, 3)).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ОшибкиСИндексами() Экспорт
	Схема = Zod.Массивы().Элемент(Zod.Строки().Непустая());

	Данные = ЮТКоллекции.ЗначениеВМассиве("ok", "", "ok");
	Результат = Схема.Проверить(Данные);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Путь).Равно("[1]");
КонецПроцедуры

Процедура ПустойМассив() Экспорт
	// Без ограничений - пустой массив допустим
	ЮТест.ОжидаетЧто(Zod.Массивы().Проверить(Новый Массив).Успех).ЭтоИстина();

	// С Элемент, но без МинЭлементов - пустой допустим
	ЮТест.ОжидаетЧто(Zod.Массивы().Элемент(Zod.Числа()).Проверить(Новый Массив).Успех).ЭтоИстина();
КонецПроцедуры
