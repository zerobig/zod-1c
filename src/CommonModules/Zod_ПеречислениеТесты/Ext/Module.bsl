Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		.ДобавитьТест("ДопустимоеЗначение")
		.ДобавитьТест("НедопустимоеЗначение")
		.ДобавитьТест("КастомнаяОшибка");
КонецПроцедуры

Процедура ДопустимоеЗначение() Экспорт
	Схема = Zod.Перечисление(ЮТКоллекции.ЗначениеВМассиве("red", "green", "blue"));

	ЮТест.ОжидаетЧто(Схема.Проверить("red").Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить("green").Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить("blue").Успех).ЭтоИстина();
КонецПроцедуры

Процедура НедопустимоеЗначение() Экспорт
	Схема = Zod.Перечисление(ЮТКоллекции.ЗначениеВМассиве("red", "green"));

	ЮТест.ОжидаетЧто(Схема.Проверить("yellow").Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить("").Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить(123).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура КастомнаяОшибка() Экспорт
	Схема = Zod.Перечисление(ЮТКоллекции.ЗначениеВМассиве("red"), "Только красный");
	Результат = Схема.Проверить("green");
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Только красный");
КонецПроцедуры
