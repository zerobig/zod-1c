Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТест("ВалидныйОбъект")
		.ДобавитьТест("НеверныйТип")
		.ДобавитьТест("ОбязательноеПоле")
		.ДобавитьТест("НеобязательноеПоле")
		.ДобавитьТест("РежимОбычный")
		.ДобавитьТест("РежимСтрогий")
		.ДобавитьТест("РежимСвободный")
		.ДобавитьТест("ВложенныеОшибки")
		.ДобавитьТест("ПустойОбъект")
		.ДобавитьТест("СоответствиеВозвращаетСоответствие")
		;

КонецПроцедуры

Процедура ВалидныйОбъект() Экспорт
	Схема = Zod.Объект()
		.Поле("Имя", Zod.Строки())
		.Поле("Возраст", Zod.Числа().Целое().Положительное());

	Данные = Новый Структура("Имя, Возраст", "Иван", 30);
	Результат = Схема.Проверить(Данные);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Имя).Равно("Иван");
	ЮТест.ОжидаетЧто(Результат.Данные.Возраст).Равно(30);
КонецПроцедуры

Процедура НеверныйТип() Экспорт
	Схема = Zod.Объект();

	Для Каждого Значение Из ЮТКоллекции.ЗначениеВМассиве(
			"строка", 123, Новый Массив, Истина) Цикл

		ЮТест.ОжидаетЧто(Схема.Проверить(Значение).Успех).ЭтоЛожь();
	КонецЦикла;

	// Соответствие - тоже допустимый объект
	ЮТест.ОжидаетЧто(Схема.Проверить(Новый Соответствие).Успех).ЭтоИстина();
КонецПроцедуры

Процедура ОбязательноеПоле() Экспорт
	Схема = Zod.Объект()
		.Поле("Имя", Zod.Строки())
		.Поле("Возраст", Zod.Числа());

	// Поле отсутствует
	Результат = Схема.Проверить(Новый Структура("Возраст", 30));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Путь).Равно("Имя");
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Содержит("Обязательное поле");

	// Поле присутствует, но значение Неопределено
	Результат = Схема.Проверить(Новый Структура("Имя, Возраст", Неопределено, 30));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Путь).Равно("Имя");
КонецПроцедуры

Процедура НеобязательноеПоле() Экспорт
	Схема = Zod.Объект()
		.Поле("Имя", Zod.Строки())
		.Поле("Комментарий", Zod.Строки().Необязательное());

	// Без необязательного поля - ок
	Результат = Схема.Проверить(Новый Структура("Имя", "Иван"));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Свойство("Комментарий")).ЭтоЛожь(); // не вставлено

	// С необязательным полем - ок
	Результат = Схема.Проверить(Новый Структура("Имя, Комментарий", "Иван", "Заметка"));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Комментарий).Равно("Заметка");
КонецПроцедуры

Процедура РежимОбычный() Экспорт
	Схема = Zod.Объект()
		.Поле("Имя", Zod.Строки());

	Данные = Новый Структура("Имя, Лишнее", "Иван", "Удалить");
	Результат = Схема.Проверить(Данные);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Свойство("Лишнее")).ЭтоЛожь(); // отброшено
КонецПроцедуры

Процедура РежимСтрогий() Экспорт
	Схема = Zod.СтрогийОбъект()
		.Поле("Имя", Zod.Строки());

	Данные = Новый Структура("Имя, Лишнее", "Иван", "Удалить");
	Результат = Схема.Проверить(Данные);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Путь).Равно("Лишнее");
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Неизвестное поле");
КонецПроцедуры

Процедура РежимСвободный() Экспорт
	Схема = Zod.СвободныйОбъект()
		.Поле("Имя", Zod.Строки());

	Данные = Новый Структура("Имя, Лишнее", "Иван", "Оставить");
	Результат = Схема.Проверить(Данные);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Лишнее).Равно("Оставить"); // сохранено
КонецПроцедуры

Процедура ВложенныеОшибки() Экспорт
	Схема = Zod.Объект()
		.Поле("Пользователь", Zod.Объект()
			.Поле("Имя", Zod.Строки().Непустая())
			.Поле("Возраст", Zod.Числа().МинЗначение(18)));

	Данные = Новый Структура("Пользователь", Новый Структура("Имя, Возраст", "", 15));
	Результат = Схема.Проверить(Данные);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(2);

	Пути = Новый Массив;
	Для Каждого Ош Из Результат.Ошибки Цикл
		Пути.Добавить(Ош.Путь);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Пути).Содержит("Пользователь.Имя");
	ЮТест.ОжидаетЧто(Пути).Содержит("Пользователь.Возраст");
КонецПроцедуры

Процедура ПустойОбъект() Экспорт
	// Объект без полей - принимает любую структуру (и отбрасывает всё)
	Схема = Zod.Объект();
	Результат = Схема.Проверить(Новый Структура("Любое", 123));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Свойство("Любое")).ЭтоЛожь();
КонецПроцедуры

Процедура СоответствиеВозвращаетСоответствие() Экспорт
	// Проверяем, что ПроверитьОбъект сохраняет тип входных данных
	Схема = Zod.Объект()
		.Поле("name", Zod.Строки())
		.Поле("age", Zod.Числа().Целое());

	Входные = Новый Соответствие;
	Входные.Вставить("name", "Иван");
	Входные.Вставить("age", 30);

	Результат = Схема.Проверить(Входные);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.Данные)).Равно(Тип("Соответствие"));
	ЮТест.ОжидаетЧто(Результат.Данные.Получить("name")).Равно("Иван");
КонецПроцедуры
