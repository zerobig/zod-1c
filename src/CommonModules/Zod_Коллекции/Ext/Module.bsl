////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - утилиты для работы с коллекциями 1С.
// Общий модуль. Сервер, вызов сервера.
//
// Универсальные функции для Структуры, Соответствия, Массива.
// Используются ядром и плагинами ZodX.
//
// Ключевой момент: Соответствие в 1С не различает «ключа нет» и
// «значение Неопределено» через Получить(). Все функции здесь это
// учитывают и работают корректно.
////////////////////////////////////////////////////////////////////////////////

// Проверяет наличие ключа в Структуре или Соответствии.
//
// Для Структуры - прямой вызов Свойство().
// Для Соответствия - обход (Получить() не различает «нет ключа» и
// «значение Неопределено»).
Функция ЕстьКлюч(Коллекция, Ключ) Экспорт
	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Возврат Коллекция.Свойство(Ключ);
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Для Каждого КЗ Из Коллекция Цикл
			Если КЗ.Ключ = Ключ Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;
	ВызватьИсключение "zod-1c: Коллекции.ЕстьКлюч() - ожидается Структура или Соответствие";
КонецФункции

// Ищет значение по ключу в Структуре или Соответствии.
//
// Возвращает Структура("Найдено, Значение"):
//   Найдено = Ложь,   Значение = Неопределено - ключа нет;
//   Найдено = Истина, Значение = Неопределено - ключ есть, значение Неопределено;
//   Найдено = Истина, Значение = X - ключ есть, значение X.
//
// Имя НайтиЗначение, а не Найти: последнее платформа не принимает
// как имя метода.
Функция НайтиЗначение(Коллекция, Ключ) Экспорт
	Результат = Новый Структура("Найдено, Значение", Ложь, Неопределено);
	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Коллекция.Свойство(Ключ, Значение) Тогда
			Результат.Найдено = Истина;
			Результат.Значение = Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Для Каждого КЗ Из Коллекция Цикл
			Если КЗ.Ключ = Ключ Тогда
				Результат.Найдено = Истина;
				Результат.Значение = КЗ.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ВызватьИсключение "zod-1c: Коллекции.НайтиЗначение() - ожидается Структура или Соответствие";
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Возвращает shallow-копию коллекции того же типа.
Функция Скопировать(Источник) Экспорт
	Если ТипЗнч(Источник) = Тип("Структура") Тогда
		Результат = Новый Структура;
	ИначеЕсли ТипЗнч(Источник) = Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
	Иначе
		ВызватьИсключение "zod-1c: Коллекции.Скопировать() - ожидается Структура или Соответствие";
	КонецЕсли;
	Для Каждого КЗ Из Источник Цикл
		Результат.Вставить(КЗ.Ключ, КЗ.Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает множество ключей коллекции: Соответствие {Ключ → Истина}.
Функция КлючиВМножество(Коллекция) Экспорт
	Результат = Новый Соответствие;
	Для Каждого КЗ Из Коллекция Цикл
		Результат.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции
