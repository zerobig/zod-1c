Процедура ПроверкаВернулаНеопределено() Экспорт
	// Проверка не применима - пропускаем, ошибки нет
	Рез = Zod.Строки().Проверка(НоваяПроверка(Неопределено)).Проверить("abc");
	ЮТест.ОжидаетЧто(Рез.Успех).ЭтоИстина();
КонецПроцедуры

Процедура НесколькоПроверок() Экспорт
	Схема = Zod.Строки()
		.Проверка(НоваяПроверка(Истина))
		.Проверка(НоваяПроверка(Ложь))
		.Проверка(НоваяПроверка("Третья"));

	Рез = Схема.Проверить("abc");
	ЮТест.ОжидаетЧто(Рез.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Рез.Ошибки.Количество()).Равно(2); // от 2-й и 3-й
	ЮТест.ОжидаетЧто(Рез.Ошибки[0].Сообщение).Равно("Пользовательская проверка не пройдена");
	ЮТест.ОжидаетЧто(Рез.Ошибки[1].Сообщение).Равно("Третья");
КонецПроцедуры

Процедура КастомноеСообщениеПроверки() Экспорт
	Рез = Zod.Строки()
		.Проверка(НоваяПроверка(Ложь), "Своё сообщение")
		.Проверить("abc");
	ЮТест.ОжидаетЧто(Рез.Ошибки[0].Сообщение).Равно("Своё сообщение");
КонецПроцедуры

Процедура НеПрименяетсяПриБазовойОшибке() Экспорт
	Проверка = НоваяПроверка(Истина);
	Схема = Zod.Строки().МинДлина(5).Проверка(Проверка);

	Рез = Схема.Проверить("ab"); // 2 < 5
	ЮТест.ОжидаетЧто(Рез.Успех).ЭтоЛожь();
	// Проверка не должна была вызываться
	ЮТест.ОжидаетЧто(Проверка.ПолучитьКоличествоВызовов()).Равно(0);
КонецПроцедуры

Процедура ПрименяетсяКПриведенному() Экспорт
	// Приведение + проверка: проверка получает уже приведённое значение
	Проверка = НоваяПроверка(Истина);
	Схема = Zod.ПриведеннаяСтрока().Проверка(Проверка);

	Схема.Проверить(123);
	Вызванные = Проверка.ПолучитьВызванныеЗначения();
	ЮТест.ОжидаетЧто(Вызванные[0]).Равно("123");
КонецПроцедуры

Процедура НаОбъекте() Экспорт
	Проверка = НоваяПроверка(Истина);
	Схема = Zod.Объект()
		.Поле("Имя", Zod.Строки())
		.Проверка(Проверка);

	Рез = Схема.Проверить(Новый Структура("Имя", "Иван"));
	ЮТест.ОжидаетЧто(Рез.Успех).ЭтоИстина();
	// Проверка получила Структуру с проверенными полями
	Вызванные = Проверка.ПолучитьВызванныеЗначения();
	ЮТест.ОжидаетЧто(ТипЗнч(Вызванные[0])).Равно(Тип("Структура"));
	ЮТест.ОжидаетЧто(Вызванные[0].Имя).Равно("Иван");
КонецПроцедуры

Процедура НаМассиве() Экспорт
	// Проверка на массиве: например, что сумма элементов > 100
	Схема = Zod.Массивы().Элемент(Zod.Числа())
		.Проверка(НоваяПроверка("Сумма слишком мала"));

	Рез = Схема.Проверить(ЮТКоллекции.ЗначениеВМассиве(1, 2, 3));
	ЮТест.ОжидаетЧто(Рез.Успех).ЭтоЛожь();
КонецПроцедуры

Процедура TopLevel() Экспорт
	// Zod.Проверка() как самостоятельная схема
	Рез = Zod.Проверка(НоваяПроверка(Истина)).Проверить("что угодно");
	ЮТест.ОжидаетЧто(Рез.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Рез.Данные).Равно("что угодно");
КонецПроцедуры

Процедура ПроверкаНаНеопределено() Экспорт
	// Обязательное значение Неопределено - базовая ошибка, проверка не вызывается
	Проверка = НоваяПроверка(Истина);
	Рез = Zod.Строки().Проверка(Проверка).Проверить(Неопределено);
	ЮТест.ОжидаетЧто(Рез.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Проверка.ПолучитьКоличествоВызовов()).Равно(0);
КонецПроцедуры

Процедура НедопустимыйТипРезультата() Экспорт
	// Проверка вернула число - это недопустимо
	Схема = Zod.Строки().Проверка(НоваяПроверка(42));
	Ошибка = Неопределено;
	Попытка
		Схема.Проверить("abc");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	ЮТест.ОжидаетЧто(Ошибка).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ПодробноеПредставлениеОшибки(Ошибка)).Содержит("недопустимый тип");
КонецПроцедуры

Процедура ОшибкаВПроверке() Экспорт
	// Объект проверки без метода Проверить - исключение с понятным сообщением
	Схема = Zod.Строки().Проверка(Новый Структура("Имя", "не_проверка"));
	Ошибка = Неопределено;
	Попытка
		Схема.Проверить("abc");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	ЮТест.ОжидаетЧто(Ошибка).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ПодробноеПредставлениеОшибки(Ошибка)).Содержит("ошибка в пользовательской проверке");
КонецПроцедуры

