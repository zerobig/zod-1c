Функция НоваяПроверка(Результат)
	Проверка = Обработки.Zod_Тест_Проверка.Создать();
	Проверка.УстановитьРезультат(Результат);
	Возврат Проверка;
КонецФункции

Процедура ПроверкаВернулаИстина() Экспорт
	Рез = Zod.Строки().Проверка(НоваяПроверка(Истина)).Проверить("abc");
	ЮТест.ОжидаетЧто(Рез.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Рез.Данные).Равно("abc");
КонецПроцедуры

Процедура ПроверкаВернулаЛожь() Экспорт
	Рез = Zod.Строки().Проверка(НоваяПроверка(Ложь)).Проверить("abc");
	ЮТест.ОжидаетЧто(Рез.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Рез.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Рез.Ошибки[0].Сообщение).Равно("Пользовательская проверка не пройдена");
КонецПроцедуры

