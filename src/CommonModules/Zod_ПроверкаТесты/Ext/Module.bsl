Процедура ПроверкаВернулаСтруктуруНевалидно() Экспорт
	Ответ = Новый Структура("Валидно, Сообщение", Ложь, "Кастомное сообщение");
	Рез = Zod.Строки().Проверка(НоваяПроверка(Ответ)).Проверить("abc");
	ЮТест.ОжидаетЧто(Рез.Успех).ЭтоЛожь();
