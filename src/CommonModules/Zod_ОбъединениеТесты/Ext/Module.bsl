Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		.ДобавитьТест("ПервыйВариант")
		.ДобавитьТест("ВторойВариант")
		.ДобавитьТест("НиОдинНеПодходит")
		.ДобавитьТест("ПорядокВариантов");
КонецПроцедуры

Процедура ПервыйВариант() Экспорт
	Схема = Zod.Объединение(ЮТКоллекции.ЗначениеВМассиве(
				Zod.Строки(),
				Zod.Числа()
			));

	ЮТест.ОжидаетЧто(Схема.Проверить("текст").Успех).ЭтоИстина();
КонецПроцедуры

Процедура ВторойВариант() Экспорт
	Схема = Zod.Объединение(ЮТКоллекции.ЗначениеВМассиве(
				Zod.Строки(),
				Zod.Числа()
			));

	ЮТест.ОжидаетЧто(Схема.Проверить(123).Успех).ЭтоИстина();
КонецПроцедуры

Процедура НиОдинНеПодходит() Экспорт
	Схема = Zod.Объединение(ЮТКоллекции.ЗначениеВМассиве(
				Zod.Строки(),
				Zod.Числа()
			));

	ЮТест.ОжидаетЧто(Схема.Проверить(Истина).Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить(Новый Структура).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ПорядокВариантов() Экспорт
	// Первый подходящий вариант выигрывает
	Схема = Zod.Объединение(ЮТКоллекции.ЗначениеВМассиве(
				Zod.Строки().МинДлина(5),
				Zod.Строки() // без ограничений
			));

	Результат = Схема.Проверить("abc"); // не подходит под первый (3 < 5), подходит под второй
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
КонецПроцедуры
