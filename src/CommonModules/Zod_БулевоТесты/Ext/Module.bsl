Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТест("ВалидноеБулево")
		.ДобавитьТест("НеверныйТип")
		.ДобавитьТест("Приведение")
		.ДобавитьТест("Необязательное")
		;

КонецПроцедуры

Процедура ВалидноеБулево() Экспорт
	ЮТест.ОжидаетЧто(Zod.Булевы().Проверить(Истина).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Zod.Булевы().Проверить(Ложь).Успех).ЭтоИстина();
КонецПроцедуры

Процедура НеверныйТип() Экспорт

	// 1. Обязательное поле с Неопределено → "Обязательное значение"
	Результат = Zod.Булевы().Проверить(Неопределено);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Обязательное значение");

	// 2. Остальные значения → "Ожидалось булево"
	Для Каждого Значение Из ЮТКоллекции.ЗначениеВМассиве(
			"true", 1, 0, Новый Структура) Цикл

		Результат = Zod.Булевы().Проверить(Значение);
		ЮТест.ОжидаетЧто(Результат.Успех, "Значение: " + Строка(Значение)).ЭтоЛожь();
		ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
		ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Ожидалось булево");
	КонецЦикла;

КонецПроцедуры

Процедура Приведение() Экспорт
	Схема = Zod.ПриведенноеБулево();

	// Строковые представления
	ЮТест.ОжидаетЧто(Схема.Проверить("true").Данные).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить("TRUE").Данные).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить("1").Данные).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить("да").Данные).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить("ДА").Данные).ЭтоИстина();

	ЮТест.ОжидаетЧто(Схема.Проверить("false").Данные).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить("FALSE").Данные).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить("0").Данные).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить("нет").Данные).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить("НЕТ").Данные).ЭтоЛожь();

	// Числа
	ЮТест.ОжидаетЧто(Схема.Проверить(1).Данные).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(0).Данные).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить(-1).Данные).ЭтоИстина();

	// Уже булево
	ЮТест.ОжидаетЧто(Схема.Проверить(Истина).Данные).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(Ложь).Данные).ЭтоЛожь();

	// Неприводимое
	ЮТест.ОжидаетЧто(Схема.Проверить("abc").Успех).ЭтоЛожь();
КонецПроцедуры

Процедура Необязательное() Экспорт
	ЮТест.ОжидаетЧто(Zod.Булевы().Необязательное().Проверить(Неопределено).Успех).ЭтоИстина();
КонецПроцедуры
