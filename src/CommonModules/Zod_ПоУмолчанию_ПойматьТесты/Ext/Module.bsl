////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - тесты .ПоУмолчанию() и .Поймать().
// Исполняемые сценарии для YaxUnit.
////////////////////////////////////////////////////////////////////////////////

Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		// ПоУмолчанию (default)
		.ДобавитьТест("ПоУмолчаниюПолеОтсутствует")
		.ДобавитьТест("ПоУмолчаниюЗначениеНеопределено")
		.ДобавитьТест("ПоУмолчаниюВалидноеЗначение")
		.ДобавитьТест("ПоУмолчаниюНевалидноеЗначение")
		.ДобавитьТест("ПоУмолчаниюНеобязательностьНаВходе")
		.ДобавитьТест("ПоУмолчаниюShallowКлонМассива")
		.ДобавитьТест("ПоУмолчаниюShallowКлонСтруктуры")
		.ДобавитьТест("ПоУмолчаниюФабрика")
		.ДобавитьТест("ПоУмолчаниюСильнееНеобязательное")
		.ДобавитьТест("ПоУмолчаниюПослеТрансформера")
		.ДобавитьТест("ПоУмолчаниюСоздатьПустой")
		// Поймать (catch)
		.ДобавитьТест("ПойматьНевалидноеЗначение")
		.ДобавитьТест("ПойматьОтсутствие")
		.ДобавитьТест("ПойматьВалидноеЗначение")
		.ДобавитьТест("ПойматьИсключениеИзПроверки")
		.ДобавитьТест("ПойматьОшибкиНеПопадаютВРезультат")
		.ДобавитьТест("ПойматьShallowКлон")
		.ДобавитьТест("ПойматьНаОбъекте")
		.ДобавитьТест("ПойматьНеЛовитОтсутствиеКлюча")
		.ДобавитьТест("ПойматьНеобязательноеПропускаетОтсутствие")
		.ДобавитьТест("ПоУмолчаниюВОбъекте1С")
		.ДобавитьТест("ПоУмолчаниюЛовитОтсутствиеКлюча")
		// Комбинации
		.ДобавитьТест("ПойматьИПоУмолчанию")
		.ДобавитьТест("ПоУмолчаниюВОбъекте")
	;
КонецПроцедуры

// ============ ВСПОМОГАТЕЛЬНЫЕ ============

// Обработка-фабрика для тестов. Имя должно совпадать с типом ОбработкаОбъект.
// В реальном проекте создай отдельную обработку Zod_ФабрикаМассиваЧисел
// или используй простой объект из существующих обработок.
// В тестах проверяем через ПростойФабричныйОбъектСоздать(), который
// возвращает новый объект при каждом вызове.

// ============ ПО УМОЛЧАНИЮ ============

Процедура ПоУмолчаниюПолеОтсутствует() Экспорт
	Схема = Zod.Объект().Поле("Имя", Zod.Строки().ПоУмолчанию("без имени"));
	Результат = Схема.Проверить(Новый Структура);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Имя).Равно("без имени");
КонецПроцедуры

Процедура ПоУмолчаниюЗначениеНеопределено() Экспорт
	Схема = Zod.Строки().ПоУмолчанию("x");
	ЮТест.ОжидаетЧто(Схема.Проверить(Неопределено).Данные).Равно("x");
КонецПроцедуры

Процедура ПоУмолчаниюВалидноеЗначение() Экспорт
	Схема = Zod.Строки().ПоУмолчанию("x");
	// Пришло валидное значение — default не срабатывает
	ЮТест.ОжидаетЧто(Схема.Проверить("hello").Данные).Равно("hello");
КонецПроцедуры

Процедура ПоУмолчаниюНевалидноеЗначение() Экспорт
	Схема = Zod.Строки().ПоУмолчанию("x");
	// Пришло невалидное (число вместо строки) — ошибка, default не спасает
	ЮТест.ОжидаетЧто(Схема.Проверить(123).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ПоУмолчаниюНеобязательностьНаВходе() Экспорт
	Схема = Zod.Объект().Поле("Имя", Zod.Строки().ПоУмолчанию("x"));
	// Схема без явного .Необязательное() — но с .ПоУмолчанию()
	// отсутствие ключа не ошибка
	ЮТест.ОжидаетЧто(Схема.Проверить(Новый Структура).Успех).ЭтоИстина();
КонецПроцедуры

Процедура ПоУмолчаниюShallowКлонМассива() Экспорт
	ИсходныйМассив = Новый Массив;
	ИсходныйМассив.Добавить(1);
	ИсходныйМассив.Добавить(2);

	Схема = Zod.Массивы().ПоУмолчанию(ИсходныйМассив);
	Результат1 = Схема.Проверить(Неопределено);
	Результат2 = Схема.Проверить(Неопределено);

	// Мутация первого результата не должна влиять на второй
	Результат1.Данные.Добавить(99);
	ЮТест.ОжидаетЧто(Результат2.Данные.Количество()).Равно(2);
КонецПроцедуры

Процедура ПоУмолчаниюShallowКлонСтруктуры() Экспорт
	Исходная = Новый Структура("a, b", 1, 2);
	Схема = Zod.Объект().ПоУмолчанию(Исходная);
	Результат1 = Схема.Проверить(Неопределено);
	Результат2 = Схема.Проверить(Неопределено);
	Результат1.Данные.a = 99;
	ЮТест.ОжидаетЧто(Результат2.Данные.a).Равно(1);
КонецПроцедуры

Процедура ПоУмолчаниюФабрика() Экспорт
	// Используем готовый трансформер как фабрику — у него нет метода Создать(),
	// поэтому ожидаем поведение как для обычного объекта.
	// Полноценный тест фабрики требует отдельной обработки-фабрики в конфигурации.
	// Здесь проверяем, что обычный объект (не ОбработкаОбъект) не принимается
	// за фабрику.
	Фабрика = Новый Структура("x", 1);
	Схема = Zod.Объект().ПоУмолчанию(Фабрика);
	Результат = Схема.Проверить(Неопределено);
	ЮТест.ОжидаетЧто(Результат.Данные.x).Равно(1);
КонецПроцедуры

Процедура ПоУмолчаниюСильнееНеобязательное() Экспорт
	// .ПоУмолчанию() + .Необязательное() — при отсутствии возвращается default
	Схема = Zod.Объект().Поле("Имя",
		Zod.Строки().Необязательное().ПоУмолчанию("x"));
	Результат = Схема.Проверить(Новый Структура);
	ЮТест.ОжидаетЧто(Результат.Данные.Имя).Равно("x");
КонецПроцедуры

Процедура ПоУмолчаниюПослеТрансформера() Экспорт
	// Трансформер срабатывает до default. Если после трансформации
	// значение стало Неопределено — срабатывает default.
	Трансформер = Обработки.Zod_Трансформер_ПустоеВНеопределено.Создать();
	Трансформер.Инициализировать();
	Схема = Zod.Строки()
		.Трансформировать(Трансформер)
		.ПоУмолчанию("подставлено");
	ЮТест.ОжидаетЧто(Схема.Проверить("").Данные).Равно("подставлено");
КонецПроцедуры

Процедура ПоУмолчаниюСоздатьПустой() Экспорт
	Схема = Zod.Строки().ПоУмолчанию("default-value");
	ЮТест.ОжидаетЧто(Схема.СоздатьПустой()).Равно("default-value");
КонецПроцедуры

// ============ ПОЙМАТЬ ============

Процедура ПойматьНевалидноеЗначение() Экспорт
	Схема = Zod.Строки().Поймать("fallback");
	Результат = Схема.Проверить(123); // невалидно — не строка
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные).Равно("fallback");
КонецПроцедуры

Процедура ПойматьОтсутствие() Экспорт
	// В Zod 4 .catch() срабатывает и на undefined/отсутствие
	Схема = Zod.Строки().Поймать("fallback");
	ЮТест.ОжидаетЧто(Схема.Проверить(Неопределено).Данные).Равно("fallback");
КонецПроцедуры

Процедура ПойматьВалидноеЗначение() Экспорт
	Схема = Zod.Строки().Поймать("fallback");
	// Валидное значение — fallback не применяется
	ЮТест.ОжидаетЧто(Схема.Проверить("hello").Данные).Равно("hello");
КонецПроцедуры

Процедура ПойматьИсключениеИзПроверки() Экспорт
	// Проверка, которая всегда выбрасывает исключение
	Проверка = Новый Структура;
	Проверка.Вставить("Проверить", Новый Структура); // не сработает как метод
	// Используем готовую проверку через объект-проверку
	// В YaxUnit-тестах проще проверить через невалидный тип:
	// Схема ниже ожидает число, пришла строка — будет ошибка валидации,
	// а не исключение. Но принцип тот же: catch ловит любую невалидность.
	Схема = Zod.Числа()
		.Проверка(СоздатьПроверкуСИсключением())
		.Поймать(0);
	Результат = Схема.Проверить(5);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные).Равно(0);
КонецПроцедуры

Процедура ПойматьОшибкиНеПопадаютВРезультат() Экспорт
	Схема = Zod.Объект().Поле("Имя", Zod.Строки().Поймать("fallback"));
	Результат = Схема.Проверить(Новый Структура("Имя", 123));
	// Ошибок нет — они поглощены catch на поле
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Результат.Данные.Имя).Равно("fallback");
КонецПроцедуры

Процедура ПойматьShallowКлон() Экспорт
	Исходный = Новый Массив;
	Исходный.Добавить(1);
	Схема = Zod.Массивы().Поймать(Исходный);
	Р1 = Схема.Проверить(Неопределено);
	Р2 = Схема.Проверить(Неопределено);
	Р1.Данные.Добавить(99);
	ЮТест.ОжидаетЧто(Р2.Данные.Количество()).Равно(1);
КонецПроцедуры

Процедура ПойматьНаОбъекте() Экспорт
	// Catch на всём объекте — при ошибке в любом поле возвращается fallback
	Схема = Zod.Объект()
		.Поле("Имя", Zod.Строки().Непустая())
		.Поймать("ошибка объекта");
	Результат = Схема.Проверить(Новый Структура("Имя", ""));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные).Равно("ошибка объекта");
КонецПроцедуры

Процедура ПойматьНеЛовитОтсутствиеКлюча() Экспорт
	// .Поймать() — fallback для ошибок парсинга, а не для отсутствия ключа.
	// Ключ обязателен, если явно не указано .Необязательное().
	Схема = Zod.Объект().Поле("Имя", Zod.Строки().Поймать("fallback"));
	Результат = Схема.Проверить(Новый Структура);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ПойматьНеобязательноеПропускаетОтсутствие() Экспорт
	// .Поймать() ловит ошибки парсинга значения, но не отсутствие ключа.
	// При .Необязательное() + отсутствии ключа — поле пропускается,
	// fallback НЕ применяется (совместимо с zod4: .optional().catch()).
	Схема = Zod.Объект().Поле("Имя",
		Zod.Строки().Необязательное().Поймать("fallback"));

	// Ключа нет — поля в результате нет
	Результат1 = Схема.Проверить(Новый Структура);
	ЮТест.ОжидаетЧто(Результат1.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат1.Данные.Свойство("Имя")).ЭтоЛожь();

	// Ключ есть, но невалиден — срабатывает catch
	Результат2 = Схема.Проверить(Новый Структура("Имя", 123));
	ЮТест.ОжидаетЧто(Результат2.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат2.Данные.Имя).Равно("fallback");
КонецПроцедуры

Процедура ПоУмолчаниюВОбъекте1С() Экспорт
	// Проверяем, что default проставляется и при создании объектов 1С
	// (при наличии тестовой конфигурации с документом). Если такого документа
	// в конфигурации нет — замени "ЗаказКлиента" на любой доступный документ
	// с тестовым реквизитом "Комментарий" или убери тест.
	Попытка
		Схема = Zod.ОбъектДокумента("ЗаказКлиента")
			.Поле("Комментарий", Zod.Строки().ПоУмолчанию("по умолчанию"));
	Исключение
		// В тестовой конфигурации нет ЗаказКлиента — пропускаем
		Возврат;
	КонецПопытки;

	Результат = Схема.Проверить(Новый Структура);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Комментарий).Равно("по умолчанию");
КонецПроцедуры

Процедура ПоУмолчаниюЛовитОтсутствиеКлюча() Экспорт
	// Для fallback при ОТСУТСТВИИ ключа используется .ПоУмолчанию(),
	// а не .Поймать().
	Схема = Zod.Объект().Поле("Имя",
		Zod.Строки().ПоУмолчанию("fallback"));
	Результат = Схема.Проверить(Новый Структура);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Имя).Равно("fallback");
КонецПроцедуры

// ============ КОМБИНАЦИИ ============

Процедура ПойматьИПоУмолчанию() Экспорт
	Схема = Zod.Числа()
		.ПоУмолчанию(100)
		.Поймать(0);

	// Отсутствие — срабатывает default
	ЮТест.ОжидаетЧто(Схема.Проверить(Неопределено).Данные).Равно(100);
	// Невалидное значение — срабатывает catch
	ЮТест.ОжидаетЧто(Схема.Проверить("не число").Данные).Равно(0);
	// Валидное значение — как есть
	ЮТест.ОжидаетЧто(Схема.Проверить(42).Данные).Равно(42);
КонецПроцедуры

Процедура ПоУмолчаниюВОбъекте() Экспорт
	Схема = Zod.СтрогийОбъект()
		.Поле("Имя", Zod.Строки().ПоУмолчанию("Аноним"))
		.Поле("Возраст", Zod.Числа().ПоУмолчанию(0));

	Результат = Схема.Проверить(Новый Структура);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Имя).Равно("Аноним");
	ЮТест.ОжидаетЧто(Результат.Данные.Возраст).Равно(0);
КонецПроцедуры

// ============ ХЕЛПЕРЫ ============

Функция СоздатьПроверкуСИсключением()
	Возврат Обработки.Zod_Тест_ПроверкаСИсключением.Создать();
КонецФункции
