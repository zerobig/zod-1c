Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		// Адаптер
		.ДобавитьТест("АдаптерВызываетМетод")
		.ДобавитьТест("АдаптерПередаётПараметры")
		.ДобавитьТест("АдаптерПараметрыПоУмолчанию")
		.ДобавитьТест("АдаптерСМенеджером")
		.ДобавитьТест("АдаптерСОбъектом")
		.ДобавитьТест("АдаптерМетодНеНайден")
		.ДобавитьТест("АдаптерВалидацияИмениМетода")
		.ДобавитьТест("АдаптерОбъектНеопределено")
		.ДобавитьТест("АдаптерЭтоВалидныйИдентификатор")
		// Интеграция
		.ДобавитьТест("ИнтеграцияСТрансформировать")
		.ДобавитьТест("ОбаСпособаРаботают")
		.ДобавитьТест("ТрансформерСТипомБазыЛюбое")
		// Zod_Трансформеры
		.ДобавитьТест("UnixTimestampСекунды")
		.ДобавитьТест("UnixTimestampМиллисекунды")
		.ДобавитьТест("СтатусИзСтрокиВалидное")
		.ДобавитьТест("СтатусИзСтрокиНевалидное")
		.ДобавитьТест("ЧислоИзИдентификатора")
