		.ДобавитьТест("ТрансформерСПоймать");
КонецПроцедуры

// ============ АДАПТЕР ============

Процедура АдаптерВызываетМетод() Экспорт
	Трансформер = Zod.Трансформер(Обработки.Zod_Трансформеры, "ЧислоИзИдентификатора");
	ЮТест.ОжидаетЧто(Трансформер.Преобразовать("id-12345")).Равно(12345);
КонецПроцедуры

Процедура АдаптерПередаётПараметры() Экспорт
	Карта = Новый Соответствие;
	Карта.Вставить("new", "Новый");

	Трансформер = Zod.Трансформер(Обработки.Zod_Трансформеры, "СтатусИзСтроки",
		Новый Структура("Карта", Карта));
	ЮТест.ОжидаетЧто(Трансформер.Преобразовать("new")).Равно("Новый");
КонецПроцедуры

Процедура АдаптерПараметрыПоУмолчанию() Экспорт
	// Параметры не переданы - метод получает Неопределено
	Трансформер = Zod.Трансформер(Обработки.Zod_Трансформеры, "UnixTimestamp");
	Результат = Трансформер.Преобразовать(0);
	ЮТест.ОжидаетЧто(ТипЗнч(Результат)).Равно(Тип("Дата"));
КонецПроцедуры

Процедура АдаптерСМенеджером() Экспорт
	// Передаём менеджер обработки - статический вызов метода
	Трансформер = Zod.Трансформер(Обработки.Zod_Трансформеры, "ЧислоИзИдентификатора");
	ЮТест.ОжидаетЧто(Трансформер.Преобразовать("abc-42")).Равно(42);
КонецПроцедуры

Процедура АдаптерСОбъектом() Экспорт
	// Передаём экземпляр объекта - тоже работает
	Трансформер = Zod.Трансформер(Обработки.Zod_Трансформеры.Создать(),
		"ЧислоИзИдентификатора");
	ЮТест.ОжидаетЧто(Трансформер.Преобразовать("x99x")).Равно(99);
КонецПроцедуры

Процедура АдаптерМетодНеНайден() Экспорт
	Трансформер = Zod.Трансформер(Обработки.Zod_Трансформеры, "НесуществующийМетод");
	Выброшено = Ложь;
	Попытка
		Трансформер.Преобразовать("x");
	Исключение
		Выброшено = Истина;
		// Проверяем, что в сообщении есть имя метода
		ЮТест.ОжидаетЧто(СтрНайти(ОписаниеОшибки(), "НесуществующийМетод")).Больше(0);
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

Процедура АдаптерВалидацияИмениМетода() Экспорт
	// Невалидное имя - инъекция
	Выброшено = Ложь;
	Попытка
		Zod.Трансформер(Обработки.Zod_Трансформеры, "Метод;Удалить();");
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();

	// Пустое имя
	Выброшено = Ложь;
	Попытка
		Zod.Трансформер(Обработки.Zod_Трансформеры, "");
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

Процедура АдаптерОбъектНеопределено() Экспорт
	Выброшено = Ложь;
	Попытка
		Zod.Трансформер(Неопределено, "Метод");
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

Процедура АдаптерЭтоВалидныйИдентификатор() Экспорт
	ЮТест.ОжидаетЧто(Zod.ЭтоВалидныйИдентификатор("Метод")).ЭтоИстина();
	ЮТест.ОжидаетЧто(Zod.ЭтоВалидныйИдентификатор("_Метод")).ЭтоИстина();
	ЮТест.ОжидаетЧто(Zod.ЭтоВалидныйИдентификатор("Метод123")).ЭтоИстина();
	ЮТест.ОжидаетЧто(Zod.ЭтоВалидныйИдентификатор("Метод_2")).ЭтоИстина();
	ЮТест.ОжидаетЧто(Zod.ЭтоВалидныйИдентификатор("1Метод")).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Zod.ЭтоВалидныйИдентификатор("Метод;")).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Zod.ЭтоВалидныйИдентификатор("Метод Метод")).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Zod.ЭтоВалидныйИдентификатор("")).ЭтоЛожь();
КонецПроцедуры

// ============ ИНТЕГРАЦИЯ ============

Процедура ИнтеграцияСТрансформировать() Экспорт
	Схема = Zod.Любое()
		.Трансформировать(Zod.Трансформер(Обработки.Zod_Трансформеры,
			"ЧислоИзИдентификатора"))
		.Конвейер(Zod.Числа().Целое().Положительное());

	ЮТест.ОжидаетЧто(Схема.Проверить("id-42").Данные).Равно(42);
	ЮТест.ОжидаетЧто(Схема.Проверить("id-0").Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ОбаСпособаРаботают() Экспорт
	// Старый способ
	СтарыйСпособ = Zod.Строки()
		.Трансформировать(Обработки.Zod_Трансформер_Телефон.Создать())
		.Телефон();
	ЮТест.ОжидаетЧто(СтарыйСпособ.Проверить("+79991234567").Успех).ЭтоИстина();

	// Новый способ
	НовыйСпособ = Zod.Любое()
		.Трансформировать(Zod.Трансформер(Обработки.Zod_Трансформеры,
			"ЧислоИзИдентификатора"))
		.Конвейер(Zod.Числа().Положительное());
	ЮТест.ОжидаетЧто(НовыйСпособ.Проверить("abc-1").Успех).ЭтоИстина();
КонецПроцедуры

Процедура ТрансформерСТипомБазыЛюбое() Экспорт
	Схема = Zod.Любое()
		.Трансформировать(Zod.Трансформер(Обработки.Zod_Трансформеры,
			"ЧислоИзИдентификатора"));
	ЮТест.ОжидаетЧто(Схема.Проверить("id-42").Данные).Равно(42);
КонецПроцедуры

// ============ ZOD_ТРАНСФОРМЕРЫ ============

Процедура UnixTimestampСекунды() Экспорт
	Трансформер = Zod.Трансформер(Обработки.Zod_Трансформеры, "UnixTimestamp");

	// 2020-01-01 00:00:00 UTC = 1577836800
	Эпоха = Трансформер.Преобразовать(0);
	Целевое = Трансформер.Преобразовать(1577836800);

	// Разница между датами в секундах должна точно равняться 1577836800
	ЮТест.ОжидаетЧто((Целевое - Эпоха) * 86400).Равно(1577836800);

	// Дополнительно: «сейчас» конвертируется в сегодняшнюю универсальную дату
	ТекущийUnix = Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() / 1000);
	ЮТест.ОжидаетЧто(Трансформер.Преобразовать(ТекущийUnix))
		.Равно(ТекущаяУниверсальнаяДата());
КонецПроцедуры

Процедура UnixTimestampМиллисекунды() Экспорт
	Трансформер = Zod.Трансформер(Обработки.Zod_Трансформеры, "UnixTimestamp",
		Новый Структура("ЕдиницаИзмерения", "Миллисекунды"));

	Эпоха = Трансформер.Преобразовать(0);
	Целевое = Трансформер.Преобразовать(1577836800000); // те же 2020-01-01 UTC

	ЮТест.ОжидаетЧто((Целевое - Эпоха) * 86400).Равно(1577836800);
КонецПроцедуры

Процедура СтатусИзСтрокиВалидное() Экспорт
	Карта = Новый Соответствие;
	Карта.Вставить("new",  "Новый");
	Карта.Вставить("work", "ВРаботе");

	Трансформер = Zod.Трансформер(Обработки.Zod_Трансформеры, "СтатусИзСтроки",
		Новый Структура("Карта", Карта));

	ЮТест.ОжидаетЧто(Трансформер.Преобразовать("new")).Равно("Новый");
	ЮТест.ОжидаетЧто(Трансформер.Преобразовать("work")).Равно("ВРаботе");
КонецПроцедуры

Процедура СтатусИзСтрокиНевалидное() Экспорт
	Карта = Новый Соответствие;
	Карта.Вставить("new", "Новый");

	Трансформер = Zod.Трансформер(Обработки.Zod_Трансформеры, "СтатусИзСтроки",
		Новый Структура("Карта", Карта));

	Выброшено = Ложь;
	Попытка
		Трансформер.Преобразовать("unknown");
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

Процедура ЧислоИзИдентификатора() Экспорт
	Трансформер = Zod.Трансформер(Обработки.Zod_Трансформеры,
		"ЧислоИзИдентификатора");
	ЮТест.ОжидаетЧто(Трансформер.Преобразовать("id-12345")).Равно(12345);
	ЮТест.ОжидаетЧто(Трансформер.Преобразовать("abc42def")).Равно(42);
КонецПроцедуры

// ============ ПОЙМАТЬ ============

Процедура ТрансформерСПоймать() Экспорт
	Карта = Новый Соответствие;
	Карта.Вставить("new", "Новый");

	Схема = Zod.Строки()
		.Трансформировать(Zod.Трансформер(Обработки.Zod_Трансформеры,
			"СтатусИзСтроки", Новый Структура("Карта", Карта)))
		.Поймать("Неизвестный");

	// Валидное значение - как есть
	ЮТест.ОжидаетЧто(Схема.Проверить("new").Данные).Равно("Новый");
	// Невалидное - исключение из трансформера ловится catch
	ЮТест.ОжидаетЧто(Схема.Проверить("unknown").Данные).Равно("Неизвестный");
КонецПроцедуры
