Процедура ОбъектПустой() Экспорт
	Схема = Zod.Объект()
		.Поле("Имя", Zod.Строки())
		.Поле("Возраст", Zod.Числа().Целое());

	Шаблон = Схема.СоздатьПустой();

	ЮТест.ОжидаетЧто(ТипЗнч(Шаблон)).Равно(Тип("Структура"));
	ЮТест.ОжидаетЧто(Шаблон.Имя).Равно("");
	ЮТест.ОжидаетЧто(Шаблон.Возраст).Равно(0);
КонецПроцедуры

Процедура ОбъектСНеобязательным() Экспорт
	Схема = Zod.Объект()
		.Поле("Имя", Zod.Строки())
		.Поле("Комментарий", Zod.Строки().Необязательное());

	Шаблон = Схема.СоздатьПустой();

	ЮТест.ОжидаетЧто(Шаблон.Свойство("Имя")).ЭтоИстина();
	ЮТест.ОжидаетЧто(Шаблон.Свойство("Комментарий")).ЭтоИстина();
	ЮТест.ОжидаетЧто(Шаблон.Комментарий).Равно(Неопределено);
КонецПроцедуры

Процедура ОбъектМинимальный() Экспорт
	Схема = Zod.Объект()
		.Поле("Имя", Zod.Строки())
		.Поле("Комментарий", Zod.Строки().Необязательное());

	Шаблон = Схема.СоздатьМинимальный();

	ЮТест.ОжидаетЧто(Шаблон.Свойство("Имя")).ЭтоИстина();
	ЮТест.ОжидаетЧто(Шаблон.Свойство("Комментарий")).ЭтоЛожь(); // не включено
КонецПроцедуры

Процедура ВложенныйОбъект() Экспорт
	Схема = Zod.Объект()
		.Поле("Пользователь", Zod.Объект()
			.Поле("Имя", Zod.Строки())
			.Поле("Email", Zod.Email()))
		.Поле("Роли", Zod.Массивы().Элемент(Zod.Строки()));

	Шаблон = Схема.СоздатьПустой();

	ЮТест.ОжидаетЧто(ТипЗнч(Шаблон.Пользователь)).Равно(Тип("Структура"));
	ЮТест.ОжидаетЧто(Шаблон.Пользователь.Имя).Равно("");
	ЮТест.ОжидаетЧто(Шаблон.Пользователь.Email).Равно("");
	ЮТест.ОжидаетЧто(ТипЗнч(Шаблон.Роли)).Равно(Тип("Массив"));
	ЮТест.ОжидаетЧто(Шаблон.Роли.Количество()).Равно(0);
КонецПроцедуры

Процедура МассивыПустая() Экспорт
	Шаблон = Zod.Массивы().Элемент(Zod.Числа()).СоздатьПустой();
	ЮТест.ОжидаетЧто(ТипЗнч(Шаблон)).Равно(Тип("Массив"));
	ЮТест.ОжидаетЧто(Шаблон.Количество()).Равно(0);
КонецПроцедуры

Процедура ЗаписьПустая() Экспорт
	Шаблон = Zod.Запись(Zod.Строки(), Zod.Числа()).СоздатьПустой();
	ЮТест.ОжидаетЧто(ТипЗнч(Шаблон)).Равно(Тип("Соответствие"));
	ЮТест.ОжидаетЧто(Шаблон.Количество()).Равно(0);
КонецПроцедуры

Процедура ПеречислениеПустая() Экспорт
	М = Новый Массив;
	М.Добавить("red");
	М.Добавить("green");
	М.Добавить("blue");
	Схема = Zod.Перечисление(М);
	ЮТест.ОжидаетЧто(Схема.СоздатьПустой()).Равно("red"); // первое значение
