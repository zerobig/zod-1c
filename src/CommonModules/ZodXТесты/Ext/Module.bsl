Процедура ПсевдонимыСДискриминированнымОбъединениемВнутри() Экспорт
	// Плагин корректно обрабатывает объекты, содержащие внутри поля
	// со схемой ДискриминированноеОбъединение. Сам дискриминатор - литерал,
	// поэтому не имеет алиасов и работает штатно.
	Схема = ZodX.Обернуть(
		Zod.СтрогийОбъект()
			.Поле("payload", Zod.ДискриминированноеОбъединение("method", ЮТКоллекции.ЗначениеВМассиве(
				Zod.СтрогийОбъект()
					.Поле("method", Zod.Литерал("pickup"))
					.Поле("pickup", Zod.СтрогийОбъект()
						.Поле("Имя", Zod.Строки().Мета("Псевдоним", "name"))),
				Zod.СтрогийОбъект()
					.Поле("method", Zod.Литерал("delivery")))))
	).Плагин(Обработки.ZodX_Псевдонимы.Создать());

	Данные = Новый Структура("payload", Новый Структура(
		"method, pickup", "pickup",
		Новый Структура("name", "ул. Ленина, 1")));

	Результат = Схема.Проверить(Данные);
	// Ожидаем: псевдоним внутри pickup НЕ будет обработан (плагин не заглядывает
	// внутрь Дискр.Объединения - это задокументированное ограничение).
	// Значит поле "Имя" останется пустым (не заполнено) → strict object
	// ругнётся на "Имя" отсутствующее.
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ПсевдонимыКТрансформацииЗначения() Экспорт
	// Плагин применяется ДО ядра, поэтому трансформации внутри поля
	// работают над уже переименованным значением.
	// Проверяем: алиас находит значение, затем СтрДлина считает длину.
	Схема = ZodX.Обернуть(
		Zod.СтрогийОбъект()
			.Поле("Имя", Zod.Строки().МинДлина(3).Мета("Псевдоним", "name"))
	).Плагин(Обработки.ZodX_Псевдонимы.Создать());

	Результат = Схема.Проверить(Новый Структура("name", "Alice"));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();

	Результат = Схема.Проверить(Новый Структура("name", "Al"));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
КонецПроцедуры

// ============ ЛОКАЛИЗАЦИЯ ============

Процедура ЛокализацияЗаменяетСообщение() Экспорт
	Карта = Новый Соответствие;
	Карта.Вставить("Ожидалась строка", "Поле должно быть строкой");
	Плагин = Обработки.ZodX_Локализация.Создать();
