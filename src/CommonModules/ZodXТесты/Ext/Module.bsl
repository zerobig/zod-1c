Процедура РезолверКастомныйКлючГруппы() Экспорт
	// Два поля с одним Методом, но разными Параметрами.
	// Без явного Ключа они объединились бы в одну группу и
	// параметры одного затерли бы параметры другого.
	// С Ключом - резолвятся раздельно.
	Карта1 = Новый Соответствие;
	Карта1.Вставить("A-001", "Товар 1");
	Карта2 = Новый Соответствие;
	Карта2.Вставить("A-001", "Товар 2 (другая карта)");

	Схема = ZodX.Обернуть(
		Zod.СтрогийОбъект()
			.Поле("Товар1", Zod.Строки().Мета("Резолвер",
				МетаРезолвера("ПоКарте", Новый Структура("Карта", Карта1), "К1")))
			.Поле("Товар2", Zod.Строки().Мета("Резолвер",
				МетаРезолвера("ПоКарте", Новый Структура("Карта", Карта2), "К2")))
	).Плагин(Обработки.ZodX_РезолверЗначений.Создать());

	Результат = Схема.Проверить(Новый Структура("Товар1, Товар2", "A-001", "A-001"));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Товар1).Равно("Товар 1");
	ЮТест.ОжидаетЧто(Результат.Данные.Товар2).Равно("Товар 2 (другая карта)");
КонецПроцедуры

Процедура РезолверСЛокализацией() Экспорт
	// Доп. ошибки из резолвера попадают в Результат.Ошибки до постобработки,
	// поэтому Локализация их видит и переводит.
	КартаОшибок = Новый Соответствие;
	КартаОшибок.Вставить("Значение не разрешено: A-999", "Товар не найден");

	Схема = ZodX.Обернуть(
		Zod.СтрогийОбъект()
			.Поле("Товар", Zod.Строки().Необязательное().Мета("Резолвер",
				МетаРезолвера("ПоКарте", Новый Структура("Карта", КартаТоваров()))))
	)
	.Плагин(Обработки.ZodX_РезолверЗначений.Создать())
	.Плагин(Обработки.ZodX_Локализация.Создать(), КартаОшибок);

	Результат = Схема.Проверить(Новый Структура("Товар", "A-999"));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	Найдено = Ложь;
	Для Каждого Ош Из Результат.Ошибки Цикл
		Если Ош.Путь = "Товар" И Ош.Сообщение = "Товар не найден" Тогда
			Найдено = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Найдено).ЭтоИстина();
КонецПроцедуры

