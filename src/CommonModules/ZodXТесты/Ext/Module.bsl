Функция КартаТоваров()
	Карта = Новый Соответствие;
	Карта.Вставить("A-001", "Товар A-001");
	Карта.Вставить("A-002", "Товар A-002");
	Возврат Карта;
КонецФункции

Функция МетаРезолвера(Метод, Параметры = Неопределено, Ключ = Неопределено)
	Результат = Новый Структура("Обработчик, Метод",
		Обработки.ZodX_ТестовыйРезолвер, Метод);
	Если Параметры <> Неопределено Тогда
		Результат.Вставить("Параметры", Параметры);
	КонецЕсли;
	Если Ключ <> Неопределено Тогда
		Результат.Вставить("Ключ", Ключ);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция МетаПоКарте(Карта, Ключ = Неопределено)
	Возврат МетаРезолвера("ПоКарте",
		Новый Структура("Карта", Карта), Ключ);
