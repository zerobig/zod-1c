Процедура ОбаПлагинаВместе() Экспорт
	Карта = Новый Соответствие;
	Карта.Вставить("Ожидалось число", "Поле должно быть числом");
	ПлагинЛок = Обработки.ZodX_Локализация.Создать();
	ПлагинПрив = Обработки.ZodX_Приведение.Создать();

	Схема = ZodX.Обернуть(
		Zod.СтрогийОбъект()
			.Поле("Возраст", Zod.Числа().Мета("Приведение", "Число"))
	).Плагин(ПлагинПрив).Плагин(ПлагинЛок, Карта);

	ЮТест.ОжидаетЧто(Схема.Проверить(Новый Структура("Возраст", "30")).Успех).ЭтоИстина();

	Результат = Схема.Проверить(Новый Структура("Возраст", "abc"));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Поле должно быть числом");
КонецПроцедуры

