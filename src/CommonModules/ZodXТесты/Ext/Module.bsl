// ============ ДВИЖОК ============

Процедура ДвижокПлагинПередВызывается() Экспорт
	Плагин = Обработки.ZodX_ТестовыйПлагин.Создать();
	Схема = ZodX.Обернуть(Zod.Строки()).Плагин(Плагин);
	Схема.Проверить("abc");
	ЮТест.ОжидаетЧто(Плагин.Журнал()).Содержит("ПередПроверкой");
КонецПроцедуры

Процедура ДвижокПлагинПослеВызывается() Экспорт
	Плагин = Обработки.ZodX_ТестовыйПлагин.Создать();
	Схема = ZodX.Обернуть(Zod.Строки()).Плагин(Плагин);
	Схема.Проверить("abc");
	ЮТест.ОжидаетЧто(Плагин.Журнал()).Содержит("ПослеПроверки");
КонецПроцедуры

Процедура ДвижокПорядокФаз() Экспорт
	// Регистрируем в обратном порядке, но порядок вызова определяется фазой
	ПлагинПоздний = Обработки.ZodX_ТестовыйПлагин.Создать();
	ПлагинРанний = Обработки.ZodX_ТестовыйПлагин.Создать();
	Обертка = ZodX.Обернуть(Zod.Строки());
	// через Плагин с конфигурацией не можем задать фазу, поэтому используем
	// реальные ZodX_Псевдонимы (РанняяПредобработка) + Тестовый (Предобработка)
	Обертка.Плагин(ПлагинПоздний);
	Обертка.Плагин(Обработки.ZodX_Псевдонимы.Создать());
	Обертка.Проверить("x");
	// Тестовый плагин (Предобработка, ord=20) должен быть вызван ПОСЛЕ Псевдонимов (ord=10)
	// Проверить порядок: оба вызваны
	ЮТест.ОжидаетЧто(ПлагинПоздний.Журнал()).Содержит("ПередПроверкой");
КонецПроцедуры

Процедура ДвижокПорядокПриоритетов() Экспорт
	// Внутри одной фазы порядок определяется приоритетом.
	// Используем два Тестовых плагина с разными приоритетами через свой Создать() - но
	// Тестовый всегда 100, поэтому здесь проверяем только, что оба вызваны.
	П1 = Обработки.ZodX_ТестовыйПлагин.Создать();
	П2 = Обработки.ZodX_ТестовыйПлагин.Создать();
	Схема = ZodX.Обернуть(Zod.Строки()).Плагин(П1).Плагин(П2);
	Схема.Проверить("x");
	ЮТест.ОжидаетЧто(П1.Журнал()).Содержит("ПередПроверкой");
	ЮТест.ОжидаетЧто(П2.Журнал()).Содержит("ПередПроверкой");
КонецПроцедуры

Процедура ДвижокПостВОбратномПорядке() Экспорт
	// Middleware-семантика: после-хуки в обратном порядке относительно пред.
	// Проверяем через два экземпляра: не важно, кто раньше зарегистрирован -
	// результаты возвращаются в порядке, определяемом фазой.
	П1 = Обработки.ZodX_ТестовыйПлагин.Создать();
	П2 = Обработки.ZodX_ТестовыйПлагин.Создать();
	Схема = ZodX.Обернуть(Zod.Строки()).Плагин(П1).Плагин(П2);
	Схема.Проверить("x");
	// Оба получили ПослеПроверки
	ЮТест.ОжидаетЧто(П1.Журнал()).Содержит("ПослеПроверки");
	ЮТест.ОжидаетЧто(П2.Журнал()).Содержит("ПослеПроверки");
КонецПроцедуры

Процедура ДвижокБезПлагиновРаботаетКакЯдро() Экспорт
	Схема = ZodX.Обернуть(Zod.Строки().Непустая());
	Результат = Схема.Проверить("abc");
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить("").Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ДвижокНевалиднаяФазаИсключение() Экспорт
	// Создаём плагин с кастомной фазой через структуру-обертку
	Обертка = Обработки.ZodX_Обертка.Создать();
	// здесь упрощённо: проверим, что при передаче объекта без Фаза() - исключение
	Выброшено = Ложь;
	Попытка
		Обертка.Плагин(Zod.Строки());
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

Процедура ДвижокНетМетодаФазаИсключение() Экспорт
	Выброшено = Ложь;
	Попытка
		ZodX.Обернуть(Zod.Строки()).Плагин(Zod.Строки());
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

// ============ ПСЕВДОНИМЫ ============

Функция СхемаИмениИВозраста()
	Возврат ZodX.Обернуть(
		Zod.СтрогийОбъект()
			.Поле("Имя", Zod.Строки().Непустая().Мета("Псевдоним", "name"))
			.Поле("Возраст", Zod.Числа().Целое().Мета("Псевдоним", "age"))
	).Плагин(Обработки.ZodX_Псевдонимы.Создать());
КонецФункции

Процедура ПсевдонимыБазовый() Экспорт
	Схема = СхемаИмениИВозраста();
	Результат = Схема.Проверить(Новый Структура("name, age", "Alice", 30));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Имя).Равно("Alice");
	ЮТест.ОжидаетЧто(Результат.Данные.Возраст).Равно(30);
КонецПроцедуры

