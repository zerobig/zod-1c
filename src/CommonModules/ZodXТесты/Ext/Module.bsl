Процедура РезолверНенайденноеДопОшибка() Экспорт
	Схема = ZodX.Обернуть(
		Zod.СтрогийОбъект()
			.Поле("Товар", Zod.Строки().Необязательное().Мета("Резолвер",
				МетаРезолвера("ПоКарте", Новый Структура("Карта", КартаТоваров()))))
	).Плагин(Обработки.ZodX_РезолверЗначений.Создать());

	Результат = Схема.Проверить(Новый Структура("Товар", "A-999"));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	// Ищем нашу доп. ошибку с точным путём
	Найдено = Ложь;
	Для Каждого Ош Из Результат.Ошибки Цикл
		Если Ош.Путь = "Товар" И СтрНайти(Ош.Сообщение, "не разрешено") > 0 Тогда
			Найдено = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Найдено).ЭтоИстина();
КонецПроцедуры

