Процедура ОдинПараметрНесколькоЗначений() Экспорт
	// ?tag=a&tag=b&tag=c → в 1С ПараметрыЗапроса["tag"] = Массив("a","b","c")
	Схема = Zod.СтрогийОбъект()
		.Поле("tag", Zod.Массивы().Элемент(Zod.Строки()));

	Запрос = ЮТест.Данные().HTTPСервисЗапрос();
	Запрос.ПараметрыЗапроса.Вставить("tag",
		ЮТКоллекции.ЗначениеВМассиве("a", "b", "c"));

	Результат = Zod.ПроверитьПараметрыЗапроса(Запрос, Схема);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Получить("tag").Количество()).Равно(3);
	ЮТест.ОжидаетЧто(Результат.Данные.Получить("tag")[0]).Равно("a");
