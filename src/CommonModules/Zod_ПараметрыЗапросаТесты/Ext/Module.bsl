Процедура ПриведениеБулево_Варианты() Экспорт
	// Все варианты, которые понимает ПриведенноеБулево
	Схема = Zod.СтрогийОбъект()
		.Поле("flag", Zod.ПриведенноеБулево());

	Случаи = Новый Массив;
	Случаи.Добавить(Новый Структура("Вход, Ожидание", "1", Истина));
	Случаи.Добавить(Новый Структура("Вход, Ожидание", "0", Ложь));
	Случаи.Добавить(Новый Структура("Вход, Ожидание", "да", Истина));
	Случаи.Добавить(Новый Структура("Вход, Ожидание", "нет", Ложь));
	Случаи.Добавить(Новый Структура("Вход, Ожидание", "TRUE", Истина));
	Случаи.Добавить(Новый Структура("Вход, Ожидание", "FALSE", Ложь));

	Для Каждого Случай Из Случаи Цикл
		Запрос = СоздатьЗапрос(Новый Структура("flag", Случай.Вход));
		Результат = Zod.ПроверитьПараметрыЗапроса(Запрос, Схема);
		ЮТест.ОжидаетЧто(Результат.Успех,
			"Вход: " + Случай.Вход).ЭтоИстина();
		ЮТест.ОжидаетЧто(Результат.Данные.Получить("flag"),
			"Вход: " + Случай.Вход).Равно(Случай.Ожидание);
	КонецЦикла;
КонецПроцедуры

