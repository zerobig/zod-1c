// ============ КОМБИНАЦИЯ РАЗНЫХ ТИПОВ ============

Процедура КомбинацияСРазнымиТипами() Экспорт
	Схема = Zod.СтрогийОбъект()
		.Поле("categoryId", Zod.UUID().Необязательное())
		.Поле("search", Zod.Строки().МаксДлина(100).Необязательное())
		.Поле("page", Zod.ПриведенноеЧисло().Целое().МинЗначение(1).Необязательное())
		.Поле("limit", Zod.ПриведенноеЧисло().Целое().МаксЗначение(100).Необязательное())
		.Поле("inStock", Zod.ПриведенноеБулево().Необязательное());

	Параметры = Новый Структура;
	Параметры.Вставить("categoryId", "a1b2c3d4-e5f6-7890-abcd-ef1234567890");
	Параметры.Вставить("search", "молоток");
	Параметры.Вставить("page", "2");
	Параметры.Вставить("limit", "20");
	Параметры.Вставить("inStock", "true");

	Запрос = СоздатьЗапрос(Параметры);
	Результат = Zod.ПроверитьПараметрыЗапроса(Запрос, Схема);

	ЮТест.ОжидаетЧто(Результат.Успех,
		"Ошибки: " + Zod.КрасивыйТекстОшибок(Результат.Ошибки)).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.Получить("categoryId")).Равно("a1b2c3d4-e5f6-7890-abcd-ef1234567890");
	ЮТест.ОжидаетЧто(Результат.Данные.Получить("search")).Равно("молоток");
	ЮТест.ОжидаетЧто(Результат.Данные.Получить("page")).Равно(2);
	ЮТест.ОжидаетЧто(Результат.Данные.Получить("limit")).Равно(20);
	ЮТест.ОжидаетЧто(Результат.Данные.Получить("inStock")).ЭтоИстина();
КонецПроцедуры
