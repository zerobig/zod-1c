// Вспомогательная функция: создаёт мок HTTPСервисЗапрос и заполняет ПараметрыЗапроса.
Функция СоздатьЗапрос(Параметры = Неопределено)
	Запрос = ЮТест.Данные().HTTPСервисЗапрос();
	Если Параметры <> Неопределено Тогда
		Для Каждого КЗ Из Параметры Цикл
			Запрос.ПараметрыЗапроса.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Запрос;
КонецФункции

// Вспомогательная
Функция СодержитКлюч(Коллекция, ИскомыйКлюч)
	Для Каждого Элемент Из Коллекция Цикл
		Если Элемент.Ключ = ИскомыйКлюч Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// ============ ПУСТЫЕ ЗАПРОСЫ ============

Процедура ПустойЗапрос_ВсеНеобязательные() Экспорт
	Схема = Zod.СтрогийОбъект()
		.Поле("page", Zod.ПриведенноеЧисло().Целое().Необязательное())
		.Поле("search", Zod.Строки().Необязательное());

	Запрос = СоздатьЗапрос();
	Результат = Zod.ПроверитьПараметрыЗапроса(Запрос, Схема);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(СодержитКлюч(Результат.Данные, "page")).ЭтоЛожь();
	ЮТест.ОжидаетЧто(СодержитКлюч(Результат.Данные, "search")).ЭтоЛожь();
КонецПроцедуры

Процедура ПустойЗапрос_ОбязательноеОтсутствует() Экспорт
	Схема = Zod.СтрогийОбъект()
