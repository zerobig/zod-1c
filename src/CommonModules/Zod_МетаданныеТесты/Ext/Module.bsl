Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		.ДобавитьТест("ВалидныеМетаданные")
		.ДобавитьТест("НеверныйТип")
		.ДобавитьТест("ВидМетаданных");
КонецПроцедуры

Процедура ВалидныеМетаданные() Экспорт
	МетаОбъект = Метаданные.Справочники.Zod_Справочник1;
	Результат = Zod.СхемаМетаданных().Проверить(МетаОбъект);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные).Равно(МетаОбъект);
КонецПроцедуры

Процедура НеверныйТип() Экспорт
	Для Каждого Значение Из ЮТКоллекции.ЗначениеВМассиве(
			"Справочник.Zod_Справочник1", 123, Новый Структура, Неопределено) Цикл

		ЮТест.ОжидаетЧто(Zod.СхемаМетаданных().Проверить(Значение).Успех).ЭтоЛожь();
	КонецЦикла;
КонецПроцедуры

Процедура ВидМетаданных() Экспорт
	// Только справочники
	Схема = Zod.СхемаМетаданных("Справочник");

	ЮТест.ОжидаетЧто(Схема.Проверить(Метаданные.Справочники.Zod_Справочник1).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(Метаданные.Документы.Zod_Документ1).Успех).ЭтоЛожь();
КонецПроцедуры
