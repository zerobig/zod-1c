КонецПроцедуры

Процедура Необязательное() Экспорт
	ЮТест.ОжидаетЧто(Zod.Числа().Необязательное().Проверить(Неопределено).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Zod.Числа().Необязательное().Проверить(0).Успех).ЭтоИстина();
КонецПроцедуры

Процедура Приведение() Экспорт
	Схема = Zod.ПриведенноеЧисло();

	// Строки с числами
	ЮТест.ОжидаетЧто(Схема.Проверить("123").Данные).Равно(123);
	ЮТест.ОжидаетЧто(Схема.Проверить("1.5").Данные).Равно(1.5);

	// Нечисловая строка - ошибка приведения
	Рез = Схема.Проверить("abc");
	ЮТест.ОжидаетЧто(Рез.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Рез.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Рез.Ошибки[0].Сообщение).Содержит("привести");

	// Булево в 1С приводится к числу: Истина → 1, Ложь → 0
	ЮТест.ОжидаетЧто(Схема.Проверить(Истина).Данные).Равно(1);
	ЮТест.ОжидаетЧто(Схема.Проверить(Ложь).Данные).Равно(0);

	// Уже число - возвращается как есть
	ЮТест.ОжидаетЧто(Схема.Проверить(42).Данные).Равно(42);
	ЮТест.ОжидаетЧто(Схема.Проверить(0).Данные).Равно(0);

	// Обязательное поле с Неопределено
	Рез = Схема.Проверить(Неопределено);
	ЮТест.ОжидаетЧто(Рез.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Рез.Ошибки[0].Сообщение).Равно("Обязательное значение");
КонецПроцедуры

Процедура КастомноеСообщение() Экспорт
	Результат = Zod.Числа("Это не число").Проверить("abc");
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Это не число");
КонецПроцедуры
