Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Zod: Числа")
		.ДобавитьТест("ВалидноеЧисло")
		.ДобавитьТест("НеверныйТип")
		.ДобавитьТест("Целое")
		.ДобавитьТест("МинЗначение")
		.ДобавитьТест("МаксЗначение")
		.ДобавитьТест("Положительное")
		.ДобавитьТест("Необязательное")
		.ДобавитьТест("Приведение")
		.ДобавитьТест("КастомноеСообщение")
		;

КонецПроцедуры

Процедура ВалидноеЧисло() Экспорт
	Результат = Zod.Числа().Проверить(42);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные).Равно(42);
КонецПроцедуры

Процедура НеверныйТип() Экспорт

	// 1. Обязательное поле с Неопределено → "Обязательное значение"
	Результат = Zod.Числа().Проверить(Неопределено);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Обязательное значение");

	// 2. Остальные значения → "Ожидалось число"
	Для Каждого Значение Из ЮТКоллекции.ЗначениеВМассиве(
			"123", Истина, Новый Структура) Цикл

		Результат = Zod.Числа().Проверить(Значение);
		ЮТест.ОжидаетЧто(Результат.Успех, "Значение: " + Строка(Значение)).ЭтоЛожь();
		ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
		ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Ожидалось число");
	КонецЦикла;

КонецПроцедуры

Процедура Целое() Экспорт
	Схема = Zod.Числа().Целое();

	ЮТест.ОжидаетЧто(Схема.Проверить(42).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(0).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(-1).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(1.5).Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить(0.1).Успех).ЭтоЛожь();

	Результат = Zod.Числа().Целое("Должно быть целым").Проверить(1.5);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Должно быть целым");
КонецПроцедуры

Процедура МинЗначение() Экспорт
	Схема = Zod.Числа().МинЗначение(10);

	ЮТест.ОжидаетЧто(Схема.Проверить(9).Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить(10).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(11).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(10.1).Успех).ЭтоИстина();

	Результат = Zod.Числа().МинЗначение(10, "Не меньше 10").Проверить(9);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Не меньше 10");
КонецПроцедуры

Процедура МаксЗначение() Экспорт
	Схема = Zod.Числа().МаксЗначение(100);

	ЮТест.ОжидаетЧто(Схема.Проверить(100).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(100.1).Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Схема.Проверить(0).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(-1).Успех).ЭтоИстина();

	Результат = Zod.Числа().МаксЗначение(100, "Не больше 100").Проверить(101);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Сообщение).Равно("Не больше 100");
КонецПроцедуры

Процедура Положительное() Экспорт
	Схема = Zod.Числа().Положительное();

	ЮТест.ОжидаетЧто(Схема.Проверить(1).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(0.1).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(0).Успех).ЭтоЛожь();
