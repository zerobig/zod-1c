// ============ ТРАНСФОРМЕРЫ ============

// Телефон с автоматической нормализацией.
// Принимает "8 (999) 123-45-67", "9991234567" и т.п., приводит к "+79991234567".
Функция НормализованныйТелефон(Ошибка = Неопределено) Экспорт
	Трансформер = Обработки.Zod_Трансформер_Телефон.Создать();
	Возврат СоздатьСхему("Строка", Ошибка)
		.Трансформировать(Трансформер)
		.Телефон(Ошибка);
КонецФункции

// Трансформер «пустое → Неопределено» с настройками по умолчанию (строка + дата).
Функция ПустоеВНеопределено() Экспорт
	Трансформер = Обработки.Zod_Трансформер_ПустоеВНеопределено.Создать();
	Трансформер.Инициализировать();
	Возврат Трансформер;
КонецФункции

// Адаптер для параметров URL (query string).
// Передаёт Соответствие напрямую в схему - ключи сохраняются как есть,
// включая невалидные для Структуры имена (user-id, filter.name и т.п.).
Функция ПроверитьПараметрыЗапроса(Запрос, Схема) Экспорт

	Параметры = Запрос.ПараметрыЗапроса;
	Если Параметры = Неопределено Тогда
		Параметры = Новый Соответствие;
	КонецЕсли;

	Возврат Схема.Проверить(Параметры);

КонецФункции

// ============ ВНУТРЕННЕЕ ============

Функция СоздатьСхему(ТипСхемы, Ошибка = Неопределено, Приведение = Ложь)
	Схема = Обработки.Zod_Схема.Создать();
	Схема.Инициализировать(ТипСхемы, Ошибка, Приведение);
	Возврат Схема;
КонецФункции

Функция СоздатьСхемуСсылки(Вид, Имя, Ошибка)
	Возврат СоставнаяСсылка(Вид + "." + Имя, Ошибка);
КонецФункции

Функция СоздатьСхемуОбъекта1С(Вид, Имя, Ошибка)
	Схема = СоздатьСхему("Объект1С", Ошибка);
	Схема.УстановитьВидОбъекта1С(Вид, Имя);
	Возврат Схема;
КонецФункции

Процедура ВставитьВДерево(Дерево, ЧастиПути, Сообщение)
	Если ЧастиПути.Количество() = 0 Тогда
		Дерево.errors.Добавить(Сообщение);
		Возврат;
	КонецЕсли;
	Часть = ЧастиПути[0];
	Хвост = Новый Массив;
	Для Индекс = 1 По ЧастиПути.Количество() - 1 Цикл
		Хвост.Добавить(ЧастиПути[Индекс]);
	КонецЦикла;
	ПозицияСкобки = СтрНайти(Часть, "[");
	Если ПозицияСкобки > 0 И Прав(Часть, 1) = "]" Тогда
		ИмяСвойства = Лев(Часть, ПозицияСкобки - 1);
		Индекс = Число(Сред(Часть, ПозицияСкобки + 1, СтрДлина(Часть) - ПозицияСкобки - 1));
		Узел = Дерево.properties.Получить(ИмяСвойства);
		Если Узел = Неопределено Тогда
			Узел = Новый Структура("errors, properties, items");
			Узел.errors = Новый Массив;
			Узел.properties = Новый Соответствие;
			Узел.items = Новый Массив;
			Дерево.properties.Вставить(ИмяСвойства, Узел);
		КонецЕсли;
		Пока Узел.items.Количество() <= Индекс Цикл
			Эл = Новый Структура("errors, properties, items");
			Эл.errors = Новый Массив;
			Эл.properties = Новый Соответствие;
			Эл.items = Новый Массив;
			Узел.items.Добавить(Эл);
		КонецЦикла;
		ВставитьВДерево(Узел.items[Индекс], Хвост, Сообщение);
		Возврат;
	КонецЕсли;
	Узел = Дерево.properties.Получить(Часть);
	Если Узел = Неопределено Тогда
		Узел = Новый Структура("errors, properties, items");
		Узел.errors = Новый Массив;
		Узел.properties = Новый Соответствие;
		Узел.items = Новый Массив;
		Дерево.properties.Вставить(Часть, Узел);
	КонецЕсли;
	ВставитьВДерево(Узел, Хвост, Сообщение);
КонецПроцедуры
