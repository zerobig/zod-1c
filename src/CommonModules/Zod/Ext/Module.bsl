Функция СоставнаяСсылка(ПервыйТип = Неопределено, Ошибка = Неопределено) Экспорт
	Схема = СоздатьСхему("Ссылка", Ошибка);
	Если ПервыйТип <> Неопределено Тогда
		Если ТипЗнч(ПервыйТип) = Тип("Строка") Тогда
			Схема.ДобавитьДопустимыйТипСсылки(ПервыйТип);
		ИначеЕсли ТипЗнч(ПервыйТип) = Тип("Массив") Тогда
			Для Каждого Имя Из ПервыйТип Цикл
				Схема.ДобавитьДопустимыйТипСсылки(Имя);
			КонецЦикла;
		Иначе
			ВызватьИсключение "zod-1c: СоставнаяСсылка() принимает строку или массив строк";
		КонецЕсли;
	КонецЕсли;
	Возврат Схема;
КонецФункции

// Объект метаданных. ВидОбъекта (необязательно): "Справочник", "Документ" и т.д.
Функция СхемаМетаданных(ВидОбъекта = Неопределено, Ошибка = Неопределено) Экспорт
	Если ТипЗнч(ВидОбъекта) = Тип("Строка") И ВидОбъекта = "" Тогда
		ВидОбъекта = Неопределено;
	КонецЕсли;
	Схема = СоздатьСхему("Метаданные", Ошибка);
	Схема.УстановитьВидМетаданных(ВидОбъекта);
	Возврат Схема;
КонецФункции

