// ============ СЕРИАЛИЗАЦИЯ ============

Функция СериализоватьСсылку(Ссылка) Экспорт
	Если Ссылка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ЭтоСсылка1С(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Результат = Новый Структура("type, id");
	Результат.type = Ссылка.Метаданные().ПолноеИмя();
	Результат.id = Строка(Ссылка.УникальныйИдентификатор());
	Возврат Результат;
КонецФункции

Функция ЭтоСсылка1С(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат Истина;
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат Истина;
	ИначеЕсли ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат Истина;
	ИначеЕсли ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат Истина;
	ИначеЕсли ПланыОбмена.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат Истина;
	ИначеЕсли БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат Истина;
	ИначеЕсли Задачи.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат Истина;
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция СериализоватьОбъект(Объект) Экспорт

	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	МетаОбъект = Объект.Метаданные();
	Результат = Новый Структура;

	// Реквизиты
	Для Каждого Реквизит Из МетаОбъект.Реквизиты Цикл
		Результат.Вставить(Реквизит.Имя, СериализоватьЗначение(Объект[Реквизит.Имя]));
	КонецЦикла;

	// Стандартные реквизиты (безопасное получение)
	Попытка
		СтандартныеРеквизиты = МетаОбъект.СтандартныеРеквизиты;
	Исключение
		СтандартныеРеквизиты = Неопределено;
	КонецПопытки;

	Если СтандартныеРеквизиты <> Неопределено Тогда
		Для Каждого Реквизит Из СтандартныеРеквизиты Цикл
			Если Реквизит.Имя = "Ссылка"
				ИЛИ Реквизит.Имя = "ВерсияДанных"
				ИЛИ Реквизит.Имя = "ИмяПредопределенныхДанных" Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				Результат.Вставить(Реквизит.Имя, СериализоватьЗначение(Объект[Реквизит.Имя]));
			Исключение
				// Некоторые стандартные реквизиты недоступны для чтения
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	// Табличные части
	Для Каждого ТЧ Из МетаОбъект.ТабличныеЧасти Цикл
		МассивСтрок = Новый Массив;
		Для Каждого СтрокаОбъекта Из Объект[ТЧ.Имя] Цикл
			СтруктураСтроки = Новый Структура;
			Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
				СтруктураСтроки.Вставить(Реквизит.Имя, СериализоватьЗначение(СтрокаОбъекта[Реквизит.Имя]));
			КонецЦикла;
			МассивСтрок.Добавить(СтруктураСтроки);
		КонецЦикла;
		Результат.Вставить(ТЧ.Имя, МассивСтрок);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СериализоватьЗначение(Значение) Экспорт
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ЭтоСсылка1С(Значение) Тогда
		Возврат СериализоватьСсылку(Значение);
	КонецЕсли;
	Возврат Значение;
КонецФункции

// ============ УТИЛИТЫ ФОРМАТИРОВАНИЯ ОШИБОК ============

Функция ДеревоОшибок(Ошибки) Экспорт
	Дерево = Новый Структура("errors, properties, items");
	Дерево.errors = Новый Массив;
	Дерево.properties = Новый Соответствие;
	Дерево.items = Новый Массив;
	Для Каждого Ош Из Ошибки Цикл
		Если ПустаяСтрока(Ош.Путь) Тогда
			Дерево.errors.Добавить(Ош.Сообщение);
		Иначе
			ВставитьВДерево(Дерево, СтрРазделить(Ош.Путь, "."), Ош.Сообщение);
		КонецЕсли;
	КонецЦикла;
	Возврат Дерево;
КонецФункции

Функция ПлоскиеОшибки(Ошибки) Экспорт
	Результат = Новый Структура("formErrors, fieldErrors");
	Результат.formErrors = Новый Массив;
	Результат.fieldErrors = Новый Соответствие;
	Для Каждого Ош Из Ошибки Цикл
		Если ПустаяСтрока(Ош.Путь) Тогда
			Результат.formErrors.Добавить(Ош.Сообщение);
		Иначе
			Массив = Результат.fieldErrors.Получить(Ош.Путь);
			Если Массив = Неопределено Тогда
				Массив = Новый Массив;
				Результат.fieldErrors.Вставить(Ош.Путь, Массив);
			КонецЕсли;
			Массив.Добавить(Ош.Сообщение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция КрасивыйТекстОшибок(Ошибки) Экспорт
	Если Ошибки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого Ош Из Ошибки Цикл
		Если ПустаяСтрока(Ош.Путь) Тогда
			Части.Добавить(Ош.Сообщение);
		Иначе
			Части.Добавить(Ош.Путь + ": " + Ош.Сообщение);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС);
КонецФункции

// ============ КАСТОМНЫЕ ПРОВЕРКИ ============

// Схема из одной пользовательской проверки.
Функция Проверка(ОбъектПроверки, Ошибка = Неопределено) Экспорт
	Возврат СоздатьСхему("Любое", Неопределено).Проверка(ОбъектПроверки, Ошибка);
КонецФункции

