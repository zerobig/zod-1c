////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - фасад движка плагинов ZodX.
// Общий модуль. Сервер, вызов сервера.
//
// Назначение: собирать расширенные схемы с плагинами (alias, coerce,
// логирование, i18n ошибок, OpenAPI-аннотации) поверх чистого ядра Zod.
//
// Плагин - это обработка с методами-хуками. Плагины подключаются через
// ZodX_Обертка.Плагин(). Один пайплайн, много аспектов, никаких оберток
// на обертках.
//
// Пример:
//   Схема = ZodX.Обернуть(
//               Zod.Объект()
//                   .Поле("Имя", Zod.Строки().Мета("Псевдоним", "name"))
//                   .Поле("Возраст", Zod.Числа().Целое().Мета("Псевдоним", "age"))
//           )
//           .Плагин(ZodX_Псевдонимы.Создать())
//           .Плагин(...);
//
//   Результат = Схема.Проверить(Новый Структура("name, age", "Alice", 30));
////////////////////////////////////////////////////////////////////////////////

// Оборачивает готовую Zod_Схему в ZodX_Обертку.
//
// Параметры:
//   Схема - объект обработки Zod_Схема.
//
// Возвращает ZodX_Обертку, к которой можно цепочкой подключать плагины
// и вызывать .Проверить() / .ПроверитьИлиВыбросить().
//
// Имя Обернуть выбрано, потому что Из зарезервировано платформой (FROM).
Функция Обернуть(Схема) Экспорт
	Обертка = Обработки.ZodX_Обертка.Создать();
	Обертка.Инициализировать(Схема);
	Возврат Обертка;
КонецФункции

// --- Удобные фабрики-обертки (делегируют в Zod) ---
//
// Используются, когда хочется строить схему сразу с плагинами:
//   ZodX.Объект().Поле("Имя", ...).Плагин(...)
//
// Для фабрик, которые не обернуты здесь, используйте:
//   ZodX.Обернуть(Zod.Чтото(...)).Плагин(...)

Функция Объект(Ошибка = Неопределено) Экспорт
	Возврат Обернуть(Zod.Объект(Ошибка));
КонецФункции

Функция СтрогийОбъект(Ошибка = Неопределено) Экспорт
	Возврат Обернуть(Zod.СтрогийОбъект(Ошибка));
КонецФункции

Функция СвободныйОбъект(Ошибка = Неопределено) Экспорт
	Возврат Обернуть(Zod.СвободныйОбъект(Ошибка));
КонецФункции

Функция Массивы(Ошибка = Неопределено) Экспорт
	Возврат Обернуть(Zod.Массивы(Ошибка));
КонецФункции

Функция Строки(Ошибка = Неопределено) Экспорт
	Возврат Обернуть(Zod.Строки(Ошибка));
КонецФункции

Функция Числа(Ошибка = Неопределено) Экспорт
	Возврат Обернуть(Zod.Числа(Ошибка));
КонецФункции
