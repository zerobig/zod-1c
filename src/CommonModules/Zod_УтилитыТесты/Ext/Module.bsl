Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		.ДобавитьТест("ДеревоОшибок")
		.ДобавитьТест("ПлоскиеОшибки")
		.ДобавитьТест("КрасивыйТекстОшибок")
		.ДобавитьТест("СериализацияСсылки")
		.ДобавитьТест("СериализацияОбъекта");
КонецПроцедуры

Процедура ДеревоОшибок() Экспорт
	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый Структура("Путь, Сообщение", "Имя", "Обязательное поле"));
	Ошибки.Добавить(Новый Структура("Путь, Сообщение", "Адрес.Город", "Неверный город"));
	Ошибки.Добавить(Новый Структура("Путь, Сообщение", "", "Общая ошибка"));

	Дерево = Zod.ДеревоОшибок(Ошибки);

	ЮТест.ОжидаетЧто(Дерево.errors.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Дерево.errors[0]).Равно("Общая ошибка");

	УзелИмя = Дерево.properties.Получить("Имя");
	ЮТест.ОжидаетЧто(УзелИмя).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(УзелИмя.errors[0]).Равно("Обязательное поле");

	УзелАдрес = Дерево.properties.Получить("Адрес");
	ЮТест.ОжидаетЧто(УзелАдрес).НеРавно(Неопределено);
	УзелГород = УзелАдрес.properties.Получить("Город");
	ЮТест.ОжидаетЧто(УзелГород.errors[0]).Равно("Неверный город");
КонецПроцедуры

Процедура ПлоскиеОшибки() Экспорт
	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый Структура("Путь, Сообщение", "Имя", "Обязательное"));
	Ошибки.Добавить(Новый Структура("Путь, Сообщение", "Имя", "Слишком короткое"));
	Ошибки.Добавить(Новый Структура("Путь, Сообщение", "", "Общая"));

	Плоские = Zod.ПлоскиеОшибки(Ошибки);

	ЮТест.ОжидаетЧто(Плоские.formErrors.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Плоские.fieldErrors.Получить("Имя").Количество()).Равно(2);
КонецПроцедуры

Процедура КрасивыйТекстОшибок() Экспорт
	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый Структура("Путь, Сообщение", "Имя", "Обязательное"));
	Ошибки.Добавить(Новый Структура("Путь, Сообщение", "", "Общая"));

	Текст = Zod.КрасивыйТекстОшибок(Ошибки);

	ЮТест.ОжидаетЧто(Текст).Содержит("Имя: Обязательное");
	ЮТест.ОжидаетЧто(Текст).Содержит("Общая");
	ЮТест.ОжидаетЧто(Текст).Содержит(Символы.ПС);
КонецПроцедуры

Процедура СериализацияСсылки() Экспорт
	Номенклатура = ЮТест.Данные().СоздатьЭлемент("Справочник.Zod_Справочник1", "Для сериализации");

	Результат = Zod.СериализоватьСсылку(Номенклатура);

	ЮТест.ОжидаетЧто(Результат).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Результат.type).Равно("Справочник.Zod_Справочник1");
	ЮТест.ОжидаетЧто(Результат.id).Равно(Строка(Номенклатура.УникальныйИдентификатор()));

	// Неопределено
	ЮТест.ОжидаетЧто(Zod.СериализоватьСсылку(Неопределено)).Равно(Неопределено);

	// Не ссылка - возвращается как есть
	ЮТест.ОжидаетЧто(Zod.СериализоватьСсылку(123)).Равно(123);
КонецПроцедуры

Процедура СериализацияОбъекта() Экспорт
	Документ = ЮТест.Данные().КонструкторОбъекта("Документы.Zod_Документ1")
		.Установить("Комментарий", "Тест сериализации")
		.Записать( , Истина);

	Результат = Zod.СериализоватьОбъект(Документ);

	ЮТест.ОжидаетЧто(Результат).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Результат.Комментарий).Равно("Тест сериа"); // Тип комментария Строка(10)
	ЮТест.ОжидаетЧто(Результат.Свойство("Ссылка")).ЭтоЛожь(); // служебные пропущены
	ЮТест.ОжидаетЧто(Результат.Свойство("Дата")).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Свойство("Номер")).ЭтоИстина();
КонецПроцедуры
