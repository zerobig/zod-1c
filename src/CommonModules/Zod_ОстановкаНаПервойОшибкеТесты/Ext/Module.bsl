////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - тесты режима fail fast.
// Исполняемые сценарии для YaxUnit.
////////////////////////////////////////////////////////////////////////////////

Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		// API
		.ДобавитьТест("ОпцияВызоваРаботает")
		.ДобавитьТест("МутаторСхемыРаботает")
		.ДобавитьТест("ФлагВызоваИЛИФлагСхемы")
		.ДобавитьТест("ФлагВызоваНеОтключаетФлагСхемы")
		.ДобавитьТест("ПараметрыНеопределеноРаботаетКакРаньше")
		.ДобавитьТест("ПараметрыНеСтруктураИсключение")
		.ДобавитьТест("МаркерОстановленНаПервойОшибке")
		// Массив
		.ДобавитьТест("МассивПерваяОшибкаПрерывает")
		.ДобавитьТест("МассивМаксЭлементовНеОбходит")
		.ДобавитьТест("МассивМинЭлементовНеОбходит")
		.ДобавитьТест("МассивБезФлагаСобираетВсе")
		.ДобавитьТест("МассивВсеОшибкиПервогоЭлемента")
		// Запись
		.ДобавитьТест("ЗаписьПерваяОшибкаПрерывает")
		// Объект
		.ДобавитьТест("ОбъектВсеПоляПроверяются")
		.ДобавитьТест("ОбъектВложенныйМассивПрерывается")
		// Композиция
		.ДобавитьТест("КонвейерПервыйПровалОстанавливает")
		.ДобавитьТест("ПересечениеПервыйПровалОстанавливает")
		// Поймать
		.ДобавитьТест("ПойматьПоглощаетОшибкуИПродолжает")
		// Каскад
		.ДобавитьТест("ФлагКаскадируетсяВниз");
КонецПроцедуры

// ============ API ============

Процедура ОпцияВызоваРаботает() Экспорт
	Схема = СхемаЗаказовБезФлага();
	Параметры = Новый Структура("ОстановитьсяНаПервойОшибке", Истина);
	Результат = Схема.Проверить(ДанныеСДвумяНевалиднымиЭлементами(), Параметры);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	// Ошибки только первого элемента
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.ОстановленНаПервойОшибке).ЭтоИстина();
КонецПроцедуры

Процедура МутаторСхемыРаботает() Экспорт
	Схема = СхемаЗаказовБезФлага().ОстановитьсяНаПервойОшибке();
	Результат = Схема.Проверить(ДанныеСДвумяНевалиднымиЭлементами());

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
КонецПроцедуры

Процедура ФлагВызоваИЛИФлагСхемы() Экспорт
	Схема = СхемаЗаказовБезФлага();
	Параметры = Новый Структура("ОстановитьсяНаПервойОшибке", Истина);
	Результат = Схема.Проверить(ДанныеСДвумяНевалиднымиЭлементами(), Параметры);

	// Даже без флага на схеме - флаг вызова включил режим
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
КонецПроцедуры

Процедура ФлагВызоваНеОтключаетФлагСхемы() Экспорт
	Схема = СхемаЗаказовБезФлага().ОстановитьсяНаПервойОшибке();
	// Явно передаём Ложь - не должно отключить флаг схемы
	Параметры = Новый Структура("ОстановитьсяНаПервойОшибке", Ложь);
	Результат = Схема.Проверить(ДанныеСДвумяНевалиднымиЭлементами(), Параметры);

	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
КонецПроцедуры

Процедура ПараметрыНеопределеноРаботаетКакРаньше() Экспорт
	Схема = СхемаЗаказовБезФлага();
	Результат = Схема.Проверить(ДанныеСДвумяНевалиднымиЭлементами());
	// Все ошибки обоих элементов
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(2);
КонецПроцедуры

Процедура ПараметрыНеСтруктураИсключение() Экспорт
	Выброшено = Ложь;
	Попытка
		СхемаЗаказовБезФлага().Проверить(Новый Структура, "не структура");
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

Процедура МаркерОстановленНаПервойОшибке() Экспорт
	Схема = СхемаЗаказовБезФлага().ОстановитьсяНаПервойОшибке();
	// Валидный - маркер Ложь
	Р1 = Схема.Проверить(Новый Структура("Заказы", Новый Массив));
	ЮТест.ОжидаетЧто(Р1.ОстановленНаПервойОшибке).ЭтоЛожь();
	// Невалидный - маркер Истина
	Р2 = Схема.Проверить(ДанныеСДвумяНевалиднымиЭлементами());
	ЮТест.ОжидаетЧто(Р2.ОстановленНаПервойОшибке).ЭтоИстина();
КонецПроцедуры

// ============ МАССИВ ============

Процедура МассивПерваяОшибкаПрерывает() Экспорт
	Схема = Zod.Массивы()
		.Элемент(Zod.Строки().Непустая())
		.ОстановитьсяНаПервойОшибке();

	Массив = Новый Массив;
	Массив.Добавить("");   // невалидный
	Массив.Добавить("");   // невалидный
	Массив.Добавить("");   // невалидный

	Результат = Схема.Проверить(Массив);
	// Только одна ошибка - от первого элемента
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Путь).Равно("[0]");
КонецПроцедуры

Процедура МассивМаксЭлементовНеОбходит() Экспорт
	Схема = Zod.Массивы()
		.Элемент(Zod.Строки().Непустая())
		.МаксЭлементов(2)
		.ОстановитьсяНаПервойОшибке();

	Массив = Новый Массив;
	Массив.Добавить("a");
	Массив.Добавить("b");
	Массив.Добавить("c");   // превышение

	Результат = Схема.Проверить(Массив);
	// Одна ошибка - «макс. 2», обхода элементов нет
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Ошибки[0].Сообщение, "Макс")).Больше(0);
КонецПроцедуры

Процедура МассивМинЭлементовНеОбходит() Экспорт
	Схема = Zod.Массивы()
		.Элемент(Zod.Строки().Непустая())
		.МинЭлементов(3)
		.ОстановитьсяНаПервойОшибке();

	Массив = Новый Массив;
	Массив.Добавить("");   // невалидный

	Результат = Схема.Проверить(Массив);
	// Одна ошибка - «мин. 3», обхода элементов нет
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Ошибки[0].Сообщение, "Мин")).Больше(0);
КонецПроцедуры

Процедура МассивБезФлагаСобираетВсе() Экспорт
	Схема = Zod.Массивы().Элемент(Zod.Строки().Непустая());
	Массив = Новый Массив;
	Массив.Добавить("");
	Массив.Добавить("");
	Массив.Добавить("");

	Результат = Схема.Проверить(Массив);
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(3);
КонецПроцедуры

Процедура МассивВсеОшибкиПервогоЭлемента() Экспорт
	Схема = Zod.Массивы()
		.Элемент(Zod.Объект()
			.Поле("a", Zod.Строки().Непустая())
			.Поле("b", Zod.Числа().Положительное()))
		.ОстановитьсяНаПервойОшибке();

	Элем1 = Новый Структура("a, b", "", -1);  // обе ошибки
	Элем2 = Новый Структура("a, b", "", -1);  // не должен проверяться

	Массив = Новый Массив;
	Массив.Добавить(Элем1);
	Массив.Добавить(Элем2);

	Результат = Схема.Проверить(Массив);
	// 2 ошибки от первого элемента (a и b), второй не проверялся
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(2);
КонецПроцедуры

// ============ ЗАПИСЬ ============

Процедура ЗаписьПерваяОшибкаПрерывает() Экспорт
	Схема = Zod.Запись(Zod.Строки(), Zod.Числа().Положительное())
		.ОстановитьсяНаПервойОшибке();

	Запись = Новый Соответствие;
	Запись.Вставить("a", -1);   // невалидно
	Запись.Вставить("b", -1);   // невалидно
	Запись.Вставить("c", -1);   // невалидно

	Результат = Схема.Проверить(Запись);
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
КонецПроцедуры

// ============ ОБЪЕКТ ============

Процедура ОбъектВсеПоляПроверяются() Экспорт
	Схема = Zod.Объект()
		.Поле("a", Zod.Строки().Непустая())
		.Поле("b", Zod.Числа().Положительное())
		.Поле("c", Zod.Булевы())
		.ОстановитьсяНаПервойОшибке();

	Данные = Новый Структура("a, b, c", "", -1, "не булево");
	Результат = Схема.Проверить(Данные);
	// Все 3 поля невалидны - все 3 ошибки
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(3);
КонецПроцедуры

Процедура ОбъектВложенныйМассивПрерывается() Экспорт
	Схема = Zod.Объект()
		.Поле("Заказы", Zod.Массивы()
			.Элемент(Zod.Объект()
				.Поле("Сумма", Zod.Числа().Положительное())))
		.ОстановитьсяНаПервойОшибке();

	Заказ1 = Новый Структура("Сумма", -1);
	Заказ2 = Новый Структура("Сумма", -2);

	Массив = Новый Массив;
	Массив.Добавить(Заказ1);
	Массив.Добавить(Заказ2);

	Данные = Новый Структура("Заказы", Массив);
	Результат = Схема.Проверить(Данные);
	// Только первая ошибка
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
КонецПроцедуры

// ============ КОМПОЗИЦИЯ ============

Процедура КонвейерПервыйПровалОстанавливает() Экспорт
	// Первый упал → второй не должен дать доп. ошибок
	Схема = Zod.Строки().Непустая().Конвейер(Zod.Строки().МинДлина(10))
		.ОстановитьсяНаПервойОшибке();
	Результат = Схема.Проверить("");
	// Одна ошибка от первого этапа
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
КонецПроцедуры

Процедура ПересечениеПервыйПровалОстанавливает() Экспорт
	Схема = Zod.Строки().Непустая()
		.Пересечение(Zod.Строки().МинДлина(10))
		.ОстановитьсяНаПервойОшибке();
	Результат = Схема.Проверить("");
	// Только от первой схемы
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
КонецПроцедуры

// ============ ПОЙМАТЬ ============

Процедура ПойматьПоглощаетОшибкуИПродолжает() Экспорт
	// Поле 1 с catch поглотит свою ошибку; поле 2 даст ошибку
	Схема = Zod.Объект()
		.Поле("a", Zod.Числа().Поймать(0))
		.Поле("b", Zod.Строки().Непустая())
		.ОстановитьсяНаПервойОшибке();

	Данные = Новый Структура("a, b", "не число", "");
	Результат = Схема.Проверить(Данные);

	// Ошибка только от b - a вылечилось через catch
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Путь).Равно("b");
КонецПроцедуры

// ============ КАСКАД ============

Процедура ФлагКаскадируетсяВниз() Экспорт
	// Корень с флагом, вложенный массив - без явного флага
	Схема = Zod.Объект()
		.Поле("items", Zod.Массивы()
			.Элемент(Zod.Строки().Непустая()))
		.ОстановитьсяНаПервойОшибке();

	Массив = Новый Массив;
	Массив.Добавить("");
	Массив.Добавить("");
	Массив.Добавить("");

	Результат = Схема.Проверить(Новый Структура("items", Массив));
	// Флаг дошёл до массива - одна ошибка
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
КонецПроцедуры

// ============ ВСПОМОГАТЕЛЬНЫЕ ============

Функция СхемаЗаказовБезФлага()
	Возврат Zod.Объект()
		.Поле("Заказы", Zod.Массивы()
			.Элемент(Zod.Объект()
				.Поле("Сумма", Zod.Числа().Положительное())));
КонецФункции

Функция ДанныеСДвумяНевалиднымиЭлементами()
	Массив = Новый Массив;
	Массив.Добавить(Новый Структура("Сумма", -1));
	Массив.Добавить(Новый Структура("Сумма", -2));
	Возврат Новый Структура("Заказы", Массив);
КонецФункции
