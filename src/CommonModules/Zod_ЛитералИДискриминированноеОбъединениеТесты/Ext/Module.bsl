	ЮТест.ОжидаетЧто(Схема.Проверить(42).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(43).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ЛитералБулево() Экспорт
	Схема = Zod.Литерал(Истина);
	ЮТест.ОжидаетЧто(Схема.Проверить(Истина).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(Ложь).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ЛитералОбязательностьПоУмолчанию() Экспорт
	Схема = Zod.Литерал("pickup");
	ЮТест.ОжидаетЧто(Схема.Проверить(Неопределено).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ЛитералНеобязательное() Экспорт
	Схема = Zod.Литерал("pickup").Необязательное();
	ЮТест.ОжидаетЧто(Схема.Проверить(Неопределено).Успех).ЭтоИстина();
