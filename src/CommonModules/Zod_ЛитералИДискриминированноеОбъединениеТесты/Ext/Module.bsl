Процедура ДискрВходСоответствие() Экспорт
	// ПроверитьПараметрыЗапроса передаёт Соответствие — критично, чтобы работало
	Схема = СхемаЗаказа();
	Данные = Новый Соответствие;
	Данные.Вставить("method", "pickup");
	Данные.Вставить("pickup", Новый Структура("address, storeId", "ул. Ленина, 1", 42));
	ЮТест.ОжидаетЧто(Схема.Проверить(Данные).Успех).ЭтоИстина();

	ДанныеПлохо = Новый Соответствие;
	ДанныеПлохо.Вставить("method", "unknown");
	ЮТест.ОжидаетЧто(Схема.Проверить(ДанныеПлохо).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ЛитералНеопределеноИсключение() Экспорт
	Выброшено = Ложь;
	Попытка
		Zod.Литерал(Неопределено);
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

// ============ ВСПОМОГАТЕЛЬНЫЕ ============

Функция СхемаPickup()
	Возврат Zod.СтрогийОбъект()
		.Поле("method", Zod.Литерал("pickup"))
		.Поле("pickup", Zod.Объект()
			.Поле("address", Zod.Строки().Непустая())
			.Поле("storeId", Zod.Числа().Целое()));
КонецФункции

Функция СхемаDelivery()
	Возврат Zod.СтрогийОбъект()
		.Поле("method", Zod.Литерал("delivery"))
		.Поле("delivery", Zod.Объект()
			.Поле("address", Zod.Строки().Непустая())
			.Поле("courierPhone", Zod.Строки().Телефон()));
КонецФункции

Функция СхемаЗаказа()
	Возврат Zod.ДискриминированноеОбъединение("method",
		ЮТКоллекции.ЗначениеВМассиве(СхемаPickup(), СхемаDelivery()));
КонецФункции
