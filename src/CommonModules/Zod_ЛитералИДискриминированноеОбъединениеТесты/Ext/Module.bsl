КонецПроцедуры

Процедура ДискрНетMethod() Экспорт
	Схема = СхемаЗаказа();
	Данные = Новый Структура("pickup",
		Новый Структура("address, storeId", "ул. Ленина, 1", 42));
	ЮТест.ОжидаетЧто(Схема.Проверить(Данные).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ДискрMethodРавенNull() Экспорт
	Схема = СхемаЗаказа();
	Данные = Новый Структура("method");
	Данные.method = Неопределено;
	Результат = Схема.Проверить(Данные);
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();

	Найдено = Ложь;
	Для Каждого Ош Из Результат.Ошибки Цикл
		Если Ош.Путь = "method"
			И СтрНайти(Ош.Сообщение, "Отсутствует или недопустимое") > 0 Тогда
			Найдено = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Найдено).ЭтоИстина();
КонецПроцедуры

Процедура ДискрОшибкаВВыбраннойВетке() Экспорт
	Схема = СхемаЗаказа();
	// pickup.address пустой - не пройдёт Непустая()
	Данные = Новый Структура("method, pickup", "pickup",
		Новый Структура("address, storeId", "", 42));
	ЮТест.ОжидаетЧто(Схема.Проверить(Данные).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ДискрЛишнееПолеСоседнегоВарианта() Экспорт
	Схема = СхемаЗаказа();
	// СтрогийОбъект - лишнее поле delivery провоцирует ошибку
	Данные = Новый Структура("method, pickup, delivery", "pickup",
		Новый Структура("address, storeId", "ул. Ленина, 1", 42),
		Новый Структура("address, courierPhone", "ул. Мира, 5", "+79991234567"));
	ЮТест.ОжидаетЧто(Схема.Проверить(Данные).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ДискрОбычныйОбъектИгнорируетЛишнее() Экспорт
	СхемаPickup = Zod.Объект() // не строгий
		.Поле("method", Zod.Литерал("pickup"))
		.Поле("pickup", Zod.Объект().Поле("address", Zod.Строки()));
	СхемаDelivery = Zod.Объект()
		.Поле("method", Zod.Литерал("delivery"))
		.Поле("delivery", Zod.Объект().Поле("address", Zod.Строки()));
	Схема = Zod.ДискриминированноеОбъединение("method",
		ЮТКоллекции.ЗначениеВМассиве(СхемаPickup, СхемаDelivery));
	Данные = Новый Структура("method, pickup, delivery", "pickup",
		Новый Структура("address", "ул. Ленина, 1"),
		Новый Структура("address", "ул. Мира, 5"));
	// Обычный Объект лишние ключи отбрасывает - лишний delivery пропадает
	ЮТест.ОжидаетЧто(Схема.Проверить(Данные).Успех).ЭтоИстина();
КонецПроцедуры

Процедура ДискрПутьОшибкиДляНеизвестногоМетода() Экспорт
	Схема = СхемаЗаказа();
	Результат = Схема.Проверить(Новый Структура("method", "unknown"));
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Больше(0);
	НайденаОшибкаПоМетоду = Ложь;
	Для Каждого Ош Из Результат.Ошибки Цикл
		Если Ош.Путь = "method" Тогда
			НайденаОшибкаПоМетоду = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(НайденаОшибкаПоМетоду).ЭтоИстина();
КонецПроцедуры

Процедура ДискрДубликатЛитералаИсключение() Экспорт
	Схема1 = Zod.Объект().Поле("method", Zod.Литерал("x"));
	Схема2 = Zod.Объект().Поле("method", Zod.Литерал("x"));
	Выброшено = Ложь;
	Попытка
		Zod.ДискриминированноеОбъединение("method",
			ЮТКоллекции.ЗначениеВМассиве(Схема1, Схема2));
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

