Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		// Литералы
		.ДобавитьТест("ЛитералСовпадение")
		.ДобавитьТест("ЛитералНесовпадениеЗначения")
		.ДобавитьТест("ЛитералНесовпадениеТипа")
