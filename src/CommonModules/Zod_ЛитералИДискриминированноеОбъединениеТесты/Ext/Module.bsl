		.ДобавитьТест("ЛитералБулево")
		.ДобавитьТест("ЛитералОбязательностьПоУмолчанию")
		.ДобавитьТест("ЛитералНеобязательное")
		.ДобавитьТест("ЛитералСоздатьПустой")
		// Дискриминированное объединение
		.ДобавитьТест("ДискрВалидныйPickup")
		.ДобавитьТест("ДискрВалидныйDelivery")
		.ДобавитьТест("ДискрНеизвестныйMethod")
		.ДобавитьТест("ДискрНетMethod")
		.ДобавитьТест("ДискрMethodРавенNull")
		.ДобавитьТест("ДискрОшибкаВВыбраннойВетке")
		.ДобавитьТест("ДискрЛишнееПолеСоседнегоВарианта")
		.ДобавитьТест("ДискрОбычныйОбъектИгнорируетЛишнее")
		.ДобавитьТест("ДискрПутьОшибкиДляНеизвестногоМетода")
		.ДобавитьТест("ДискрДубликатЛитералаИсключение")
		.ДобавитьТест("ДискрДискриминаторНеЛитералИсключение")
		.ДобавитьТест("ДискрНетПоляДискриминатораИсключение")
		.ДобавитьТест("ДискрВариантНеОбъектИсключение")
		.ДобавитьТест("ДискрНеобязательное")
		.ДобавитьТест("ДискрСоздатьПустой")
		.ДобавитьТест("ДискрВходСоответствие")
		.ДобавитьТест("ЛитералНеопределеноИсключение")
	;
КонецПроцедуры

// ============ ЛИТЕРАЛЫ ============

Процедура ЛитералСовпадение() Экспорт
	Схема = Zod.Литерал("pickup");
	Результат = Схема.Проверить("pickup");
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные).Равно("pickup");
КонецПроцедуры

Процедура ЛитералНесовпадениеЗначения() Экспорт
	Схема = Zod.Литерал("pickup");
	ЮТест.ОжидаетЧто(Схема.Проверить("delivery").Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ЛитералНесовпадениеТипа() Экспорт
	// "1" <> 1, несмотря на визуальное сходство
	Схема = Zod.Литерал("1");
	ЮТест.ОжидаетЧто(Схема.Проверить(1).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ЛитералЧисло() Экспорт
