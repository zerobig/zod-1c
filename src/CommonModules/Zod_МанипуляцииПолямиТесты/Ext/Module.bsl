////////////////////////////////////////////////////////////////////////////////
// zod-1c v4 - тесты манипуляций с полями объекта.
// Исполняемые сценарии для YaxUnit.
////////////////////////////////////////////////////////////////////////////////

Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		// Клонирование
		.ДобавитьТест("КлонироватьНезависимость")
		.ДобавитьТест("КлонироватьТипСхемы")
		// Выбрать (pick)
		.ДобавитьТест("ВыбратьОдноПоле")
		.ДобавитьТест("ВыбратьДваПоля")
		.ДобавитьТест("ВыбратьВсеПоля")
		.ДобавитьТест("ВыбратьСтрокой")
		.ДобавитьТест("ВыбратьНесуществующееПоле")
		.ДобавитьТест("ВыбратьИзНеОбъекта")
		.ДобавитьТест("ВыбратьИммутабельность")
		// Исключить (omit)
		.ДобавитьТест("ИсключитьОдноПоле")
		.ДобавитьТест("ИсключитьНесколькоПолей")
		.ДобавитьТест("ИсключитьВсеПоля")
		.ДобавитьТест("ИсключитьНесуществующееПоле")
		// СделатьНеобязательными (partial)
		.ДобавитьТест("СделатьНеобязательнымиВсе")
		.ДобавитьТест("СделатьНеобязательнымиУказанные")
		.ДобавитьТест("СделатьНеобязательнымиНесуществующее")
		.ДобавитьТест("СделатьНеобязательнымиИммутабельность")
		// СделатьОбязательными (required)
		.ДобавитьТест("СделатьОбязательнымиВсе")
		.ДобавитьТест("СделатьОбязательнымиУказанные")
		.ДобавитьТест("СделатьОбязательнымиСохраняетДопускаетNull")
		.ДобавитьТест("СделатьОбязательнымиИммутабельность")
		// Комбинации
		.ДобавитьТест("ВыбратьПотомСделатьНеобязательными")
		.ДобавитьТест("ВалидацияПослеPick")
		.ДобавитьТест("ВалидацияПослеPartial");
КонецПроцедуры

// ============ ВСПОМОГАТЕЛЬНЫЕ ============

Функция СхемаПользователя()
	Возврат Zod.СтрогийОбъект()
		.Поле("id",       Zod.Числа().Целое())
		.Поле("Имя",      Zod.Строки().Непустая())
		.Поле("Отчество", Zod.Строки())
		.Поле("Возраст",  Zod.Числа().Целое().МинЗначение(0));
КонецФункции

// ============ КЛОНИРОВАНИЕ ============

Процедура КлонироватьНезависимость() Экспорт
	Исходная = Zod.Объект().Поле("a", Zod.Строки());
	Клон = Исходная.Клонировать();
	Клон.Поле("b", Zod.Числа());

	// В исходной схеме поля "b" не появилось
	ЮТест.ОжидаетЧто(Исходная.НайтиСхемуПоля("a")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Исходная.НайтиСхемуПоля("b")).ЭтоНеопределено();

	// В клоне — оба поля
	ЮТест.ОжидаетЧто(Клон.НайтиСхемуПоля("a")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Клон.НайтиСхемуПоля("b")).ЭтоНеНеопределено();
КонецПроцедуры

Процедура КлонироватьТипСхемы() Экспорт
	Исходная = Zod.СтрогийОбъект().Поле("a", Zod.Строки());
	Клон = Исходная.Клонировать();
	// Строгость должна сохраниться
	Результат = Клон.Проверить(Новый Структура("a, лишнее", "x", 1));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
КонецПроцедуры

// ============ ВЫБРАТЬ (pick) ============

Процедура ВыбратьОдноПоле() Экспорт
	Схема = СхемаПользователя().Выбрать("Имя");

	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Имя")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Возраст")).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("id")).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Отчество")).ЭтоНеопределено();

	ЮТест.ОжидаетЧто(Схема.Проверить(
		Новый Структура("Имя", "Alice")).Успех).ЭтоИстина();
КонецПроцедуры

Процедура ВыбратьДваПоля() Экспорт
	Схема = СхемаПользователя().Выбрать(
		ЮТКоллекции.ЗначениеВМассиве("Имя", "Возраст"));

	// Выбранные поля остались
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Имя")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Возраст")).ЭтоНеНеопределено();

	// Остальные — удалены
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("id")).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Отчество")).ЭтоНеопределено();
КонецПроцедуры

Процедура ВыбратьВсеПоля() Экспорт
	Схема = СхемаПользователя().Выбрать(
		ЮТКоллекции.ЗначениеВМассиве("id", "Имя", "Отчество", "Возраст"));

	// Все четыре поля на месте
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("id")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Имя")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Отчество")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Возраст")).ЭтоНеНеопределено();
КонецПроцедуры

Процедура ВыбратьСтрокой() Экспорт
	// Единственное имя можно передать строкой
	Схема = СхемаПользователя().Выбрать("Имя");
	ЮТест.ОжидаетЧто(Схема.Проверить(Новый Структура("Имя", "Alice")).Успех).ЭтоИстина();
КонецПроцедуры

Процедура ВыбратьНесуществующееПоле() Экспорт
	Выброшено = Ложь;
	Попытка
		СхемаПользователя().Выбрать("Несуществующее");
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

Процедура ВыбратьИзНеОбъекта() Экспорт
	Выброшено = Ложь;
	Попытка
		Zod.Строки().Выбрать("что-то");
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

Процедура ВыбратьИммутабельность() Экспорт
	Исходная = СхемаПользователя();
	Результат = Исходная.Выбрать("Имя");

	// Исходная схема не изменилась — все 4 поля на месте
	ЮТест.ОжидаетЧто(Исходная.НайтиСхемуПоля("id")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Исходная.НайтиСхемуПоля("Имя")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Исходная.НайтиСхемуПоля("Отчество")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Исходная.НайтиСхемуПоля("Возраст")).ЭтоНеНеопределено();

	// Результат — только одно поле
	ЮТест.ОжидаетЧто(Результат.НайтиСхемуПоля("Имя")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Результат.НайтиСхемуПоля("id")).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Результат.НайтиСхемуПоля("Отчество")).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Результат.НайтиСхемуПоля("Возраст")).ЭтоНеопределено();
КонецПроцедуры

// ============ ИСКЛЮЧИТЬ (omit) ============

Процедура ИсключитьОдноПоле() Экспорт
	Схема = СхемаПользователя().Исключить("id");

	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("id")).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Имя")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Отчество")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Возраст")).ЭтоНеНеопределено();
КонецПроцедуры

Процедура ИсключитьНесколькоПолей() Экспорт
	Схема = СхемаПользователя().Исключить(
		ЮТКоллекции.ЗначениеВМассиве("id", "Отчество"));

	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("id")).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Отчество")).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Имя")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Возраст")).ЭтоНеНеопределено();
КонецПроцедуры

Процедура ИсключитьВсеПоля() Экспорт
	Схема = СхемаПользователя().Исключить(
		ЮТКоллекции.ЗначениеВМассиве("id", "Имя", "Отчество", "Возраст"));

	// Схема без полей — пустой объект проходит
	ЮТест.ОжидаетЧто(Схема.Проверить(Новый Структура).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.НайтиСхемуПоля("Имя")).ЭтоНеопределено();
КонецПроцедуры

Процедура ИсключитьНесуществующееПоле() Экспорт
	Выброшено = Ложь;
	Попытка
		СхемаПользователя().Исключить("Несуществующее");
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

// ============ СДЕЛАТЬ НЕОБЯЗАТЕЛЬНЫМИ (partial) ============

Процедура СделатьНеобязательнымиВсе() Экспорт
	Схема = СхемаПользователя().СделатьНеобязательными();
	// Все поля стали необязательными — пустой объект проходит
	ЮТест.ОжидаетЧто(Схема.Проверить(Новый Структура).Успех).ЭтоИстина();
КонецПроцедуры

Процедура СделатьНеобязательнымиУказанные() Экспорт
	Схема = СхемаПользователя().СделатьНеобязательными("Отчество");
	// Отчество теперь необязательное, остальные — обязательные
	ЮТест.ОжидаетЧто(Схема.Проверить(Новый Структура(
		"id, Имя, Возраст", 1, "Alice", 30)).Успех).ЭтоИстина();
	// Без id — ошибка
	ЮТест.ОжидаетЧто(Схема.Проверить(Новый Структура(
		"Имя, Возраст", "Alice", 30)).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура СделатьНеобязательнымиНесуществующее() Экспорт
	Выброшено = Ложь;
	Попытка
		СхемаПользователя().СделатьНеобязательными("Несуществующее");
	Исключение
		Выброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Выброшено).ЭтоИстина();
КонецПроцедуры

Процедура СделатьНеобязательнымиИммутабельность() Экспорт
	Исходная = СхемаПользователя();
	Результат = Исходная.СделатьНеобязательными();
	// Исходная — пустой объект не проходит
	ЮТест.ОжидаетЧто(Исходная.Проверить(Новый Структура).Успех).ЭтоЛожь();
	// Результат — проходит
	ЮТест.ОжидаетЧто(Результат.Проверить(Новый Структура).Успех).ЭтоИстина();
КонецПроцедуры

// ============ СДЕЛАТЬ ОБЯЗАТЕЛЬНЫМИ (required) ============

Процедура СделатьОбязательнымиВсе() Экспорт
	Исходная = Zod.Объект()
		.Поле("a", Zod.Строки().Необязательное())
		.Поле("b", Zod.Числа().Необязательное());
	Результат = Исходная.СделатьОбязательными();
	ЮТест.ОжидаетЧто(Результат.Проверить(Новый Структура).Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Проверить(
		Новый Структура("a, b", "x", 1)).Успех).ЭтоИстина();
КонецПроцедуры

Процедура СделатьОбязательнымиУказанные() Экспорт
	Исходная = Zod.Объект()
		.Поле("a", Zod.Строки().Необязательное())
		.Поле("b", Zod.Числа().Необязательное());
	Результат = Исходная.СделатьОбязательными("a");
	// a теперь обязательное
	ЮТест.ОжидаетЧто(Результат.Проверить(
		Новый Структура("b", 1)).Успех).ЭтоЛожь();
	// b всё ещё необязательное
	ЮТест.ОжидаетЧто(Результат.Проверить(
		Новый Структура("a", "x")).Успех).ЭтоИстина();
КонецПроцедуры

Процедура СделатьОбязательнымиСохраняетДопускаетNull() Экспорт
	Исходная = Zod.Объект().Поле("a",
		Zod.Строки().Необязательное().ДопускаетNull());
	Результат = Исходная.СделатьОбязательными("a");
	// Ключ обязателен, но null допустим
	ЮТест.ОжидаетЧто(Результат.Проверить(Новый Структура).Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Проверить(
		Новый Структура("a", Неопределено)).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Проверить(
		Новый Структура("a", "x")).Успех).ЭтоИстина();
КонецПроцедуры

Процедура СделатьОбязательнымиИммутабельность() Экспорт
	Исходная = Zod.Объект().Поле("a", Zod.Строки().Необязательное());
	Результат = Исходная.СделатьОбязательными();
	// Исходная — пустой объект проходит
	ЮТест.ОжидаетЧто(Исходная.Проверить(Новый Структура).Успех).ЭтоИстина();
	// Результат — не проходит
	ЮТест.ОжидаетЧто(Результат.Проверить(Новый Структура).Успех).ЭтоЛожь();
КонецПроцедуры

// ============ КОМБИНАЦИИ ============

Процедура ВыбратьПотомСделатьНеобязательными() Экспорт
	// Типичный сценарий PATCH: взять подмножество полей и все сделать необязательными
	Схема = СхемаПользователя()
		.Выбрать(ЮТКоллекции.ЗначениеВМассиве("Имя", "Отчество"))
		.СделатьНеобязательными();
	ЮТест.ОжидаетЧто(Схема.Проверить(Новый Структура).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(
		Новый Структура("Имя", "Alice")).Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Схема.Проверить(
		Новый Структура("Отчество", "Ивановна")).Успех).ЭтоИстина();
КонецПроцедуры

Процедура ВалидацияПослеPick() Экспорт
	Схема = СхемаПользователя().Выбрать(
		ЮТКоллекции.ЗначениеВМассиве("Имя", "Возраст"));
	Результат = Схема.Проверить(Новый Структура("Имя, Возраст", "Alice", 30));
	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	// Ограничение Возраст >= 0 осталось работать
	ЮТест.ОжидаетЧто(Схема.Проверить(
		Новый Структура("Имя, Возраст", "Alice", -1)).Успех).ЭтоЛожь();
КонецПроцедуры

Процедура ВалидацияПослеPartial() Экспорт
	Схема = СхемаПользователя().СделатьНеобязательными();
	// Пустой — ок
	ЮТест.ОжидаетЧто(Схема.Проверить(Новый Структура).Успех).ЭтоИстина();
	// Если поле есть — его ограничения продолжают работать
	ЮТест.ОжидаетЧто(Схема.Проверить(
		Новый Структура("Имя", "")).Успех).ЭтоЛожь();
КонецПроцедуры
